<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (integration tests, U12): the app-process BrowserPort's
     contract cases load pages from a loopback server the test starts, over
     plain http. Cleartext stays refused for every other host, and release
     builds keep the platform default (no cleartext). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
