# Uncomment this line to define a global platform for your project
platform :ios, '15.0'
# 15.0 is the minimum supported by Flutter 3.50 (patrol needs 13+)

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Flutter installs dev_dependency plugin pods in every configuration and keeps
# them in the iOS plugin registrant (flutter/flutter#163874), so patrol and its
# CocoaAsyncSocket would ship in release builds. Link them only in Debug; in
# Release and Profile the registrant still compiles against the built frameworks
# but links the plugin weakly, so its class is nil and nothing is embedded.
def dev_plugin_pods(target_definition)
  dependencies = flutter_parse_plugins_file(File.expand_path(File.join('..', '.flutter-plugins-dependencies'), __dir__))
  dev_plugins = flutter_get_plugins_list(dependencies, 'ios').select { |plugin| plugin['dev_dependency'] }.map { |plugin| plugin['name'] }
  dev_plugins & target_definition.dependencies.map(&:name)
end

dev_pods = []
dev_dependency_pods = []

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  dev_pods.replace(dev_plugin_pods(current_target_definition))
  dev_pods.each { |name| current_target_definition.whitelist_pod_for_configuration(name, 'Debug') }
  # CocoaPods includes undeclared (transitive) pods in every configuration, so
  # declare the dev plugins' own pods (patrol's CocoaAsyncSocket) as Debug-only.
  dev_pods.each do |name|
    podspec = Dir[File.join(__dir__, '.symlinks', 'plugins', name, '{ios,darwin}', "#{name}.podspec")].first
    Pod::Specification.from_file(podspec).consumer(:ios).dependencies.map(&:root_name).uniq.each do |dependency|
      next if current_target_definition.dependencies.any? { |declared| declared.root_name == dependency }
      pod dependency, configurations: ['Debug']
      dev_dependency_pods << dependency
    end
  end
end

post_install do |installer|
  # Ensure pods also use the minimum deployment target set above
  # https://stackoverflow.com/a/64385584/436422
  puts 'Determining pod project minimum deployment target'

  pods_project = installer.pods_project
  deployment_target_key = 'IPHONEOS_DEPLOYMENT_TARGET'
  deployment_targets = pods_project.build_configurations.map{ |config| config.build_settings[deployment_target_key] }
  minimum_deployment_target = deployment_targets.min_by{ |version| Gem::Version.new(version) }

  puts 'Minimal deployment target is ' + minimum_deployment_target
  puts 'Setting each pod deployment target to ' + minimum_deployment_target

  installer.aggregate_targets.each do |aggregate_target|
    %w[Release Profile].each do |configuration|
      xcconfig_path = aggregate_target.xcconfig_path(configuration)
      xcconfig = Xcodeproj::Config.new(xcconfig_path)
      (dev_pods + dev_dependency_pods).uniq.each do |name|
        xcconfig.merge!('FRAMEWORK_SEARCH_PATHS' => "\"${PODS_CONFIGURATION_BUILD_DIR}/#{name}\"")
      end
      dev_pods.each { |name| xcconfig.merge!('OTHER_LDFLAGS' => "-weak_framework \"#{name}\"") }
      xcconfig.save_as(Pathname.new(xcconfig_path))
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings[deployment_target_key] = minimum_deployment_target
    end
  end
end
