<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest of the app, including the embedded OpenJDK Zero runtime
  (source_runtime_ios). Runtime entries derived from `nm -u libsourcejvm.a`;
  scripts/ios_package_check.sh re-audits every bundled framework. See docs/validation/source-runners/ios/app-store-compliance.md.
-->
