ription":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2024-12-05T15:08:32+00:00","updatedAt":"2026-06-08T22:16:20+00:00","version":6,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"6fdd7f5a-2bdd-4821-9c5e-ae9b51e1b69e"},"relationships":[{"id":"c31bba2c-97f6-46c1-966f-7eeb31f1f1c8","type":"author"},{"id":"c31bba2c-97f6-46c1-966f-7eeb31f1f1c8","type":"artist"},{"id":"c3646455-bee2-4560-9128-eff92ca2ef17","type":"cover_art","attributes":{"description":"Volume 5 Cover from NamiComi","volume":"5","fileName":"4d32ce93-2d6a-43f5-abb7-4fb189632cd2.png","locale":"en","createdAt":"2026-06-08T22:16:19+00:00","updatedAt":"2026-06-08T22:16:19+00:00","version":1}},{"id":"b3c0e648-21b4-4492-9de1-98ee3d3588c9","type":"creator"}]},{"id":"2f3fbc84-df09-4913-ad2e-436aa52a7177","type":"manga","attributes":{"title":{"ja-ro":"Champignon no Majo"},"altTitles":[{"ja":"\u30b7\u30e3\u30f3\u30d4\u30cb\u30aa\u30f3\u306e\u9b54\u5973"},{"en":"Mushroom Witch"},{"en":"Champignon Witch"},{"fr":"La sorci\u00e8re aux champignons"},{"ko":"\uc0f9\ud53c\ub1fd\uc758 \ub9c8\ub140"},{"zh-hk":"\u6bd2\u83c7\u9b54\u5973"}],"description":{"en":"Luna is a black witch who lives quietly in a poisonous mushroom house, deep in the Black Forest. \nShe works in the city making high-efficiency medicines, but it is rumored that one will die if touched by her, and thus she is avoided\u2026 \nThe life of a isolated witch who doesn't know the warmth of people is carefully and momentarily drawn.","pt-br":"Luna \u00e9 uma bruxa que reside serenamente em uma resid\u00eancia de cogumelos venenosos, localizada nas profundezas da Floresta Sombria. Nesse recanto isolado, ela produz rem\u00e9dios que comercializa na cidade em troca dos livros que tanto ama. Contudo, rumores circulam de que qualquer contato com ela resulta em uma terr\u00edvel morte, levando as pessoas a evit\u00e1-la a todo custo... A vida solit\u00e1ria de uma bruxa privada do calor humano \u00e9 minuciosamente retratada, ao menos por enquanto."},"isLocked":false,"links":{"al":"112573","ap":"champignon-no-majo","bw":"series\/246161\/list","kt":"60852","mu":"i61j43f","mal":"122420","raw":"https:\/\/manga-park.com\/title\/14375"},"officialLinks":null,"originalLanguage":"ja","lastVolume":null,"lastChapter":null,"publicationDemographic":"shoujo","status":"ongoing","year":2019,"contentRating":"safe","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"c8cbe35b-1b2b-4a3f-9c37-db84c4514856","type":"tag","attributes":{"name":{"en":"Medical"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"eabc5b4c-6aff-42f3-b657-3e90cbd00b75","type":"tag","attributes":{"name":{"en":"Supernatural"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-03-11T17:46:57+00:00","updatedAt":"2026-04-03T18:13:01+00:00","version":16,"availableTranslatedLanguages":["en","pt-br","vi"],"latestUploadedChapter":"afd1ea9e-54d5-4e41-bb92-47039e5d2842"},"relationships":[{"id":"35de546a-9fbb-49ee-846d-df3865890a18","type":"author"},{"id":"35de546a-9fbb-49ee-846d-df3865890a18","type":"artist"},{"id":"95f387