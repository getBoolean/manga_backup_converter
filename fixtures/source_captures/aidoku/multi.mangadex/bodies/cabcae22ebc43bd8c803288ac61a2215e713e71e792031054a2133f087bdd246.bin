anguage":"ko","lastVolume":"","lastChapter":"","publicationDemographic":null,"status":"ongoing","year":2025,"contentRating":"safe","tags":[{"id":"3e2b8dae-350e-4ab8-a8ce-016e844b9f0d","type":"tag","attributes":{"name":{"en":"Long Strip"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f5ba408b-0e7a-484d-8d49-4e9125ac96de","type":"tag","attributes":{"name":{"en":"Full Color"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-05-02T18:16:17+00:00","updatedAt":"2026-09-01T16:52:03+00:00","version":5,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"e133da89-acb9-409a-9e77-7ed9f2fb77b1"},"relationships":[{"id":"9901f574-6e08-4bac-aed0-68dc6fd08519","type":"author"},{"id":"9901f574-6e08-4bac-aed0-68dc6fd08519","type":"artist"},{"id":"f5556630-f458-4067-81a2-a22528a5e751","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"1fef7e47-accc-48f5-aa97-9334901b7162.jpg","locale":"ko","createdAt":"2026-05-02T18:16:20+00:00","updatedAt":"2026-05-02T18:16:20+00:00","version":1}},{"id":"f92b6eaa-b644-4805-aa5b-eecf6f6f6219","type":"creator"}]},{"id":"79aea528-7cb7-4fbb-a65c-1271d23b7395","type":"manga","attributes":{"title":{"ja-ro":"Kachou Shima Kousaku"},"altTitles":[{"ja":"\u8ab2\u9577\u5cf6\u8015\u4f5c"},{"en":"Section Chief Shima Kousaku"},{"en":"Shima Kousaku Part 1"}],"description":{"en":"Section Chief Shima K\u014dsaku is the first in a number of Japanese manga series about a fictional salaryman named Shima K\u014dsaku, a Japanese white-collar worker who devotes his life to his company, Hatsushiba Electric.\n\n---- \n- **Won the 15th Kodansha Manga Award for General Manga in 1991, which it shared with the Josei work Akujo**"},"isLocked":false,"links":{"al":"47204