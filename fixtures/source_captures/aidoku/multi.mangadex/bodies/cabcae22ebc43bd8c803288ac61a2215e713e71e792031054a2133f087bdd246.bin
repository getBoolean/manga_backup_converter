,"pt-br","fa","vi","en"],"latestUploadedChapter":"f5f8457b-fcbb-4944-ae96-f596be586845"},"relationships":[{"id":"bc41a014-4dac-467f-99a8-3659e2fe9bf1","type":"author"},{"id":"bc41a014-4dac-467f-99a8-3659e2fe9bf1","type":"artist"},{"id":"b6c41883-0a1a-4c27-95b5-9640f1141130","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"79758b75-40bf-4c7c-81b2-7529f04dd30d.png","locale":"ja","createdAt":"2021-12-25T11:19:04+00:00","updatedAt":"2021-12-25T11:19:04+00:00","version":1}},{"id":"1fb71175-cc34-4b7a-beb3-59546a95fcd6","type":"creator"}]},{"id":"955c730a-9304-4f82-ae96-af48ff5eaa0c","type":"manga","attributes":{"title":{"ja-ro":"Kurai Anoko to Shitai Koto"},"altTitles":[{"ja":"\u304f\u3089\u3044\u3042\u306e\u5b50\u3068\u3057\u305f\u3044\u3053\u3068"},{"en":"What I'd Like to Do with That Gloomy Girl"},{"zh":"\u60f3\u4e0e\u9634\u6697\u7684\u5979\u4e00\u8d77\u505a\u7684\u4e8b"},{"zh-ro":"Xi\u01ceng y\u01d4 y\u012bn'\u00e0n de t\u0101 y\u012bq\u01d0 zu\u00f2 de sh\u00ec"},{"id":"Apa Yang Inginku Lakukan Dengan Gadis Yang Suram Itu?"},{"vi":"C\u00f4 n\u00e0ng u \u00e1m c\u00f9ng l\u1edbp c\u1ee7a t\u00f4i"}],"description":{"en":"Starting his second year of high school, Ren Tabata was determined to get over his loner past and make some new friends. The first person he approached was the girl next to him, Toruko Sasaki, who seemed gloomy and a little intimidating at first, but he couldn't seem to take his eyes off her.","id":"Siswa Kelas 2 SMA, Tabata Ren, bertekad untuk tidak menjadi penyendiri mulai semester baru. Orang pertama yang ia ajak bicara demi mencari teman adalah seorang gadis yang terlihat suram dan sedikit menakutkan\u2026 tapi entah kenapa, matanya tak bisa lepas darinya, Sasaki Touko.  \n\nSebuah komedi tentang usaha lepas dari kesendirian bersama gadis pemalu nan menggemaskan!","ja":"\u65b0\u5b66\u671f\u304b\u3089\u8131\u307c\u3063\u3061\u3092\u76ee\u6307\u3059\u9ad8\u6821\uff12\u5e74\u751f\u30fb\u7530\u7aef\u84ee\u3002\u53cb\u9054\u306e\u70ba\u306b\u6700\u521d\u306b\u58f0\u3092\u304b\u3051\u305f\u306e\u306f\u3001\u306a\u3093\u3060\u304b\u6697\u304f\u3066\u3061\u3087\u3063\u3074\u308a\u6016\u3044\u3002\u3067\u3082\u76ee\u304c\u96e2\u305b\u306a\u3044\u5973\u306e\u5b50\u3001\u4f50\u3005\u6728\u900f\u5b50\u3067\u3002\u3002\u3002\u3002","pt-br":"A garota sombria \u00e9 linda!  Uma romcom escolar sobre uma garota fofa e t\u00edmida e um garoto que quer fazer amigos!"},"isLocked":false,"links":{"al":"141658","ap":"kurai-anoko-to-shitai-koto","bl":"20044716","bw":"series\/353720","kt":"62835","mu":"k7tml2k","amz":"https:\/\/www.amazon.co.jp\/dp\/B0BR4QHY8K","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/698296","mal":"146745","raw":"https:\/\/comic-walker.com\/detail\/KC_003002_S"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2021,"contentRating":"safe","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2021-11-07T06:54:21+00:00","updatedAt":"2026-07-31T07:40:43+00:00","version":36,"availableTranslatedLanguages":["id","en","es-la","pt-br","th"],"latestUploadedChapter":"68164430-8298-4967-88cb-215547b3ba60"},"relationships":[{"id":"6d80c65d-253f-4477-adb6-8ac2162bdce9","type":"author"},{"id":"6d80c65d-253f-4477-adb6-8ac2162bdce9","type":"artist"},{"id":"e5db88fa-eb61-491a-998a-6567dc4bc22f","type":"cover_art","attributes":{"description":"","volume":"8","fileName":"169aaf27-8e6c-4707-80e3-49bc1db9ee68.jpg","locale":"ja","createdAt":"2026-07-03T23:01:04+00:00","updatedAt":"2026-07-03T23:01:04+00:00","version":1}},{"id":"a8cce8e7-d7f3-4f84-b68c-1a4cc5afd93e","type":"creator"}]},{"id":"269939a4-b9c1-4d7c-a2a1-4d7813dac35e","type":"manga","attributes":{"title":{"ja-ro":"Saijaku Kizoku ni Tensei Shita node Akuyaku-tachi wo Atsumetemita"},"altTitles":[{"ja":"\u6700\u5f31\u8cb4\u65cf\u306b\u8ee2\u751f\u3057\u305f\u306e\u3067\u60aa\u5f79\u305f\u3061\u3092\u96c6\u3081\u3066\u307f\u305f"},{"ja-ro":"Saijaku Kizoku ni Tensei Shita node Akuyaku-tachi o Atsumetemita"},{"en":"I was Reincarnated as the Weakest Noble, So I Collected Some Villains."}],"description":{"en":"\"The Weakest Noble, Adele: Turning Villains into Allies for Territory Management!\" Adele, a noble with the weakest standing, faces an unavoidable downfall if he doesn't act fast. Determined to escape ruin, he decides to do the unthinkable: recruit the most powerful villains as his allies! Together with his unlikely companions, Adele embarks on a journey to transform his neglected territory into a prosperous domain. Can this underdog noble rise above his circumstances and rewrite his destiny with the help of his fearsome new friends?","ja":"\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u306b\u8ee2\u751f\u3057\u305f\u4e3b\u4eba\u516c\u306f\u3001\u4f5c\u4e2d\u5c48\u6307\u306e\u5f31\u30ad\u30e3\u30e9\u30fb\u30a2\u30c7\u30eb\u306b\u306a\u3063\u3066\u3044\u305f\uff01\uff01\u5168\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u30c7\u30d0\u30d5\u72b6\u614b\u2026\u2026\u307e\u3055\u3057\u304f\u6700\u5f31\uff01\uff01\u3055\u3089\u306b\u6b7b\u4ea1\u30d5\u30e9\u30b0\u3082\u30d0\u30ea\u7acb\u3061\uff01 \u7834\u6ec5\u5f85\u3063\u305f\u306a\u3057\u3060\u3063\u305f\uff01\uff01\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u306f\u30b2\u30fc\u30e0\u77e5\u8b58\u3092\u983c\u308a\u306b\u3001\u6700\u5f37\u30b9\u30da\u30c3\u30af\u306e\u60aa\u5f79\u30ad\u30e3\u30e9\u305f\u3061\u3092\u53e3\u8aac\u3044\u3066\u4ef2\u9593\u306b\u3059\u308b\u3057\u304b\u306a\u3044\