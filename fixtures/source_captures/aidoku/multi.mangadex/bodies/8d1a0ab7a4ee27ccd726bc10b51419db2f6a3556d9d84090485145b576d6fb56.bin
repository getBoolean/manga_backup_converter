":"https:\/\/jiro-nanahoshi.fanbox.cc\/","booth":null,"namicomi":null,"nicoVideo":null,"skeb":"https:\/\/skeb.jp\/@551_delicious","fantia":"https:\/\/fantia.jp\/fanclubs\/209287","tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2023-03-20T10:58:22+00:00","updatedAt":"2023-06-29T23:22:48+00:00","version":2}},{"id":"f235469a-5b6b-4731-8a7e-093323d06747","type":"artist","attributes":{"name":"Shiose Tamotsu","imageUrl":null,"biography":{"en":"**Name In Native Language:** \u30b7\u30aa\u30bb\u30bf\u30e2\u30c4\n**Other Romanization:** Siose Tamotsu\n\n**Trackers:**\n- [AniList](https:\/\/anilist.co\/staff\/409852\/)\n- [MangaUpdates](https:\/\/www.mangaupdates.com\/author\/xzy0drp\/)\n- [MyAnimeList](https:\/\/myanimelist.net\/people\/98806\/)","ja":"\u30b7\u30aa\u30bb\u30bf\u30e2\u30c4\n\n* [https:\/\/www.mangaupdates.com\/author\/xzy0drp\/](https:\/\/www.mangaupdates.com\/author\/xzy0drp\/)\n* [https:\/\/myanimelist.net\/people\/98806\/](https:\/\/myanimelist.net\/people\/98806\/)\n* [https:\/\/anilist.co\/staff\/409852\/](https:\/\/anilist.co\/staff\/409852\/)"},"twitter":"https:\/\/twitter.com\/sioseta","pixiv":"https:\/\/www.pixiv.net\/users\/87713769","melonBook":null,"fanBox":"https:\/\/sioseta.fanbox.cc\/","booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":"https:\/\/www.youtube.com\/channel\/UC7kgVC39KLzMgrS__CLpTow","weibo":null,"naver":null,"website":"https:\/\/lit.link\/siosetamotsu","createdAt":"2026-10-02T20:05:38+00:00","updatedAt":"2026-10-21T19:51:26+00:00","version":7}},{"id":"b424a968-05e1-4c77-9fd4-4a113f85a8cc","type":"cover_art","attributes":{"description":"Volume 3 cover from BookLive","volume":"3","fileName":"e6567fc2-170e-42cb-96bd-5b774c79ca1a.jpg","locale":"ja","createdAt":"2026-11-04T22:52:57+00:00","updatedAt":"2026-11-04T22:52:57+00:00","version":1}},{"id":"9b6f92b2-e749-4cd1-a259-8df71e12bc14","type":"creator"}]},{"id":"a03552f1-89d3-47df-8292-844ebe5354fe","type":"manga","attributes":{"title":{"ja-ro":"Sekai Saikyou no Honoo Mahoutsukai"},"altTitles":[{"en":"The World's Strongest Fire Mage"},{"ja":"\u4e16\u754c\u6700\u5f37\u306e\u708e\u9b54\u6cd5\u4f7f\u3044"}],"description":{"en":"Before I knew it, I had become Leonhardt, the fat villainous noble from the game I was obsessed with. But a miserable ending exactly like the game is an absolute no go! \n\nEven for my number one favorite, the tragically ill-fated beautiful heroine Celia \u2014 if it's me, I'll love her and protect her to the very end, and I'll definitely see us through to a happy ending together!\n\nThanks to the protection of the Great Fire Spirit Ifrit and my efforts since childhood, both my magic and swordsmanship have powered up! Before long, for some reason, I ended up awakening as an unforeseen \"Strongest Fire User\"!"},"isLocked":false,"links":{"al":"219200","mu":"pn9bq4e","nu":"the-worlds-strongest-fire-wizard-i-was-reincarnated-as-a-fat-mobster-who-lost-everything-after-being-defeated-by-the-hero-many-times-but-i-will-become-invincible-to-save-the-heroine-i-love-so-de","mal":"197645","raw":"https:\/\/firecross.jp\/ebook\/series\/627"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"0bc90acb-ccc1-44ca-a34a-b9f3a73259d0","type":"tag","attributes":{"name":{"en":"Reincarnation"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"ace04997-f6bd-436e-b261-779182193d3d","type":"tag","attributes":{"name":{"en":"Isekai"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e197df38-d0e7-43b5-9b09-2842d0c326dd","type":"tag","attributes":{"name":{"en":"Web Comic"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-10-30T08:42:44+00:00","updatedAt":"2026-11-09T20:33:39+00:00","version":8,"availableTranslatedLanguages":["pt-br","id","en"],"latestUploadedChapter":"1b93ad33-0815-4cad-b786-d7daaae840e2"},"relationships":[{"id":"7c5939ed-3041-4aff-a84a-b85d8f54d28b","type":"author","attributes":{"name":"Kuneru Deburu","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-10-30T08:27:35+00:00","updatedAt":"2026-10-30T08:27:35+00:00","version":1}},{"id":"8fdf056b-dc80-41f3-a2fa-6954e30d05e0","type":"artist","attributes":{"name":"Mukasa","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-10-30T08:21:06+00:00","updatedAt":"2026-10-30T08:21:06+00:00","version":1}},{"id":"91c6b021-8df4-4a1b-bcef-630d17ea06ce","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"d8fe406b-0683-4679-8708-1f8e06ab8540.jpg","locale":"ja","createdAt":"2026-10-30T08:42:48+00:00","updatedAt":"2026-10-30T08:42:48+00:00","version":1}},{"id":"d4a129e5-b9dd-4d10-b629-fe4e21d9da23","type":"creator"}]},{"id":"67e79cef-5367-4977-bbbe-e47925cbc855","type":"manga","attributes":{"title":{"ja-ro":"Femme Fatale no Kyuusai"},"altTitles":[{"ja":"\u30d5\u30a1\u30e0\u30fb\u30d5\u30a1\u30bf\u30fc\u30eb\u306e\u6551\u6e08"},{"en":"Femme fatale's Salvation"}],"description":{"en":"Haruhisa Tajima is a novelist who has been unable to write anything new for some time due to writer's block.\n\nOne day, he meets a college student named Shino Miyama. She casually makes herself at home in Tajima's house and offers to take care of his daily needs.\n\nUnable to figure out her true intentions, Tajima nevertheless accepts her offer, his curiosity as a novelist outweighing his reservations. Shino acts as though she knows exactly who he is, confidently declaring, \"I want to be of use to you, Sensei.\"\n\nWhat lies hidden in the depths of those jet-black eyes of hers...?\n___\n- Alt Official Raw: [niconico manga](https:\/\/manga.nicovideo.jp\/comic\/85951?track=official_trial_l2)","ja":"\u30b9\u30e9\u30f3\u30d7\u3067\u3053\u3053\u3057\u3070\u3089\u304f\u65b0\u4f5c\u304c\u66f8\u3051\u3066\u3044\u306a\u3044\u5c0f\u8aac\u5bb6\u306e\u7530\u5d8b\u6674\u4e45\u3002\n\u3042\u308b\u65e5\u3001\u6df1\u5c71\u5fd7\u4e43\u3068\u540d\u4e57\u308b\u5973\u5b50\u5927\u751f\u3068\u51fa\u4f1a\u3046\u3002\n\u5fd7\u4e43\u306f\u5f53\u7136\u306e\u3088\u3046\u306b\u7530\u5d8b\u306e\u5bb6\u306b\u4e0a\u304c\u308a\u8fbc\u307f\u3001\u8eab\u306e\u56de\u308a\u306e\u4e16\u8a71\u3092\u8cb7\u3063\u3066\u51fa\u308b\u3002\n\u7530\u5d8b\u306f\u3001\u5f7c\u5973\u306e\u771f\u610f\u3092\u6e2c\u308a\u304b\u306d\u306a\u304c\u3089\u3082\u5c0f\u8aac\u5bb6\u3068\u3057\u3066\u306e\u597d\u5947\u5fc3\u304c\u52dd\u308a\u3001\u305d\u308c\u3092\u53d7\u3051\u5165\u308c\u308b\u3002\n\u307e\u308b\u3067\u81ea\u5206\u306e\u7d20\u6027\u3092\u77e5\u3063\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u306a\u7acb\u3061\u5c45\u632f\u308b\u821e\u3044\u3092\u3059\u308b\u5fd7\u4e43\u3001\u300c\u5148\u751f\u306e\u5f79\u306b\u7acb\u3061\u305f\u3044\u300d\u3068\u8a00\u3044\u5207\u308b\u6f06\u9ed2\u306e\u77b3\u306e\u5965\u306b\u7530\u5d8b\u304c\u898b\u305f\u3082\u306e\u306f\u2015\u2015\u3002"},"isLocked":false,"links":{"al":"218734","ap":"femme-fatale-no-kyuusa","mu":"tqkmfmf","mal":"197341","raw":"https:\/\/comic-walker.com\/detail\/KC_020745_S"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2026,"contentRating":"suggestive","tags":[{"id":"07251805-a27e-4d59-b488-f0bfbec15168","type":"tag","attributes":{"name":{"en":"Thriller"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"3b60b75c-a2d7-4860-ab56-05f391bb889c","type":"tag","attributes":{"name":{"en":"Psychological"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"ee968100-4191-4968-93d3-f82d72be7e46","type":"tag","attributes":{"name":{"en":"Mystery"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-10-22T18:23:18+00:00","updatedAt":"2026-11-04T02:42:42+00:00","version":13,"availableTranslatedLanguages":["es-la","id","pt-br","en","vi"],"latestUploadedChapter":"c6f898f3-a173-400a-9a92-9971aa6667b5"},"relationships":[{"id":"9c80ce77-39fd-4c99-90da-042db323d844","type":"author","attributes":{"name":"Harumachi Uro","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-10-22T18:04:38+00:00","updatedAt":"2026-10-22T18:04:38+00:00","version":1}},{"id":"9c80ce77-39fd-4c99-90da-042db323d844","type":"artist","attributes":{"name":"Harumachi Uro","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-10-22T18:04:38+00:00","updatedAt":"2026-10-22T18:04:38+00:00","version":1}},{"id":"63279907-046c-4f01-bdde-cae88cccd799","type":"cover_art","attributes":{"description":"","volume":"0","fileName":"13a34493-06c0-4fc0-8f27-8cd8f9e44fa0.png","locale":"ja","createdAt":"2026-10-22T18:23:20+00:00","updatedAt":"2026-10-22T18:34:11+00:00","version":2}},{"id":"df5d2b1c-f6b6-4f7a-9f98-3678004ed8e8","type":"creator"}]},{"id":"0832d45e-847b-494c-a6ee-2523a5baec5d","type":"manga","attributes":{"title":{"ja-ro":"Futari wa Sekai to Kamiawanai"},"altTitles":[{"ja":"\u4e8c\u4eba\u306f\u4e16\u754c\u3068\u304b\u307f\u5408\u308f\u306a\u3044"},{"en":"The Two Just Don't Fit Into the World"},{"id":"Kita Berdua Tak Cocok dengan Dunia"},{"es-la":"Dos Personas que solo no Encajan en el Mundo"}],"description":{"en":"Yoshiba Mei, a first-year working professional with ASD (Autism Spectrum Disorder). Mei sees the world a little differently from those around her, and has a slight crush on Koeda-san, the cheerful and popular guy at the office. Determined to be useful to him, she throws herself into her work, relying on her natural ability to focus, but somehow keeps making mistakes. Seeing Mei feeling down, Koeda-san decides to share a secret just between the two of them\u2014.\n\nBrilliant manga artist Aome Makito brings a firsthand perspective to this heartwarming love story that will make you laugh and cry, about two people struggling to find their place in the world."},"isLocked":false,"links":{"al":"219755","mu":"avuty8i","mal":"197860","raw":"https:\/\/comic-days.com\/episode\/12207421984407402963"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":null,"status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"92d6d951-ca5e-429c-ac78-451071cbf064","type":"tag","attributes":{"name":{"en":"Office Workers"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-02T06:18:24+00:00","updatedAt":"2026-11-10T13:48:47+00:00","version":11,"availableTranslatedLanguages":["es-la","pt-br","en","id"],"latestUploadedChapter":"7660543c-3bf0-44ac-81c6-8c53d7c04f7b"},"relationships":[{"id":"40dfa10d-2513-4efb-9519-a1d6963cd827","type":"author","attributes":{"name":"Aome Makito","imageUrl":null,"biography":{"en":"**Name In Native Language:** \u9752\u76ee\u69d9\u6597"},"twitter":"https:\/\/twitter.com\/aome_makito","pixiv":"https:\/\/www.pixiv.net\/users\/44149061","melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2021-12-18T05:56:44+00:00","updatedAt":"2026-11-13T07:32:59+00:00","version":4}},{"id":"40dfa10d-2513-4efb-9519-a1d6963cd827","type":"artist","attributes":{"name":"Aome Makito","imageUrl":null,"biography":{"en":"**Name In Native Language:** \u9752\u76ee\u69d9\u6597"},"twitter":"https:\/\/twitter.com\/aome_makito","pixiv":"https:\/\/www.pixiv.net\/users\/44149061","melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2021-12-18T05:56:44+00:00","updatedAt":"2026-11-13T07:32:59+00:00","version":4}},{"id":"0398cfa4-be8e-444e-a054-7bbd55e75b83","type":"cover_art","attributes":{"description":"","volume":"0.3","fileName":"18e6e15b-81bc-4304-b2d8-bd9866bf35aa.jpg","locale":"ja","createdAt":"2026-11-09T02:20:33+00:00","updatedAt":"2026-11-09T08:03:24+00:00","version":2}},{"id":"fb03ae91-2304-4a1f-b9e2-6b5ba3313138","type":"creator"}]},{"id":"0813ea1e-5a6c-4148-be7e-25038a0fa90f","type":"manga","attributes":{"title":{"ja-ro":"Ren'AI Flag: AI ga Risou no Koibito o Erandekureru Matching Apuri o Tsukattara Isekai no Yuusha to Matching Shita"},"altTitles":[{"ja":"\u604b\uff21\uff29\u30d5\u30e9\u30b0\u3000\uff5e\uff21\uff29\u304c\u7406\u60f3\u306e\u604b\u4eba\u3092\u9078\u3093\u3067\u304f\u308c\u308b\u30de\u30c3\u30c1\u30f3\u30b0\u30a2\u30d7\u30ea\u3092\u4f7f\u3063\u305f\u3089\u7570\u4e16\u754c\u306e\u52c7\u8005\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3057\u305f\uff5e"},{"en":"Ren AI Flag: When I Used a Matching App Where AI Chooses Your Ideal Lover, I Matched with a Hero from Another World"},{"ja-ro":"Ren AI Flag: AI ga Risou no Koibito o Erandekureru Matching App o Tsukattara Isekai no Yuusha to Matching Shita"},{"ja-ro":"Ren AI Flag: AI ga Risou no Koibito wo Erandekureru Matching App wo Tsukattara Isekai no Yuusha to Matching Shita"},{"ja-ro":"Ren AI Flag: AI ga Risou no Koibito wo Erandekureru Matching Apuri wo Tsukattara Isekai no Yuusha to Matching Shita"},{"vi":"C\u1edd t\u00ecnh y\u00eau AI:  Khi T\u00f4i D\u00f9ng \u1ee8ng D\u1ee5ng H\u1eb9n H\u00f2 AI \u0110\u1ec3 T\u00ecm Ng\u01b0\u1eddi Y\u00eau L\u00fd T\u01b0\u1edfng, T\u00f4i L\u1ea1i Gh\u00e9p \u0110\u00f4i V\u1edbi M\u1ed9t D\u0169ng Gi\u1ea3 \u0110\u1ebfn T\u1eeb D\u1ecb Gi\u1edbi"},{"vi":"AI ti\u0300m ng\u01b0\u01a1\u0300i y\u00eau ly\u0301 t\u01b0\u01a1\u0309ng cho t\u00f4i"}],"description":{"en":"Midou Ryouta, thrilled at the campus life he had longed for, was lamenting that he still couldn\u2019t get a girlfriend at all. When he started using the matching app \u201cRen AI Flag\u201d that a friend recommended, clinging to it as a last hope, he scored a huge match with Lilia, a beautiful blonde girl! But she was a hero who had come from another world! He was supposed to win her over, but he\u2019s pressured into a relationship with marriage in mind\u2014and on top of that, they end up living together!? The curtain rises on a slightly unusual youth romantic comedy about a male university student who longs for an ordinary romance!","ja":"\u61a7\u308c\u306e\u30ad\u30e3\u30f3\u30d1\u30b9\u30e9\u30a4\u30d5\u306b\u80f8\u8e8d\u3089\u305b\u3066\u3044\u305f\u5fa1\u5802\u826f\u592a\u306f\u3001\u4e00\u5411\u306b\u5f7c\u5973\u304c\u4f5c\u308c\u305a\u5606\u3044\u3066\u3044\u305f\u3002\n\u53cb\u4eba\u306b\u52e7\u3081\u3089\u308c\u305f\u30de\u30c3\u30c1\u30f3\u30b0\u30a2\u30d7\u30ea\u300e\u604bAI\u30d5\u30e9\u30b0\u300f\u3092\u3059\u304c\u308b\u601d\u3044\u3067\u59cb\u3081\u308b\u3068\u3001\u91d1\u9aea\u7f8e\u5c11\u5973\u30ea\u30ea\u30a2\u3068\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u306b\u5927\u6210\u529f\uff01\n\u3057\u304b\u3057\u5f7c\u5973\u306f\u7570\u4e16\u754c\u304b\u3089\u6765\u305f\u52c7\u8005\u3060\u3063\u305f\uff01\n\n\u5f7c\u5973\u3092\u30b2\u30c3\u30c8\u3059\u308b\u306f\u305a\u304c\u3001\u7d50\u5a5a\u524d\u63d0\u306e\u304a\u4ed8\u304d\u5408\u3044\u3092\u8feb\u3089\u308c\u3001\u3057\u304b\u3082\u540c\u68f2\u3059\u308b\u3053\u3068\u306b!?\n\u666e\u901a\u306e\u604b\u306b\u61a7\u308c\u308b\u7537\u5b50\u5927\u5b66\u751f\u306e\u3061\u3087\u3063\u3068\u5909\u308f\u3063\u305f\u9752\u6625\u30e9\u30d6\u30b3\u30e1\u958b\u5e55\uff01"},"isLocked":false,"links":{"al":"219257","mu":"bq9fq41","mal":"197369","raw":"https:\/\/www.123hon.com\/nova\/web-comic\/renai_flag\/"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2026,"contentRating":"suggestive","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"ace04997-f6bd-436e-b261-779182193d3d","type":"tag","attributes":{"name":{"en":"Isekai"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-10-24T12:16:20+00:00","updatedAt":"2026-11-06T10:27:04+00:00","version":10,"availableTranslatedLanguages":["es-la","vi","id","en"],"latestUploadedChapter":"b6a229a8-29f4-4a2b-8e28-b886060b649b"},"relationships":[{"id":"9c07a8ad-79e6-42fa-b166-70ca0a997815","type":"author","attributes":{"name":"Manashiro Kanata (\u30de\u30ca\u30b7\u30ed\u30ab\u30ca\u30bf)","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-10-23T02:02:38+00:00","updatedAt":"2026-10-23T02:02:38+00:00","version":1}},{"id":"62a1527a-e530-490f-8abf-764ba29658ba","type":"artist","attributes":{"name":"Azumi Yuzu (\u5b89\u4f4f\u3086\u305a)","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-10-23T02:03:00+00:00","updatedAt":"2026-10-23T02:03:00+00:00","version":1}},{"id":"af28aa3f-cd4a-4be1-bd6c-f1deef0c1128","type":"cover_art","attributes":{"description":"","volume":"0.1","fileName":"c467d445-3345-4864-9a8a-1800a91ad071.png","locale":"ja","createdAt":"2026-10-24T12:16:43+00:00","updatedAt":"2026-10-24T12:16:43+00:00","version":1}},{"id":"fc6e9df7-5c5f-43de-b1d2-949bd953fbd2","type":"creator"}]},{"id":"7da86238-28b9-43b1-b727-e31c80960447","type":"manga","attributes":{"title":{"ja-ro":"Tanoshii Ongaku"},"altTitles":[{"en":"Fun with Music"},{"ja":"\u305f\u306e\u3057\u3044\u97f3\u697d"},{"pt-br":"Uma M\u00fasica Agrad\u00e1vel"},{"es-la":"Disfruta De La Musica"}],"description":{"en":"High school freshman Chatora Uozumi somehow finds himself playing drums in a band! But there's a catch:  the other band members are charming girls...!\nHe's in the thick of adolescence, and it's not like he isn't interested in naughty things (if anything, he's a little too interested!). Can Chatora enjoy making music with this band without letting his hormones get the better of him?!","es-la":"\u00a1Chatora Uozumi, un estudiante de primer a\u00f1o de preparatoria, termina tocando la bater\u00eda en una banda por pura casualidad\u2026! \u00a1Pero resulta que todos los miembros de la banda son mujeres encantadoras\u2026! Chatora est\u00e1 en plena adolescencia y no es precisamente ajeno a los temas subidos de tono (\u00a1de hecho, m\u00e1s bien todo lo contrario\u2026!). \u00bfSer\u00e1 capaz de disfrutar de la m\u00fasica y pasarlo bien con esta banda\u2026?.","pt-br":"Chatora Uozumi, um estudante do primeiro ano do ensino m\u00e9dio, acaba, de alguma forma, tocando bateria em uma banda! Mas h\u00e1 um pequeno detalhe: os outros integrantes da banda s\u00e3o garotas encantadoras...!\n\nEle est\u00e1 no auge da adolesc\u00eancia e n\u00e3o \u00e9 como se n\u00e3o tivesse interesse em certas coisas mais picantes (na verdade, talvez at\u00e9 tenha interesse demais!). Ser\u00e1 que Chatora conseguir\u00e1 aproveitar a experi\u00eancia de fazer m\u00fasica com essa banda sem deixar que seus horm\u00f4nios falem mais alto?!"},"isLocked":false,"links":{"al":"215185","mal":"197588","raw":"https:\/\/www.sunday-webry.com\/episode\/12207421984436021742"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2026,"contentRating":"suggestive","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"aafb99c1-7f60-43fa-b75f-fc9502ce29c7","type":"tag","attributes":{"name":{"en":"Harem"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f42fbf9e-188a-447b-9fdc-f19dc1e4d685","type":"tag","attributes":{"name":{"en":"Music"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-10-28T19:11:25+00:00","updatedAt":"2026-11-08T05:00:43+00:00","version":9,"availableTranslatedLanguages":["en","id","es-la"],"latestUploadedChapter":"24eb9867-d667-427b-a228-bf25a74cd9b8"},"relationships":[{"id":"03101fae-1799-4433-b4a8-16c8b1c3088c","type":"author","attributes":{"name":"Io Naomichi","imageUrl":null,"biography":{},"twitter":"https:\/\/twitter.com\/IoNaomichi","pixiv":"https:\/\/www.pixiv.net\/en\/users\/2293982","melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2021-04-19T21:59:45+00:00","updatedAt":"2023-06-07T20:29:24+00:00","version":2}},{"id":"03101fae-1799-4433-b4a8-16c8b1c3088c","type":"artist","attributes":{"name":"Io Naomichi","imageUrl":null,"biography":{},"twitter":"https:\/\/twitter.com\/IoNaomichi","pixiv":"https:\/\/www.pixiv.net\/en\/users\/2293982","melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2021-04-19T21:59:45+00:00","updatedAt":"2023-06-07T20:29:24+00:00","version":2}},{"id":"3ad221dd-889c-4819-9149-b0a5eec60a22","type":"cover_art","attributes":{"description":"","volume":"0","fileName":"347366f3-d3d9-414b-a675-c0da73494a93.jpg","locale":"ja","createdAt":"2026-10-28T19:11:26+00:00","updatedAt":"2026-10-28T19:11:26+00:00","version":1}},{"id":"e9df14ed-e7f5-4e85-b28f-7c1eb7ea130c","type":"creator"}]},{"id":"327fd7d1-47d6-4df4-979d-20bfb8899cf2","type":"manga","attributes":{"title":{"ja-ro":"Teisou Gyakuten Sekai no Onsen de, Sansuke Yaru koto ni narimashita"},"altTitles":[{"ja":"\u8c9e\u64cd\u9006\u8ee2\u4e16\u754c\u306e\u6e29\u6cc9\u3067\u3001\u4e09\u52a9\u3084\u308b\u3053\u3068\u306b\u6210\u308a\u307e\u3057\u305f"},{"en":"I\u2019ve Ended up Working as a Male Bath Attendant at a Hot Spring in a Chastity-Reversed World"},{"en":"I\u2019m Now Working as a Male Bath Attendant at a Hot Spring in a Chastity-Reversed World"}],"description":{"en":"A young man who has lost his memories finds himself in a world where the gender ratio is 1 man to 100 women\u2014a world where traditional gender roles are reversed.\n\nThere, he's taken in by Misago, the daughter of a hot spring inn. She gives him the name Hisui, and he begins living at the inn.\n\nOf course, he can't keep living there without contributing anything forever. So the job he's given is... to work as a sansuke, a male bath attendant responsible for washing female guests' backs.\n\nHisui quickly adapts to this gender-reversed world and settles into a happy life at the hot spring inn. Meanwhile, the girls who find themselves constantly caught up in his antics gradually begin falling for him.\n\nThis is a heartwarming harem ensemble story about Hisui and the girls, set in a rather unusual hot spring inn."},"isLocked":false,"links":{"al":"219238","nu":"in-a-world-where-chastity-is-reversed-i-ended-up-working-as-a-hot-spring-attendant","raw":"https:\/\/kimicomi.com\/series\/7254d0f6a53a1\/new"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2026,"contentRating":"suggestive","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"aafb99c1-7f60-43fa-b75f-fc9502ce29c7","type":"tag","attributes":{"name":{"en":"Harem"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"ace04997-f6bd-436e-b261-779182193d3d","type":"tag","attributes":{"name":{"en":"Isekai"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-10-30T13:38:13+00:00","updatedAt":"2026-11-10T18:59:01+00:00","version":7,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"422835e8-4383-4af6-9338-89cdea569061"},"relationships":[{"id":"5b69d7cc-879a-4161-b3bc-8bd205eed2ff","type":"author","attributes":{"name":"Minematsu Medaka","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-10-30T13:33:44+00:00","updatedAt":"2026-10-30T13:33:44+00:00","version":1}},{"id":"0ba282b3-2228-4bed-a2c5-c615edec63cd","type":"artist","attributes":{"name":"Otemoto","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2025-01-31T20:05:11+00:00","updatedAt":"2025-01-31T20:05:11+00:00","version":1}},{"id":"335a3d84-3b20-44c4-8014-6d6fa64a045d","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"72e5edde-3a4f-4aec-8e66-933ba80446d3.jpg","locale":"ja","createdAt":"2026-10-30T13:38:14+00:00","updatedAt":"2026-10-30T13:38:14+00:00","version":1}},{"id":"83ff5ea1-47fc-4eda-8be7-440a798a98ac","type":"creator"}]},{"id":"79aba376-0181-4969-936a-aad19f29da88","type":"manga","attributes":{"title":{"ja-ro":"Suterareta Moto Kishidanchou no Ossan, Henkyou de Shinguru Maza"},"altTitles":[{"ja":"\u6368\u3066\u3089\u308c\u305f\u5143\u9a0e\u58eb\u56e3\u9577\u306e\u304a\u3063\u3055\u3093\u3001\u8fba\u5883\u3067\u30b7\u30f3\u30b0\u30eb\u30de\u30b6"},{"en":"The Discarded Former Knight Commander Is Taken in by a Single Mother"}],"description":{"en":"\u300cYou are hereby sentenced to permanent exile in Dawnbarth, a remote frontier where humans and monsters are locked in a constant struggle for survival!\u300d\n\nOne day, Gale Coltrane, the Commander of the Royal Knights, is suddenly stripped of his position after being falsely accused of a crime he never committed. Having lost both his status and reputation, Gale watches as everyone he once knew turns their back on him the moment they learn of his downfall.\n\nAlthough the king's mercy spares his life, Gale is banished to the farthest reaches of the kingdom, a remote frontier where humans and monsters fight day after day for the right to survive. Unable to trust anyone anymore, Gale falls into despair and begins living recklessly. Whether it's venturing into the Demon Forest with barely any equipment or drowning himself in alcohol, his actions are practically self-destructive.\n\nThen, one day, Gale collapses by the roadside, where he is found by Alisha, a single mother raising her twins all on her own. Taking pity on him, she decides to take him in\u2015\u2015."},"isLocked":false,"links":{"al":"220037","mu":"85udgj0","raw":"https:\/\/booklive.jp\/product\/index\/title_id\/10019333\/vol_no\/001"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e197df38-d0e7-43b5-9b09-2842d0c326dd","type":"tag","attributes":{"name":{"en":"Web Comic"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-18T06:35:06+00:00","updatedAt":"2026-11-19T18:08:47+00:00","version":5,"availableTranslatedLanguages":["id","en"],"latestUploadedChapter":"3682e245-d8e6-4054-9e2c-ca08f8063d0c"},"relationships":[{"id":"41151e48-4902-4e94-b409-f45e57db9459","type":"author","attributes":{"name":"Aomoto Haru","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-06-06T04:26:44+00:00","updatedAt":"2026-06-06T04:26:44+00:00","version":1}},{"id":"8c9b2889-df76-4f2c-960b-262e1a3134b2","type":"artist","attributes":{"name":"Shimizu Yui","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-11-18T06:27:55+00:00","updatedAt":"2026-11-18T06:27:55+00:00","version":1}},{"id":"ca27e228-f6d6-4f15-ad9e-0425af7bd1d4","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"7a7e10e0-8ba9-47a1-9ef3-bb706839b5da.jpg","locale":"ja","createdAt":"2026-11-18T06:35:08+00:00","updatedAt":"2026-11-18T06:35:08+00:00","version":1}},{"id":"55d8e9da-b906-4078-b1f3-d58b3624da70","type":"creator"}]},{"id":"6304233e-98d3-4ba5-8c1b-9c328a82a178","type":"manga","attributes":{"title":{"ja-ro":"Omae ni Seijo wa Muite nai!"},"altTitles":[{"ja":"\u304a\u524d\u306b\u8056\u5973\u306f\u5411\u3044\u3066\u306a\u3044\uff01"},{"en":"You\u2019re Not Cut Out to Be a Saint!"}],"description":{"en":"**\"I won\u2019t let you say you forgot about me. You shrimpy four-eyes!\"**\n\nThe idolized Saint is actually... his body-swapped childhood friend?!\n\nWill is an earnest rookie cleric who has returned to his hometown after 10 long years. He has finally achieved his lifelong dream of becoming the Saint's personal attendant! ...Or so he thinks, until he discovers that the person inside that holy vessel is actually his childhood friend and former local bully, Elle!\n\nWill is thrown into total chaos as his tomboyish friend runs wild in the body of a gorgeous saint. To uncover the mystery behind the body swap, the two are forced to stick together. But between Elle's completely defenseless flaunting of her new assets and shared bath times, poor virgin Will's self-control is constantly pushed to the absolute limit!\n\nWhat Will doesn't know, however, is that Elle secretly carries a massive crush on him, and she's determined to use this opportunity to **tear the moral fabric**!\n\nHe can't stop his heart from pounding for the tomboy of his past. They're completely in love, yet completely missing the mark! The slapstick rom-com between a tsundere \"Saint\" and a straight-laced cleric has officially begun!","ja":"\u300c\u3042\u305f\u3057\u3092\u5fd8\u308c\u305f\u308f\u3051\u3058\u3083\u306d\u30fc\u3060\u308d\u3046\u306a\u3001\u3056\u3053\u30e1\u30ac\u30cd\u3063\u300d\u61a7\u308c\u306e\u8056\u5973\u69d8\u306f\u2026\u5165\u308c\u66ff\u308f\u3063\u305f\u5e7c\u306a\u3058\u307f\uff01\uff1f10\u5e74\u3076\u308a\u306b\u6545\u90f7\u306b\u5e30\u3063\u3066\u304d\u305f\u771f\u9762\u76ee\u306a\u65b0\u7c73\u795e\u7236\u306e\u30a6\u30a3\u30eb\u3002\u3064\u3044\u306b\u8056\u5973\u69d8\u306e\u5f93\u8005\u306b\u306a\u308c\u305f\uff01\u2026\u3068\u601d\u3063\u305f\u3089\u3001\u306a\u3093\u3068\u4e2d\u8eab\u306f\u5e7c\u306a\u3058\u307f\u306e\u30ac\u30ad\u5927\u5c06\u30fb\u30a8\u30eb\u3002\u7f8e\u5c11\u5973\u306e\u59ff\u3067\u66b4\u308c\u3066\u304f\u308b\u30a2\u30a4\u30c4\u306b\u5927\u6df7\u4e71\uff01\u4e2d\u8eab\u304c\u5165\u308c\u66ff\u308f\u3063\u305f\u7406\u7531\u3092\u63a2\u3059\u305f\u3081\u3001\u3075\u305f\u308a\u306f\u4e00\u