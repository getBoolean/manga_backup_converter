or"},{"id":"7f91d879-cd2a-40b1-9068-8ebd921e3c1d","type":"artist"},{"id":"fea7faa1-af15-4449-9a52-f07e1bb7bfca","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"93607697-bc75-4a02-9025-f31ed6404701.jpg","locale":"ja","createdAt":"2026-09-14T11:07:23+00:00","updatedAt":"2026-09-14T11:07:23+00:00","version":1}},{"id":"cf326533-07d1-4596-ac9e-e8ec899277b7","type":"creator"}]},{"id":"51071f70-a359-44ff-a9bb-c754bbef9231","type":"manga","attributes":{"title":{"ja-ro":"Tensei Shita Daiseijo wa, Seijo de Aru Koto wo Hitakakusu ZERO ~The Great Saint of Remembrance~"},"altTitles":[{"ja":"\u8ee2\u751f\u3057\u305f\u5927\u8056\u5973\u306f\u3001\u8056\u5973\u3067\u3042\u308b\u3053\u3068\u3092\u3072\u305f\u96a0\u3059ZERO\uff5eThe Great Saint of Remembrance\uff5e"},{"ja-ro":"Tensei Shita Daiseijo wa, Seijo de Aru Koto o Hitakakusu ZERO ~The Great Saint of Remembrance~"},{"en":"The Reincarnated Great Saintess Hides Her True Identity with All Her Might"},{"en":"A Tale of the Secret Saint ZERO"}],"description":{"en":"In the Kingdom of Nirv, the second princess was born with an apparent flaw\u2014she had been blind since birth. Due to political conflicts, she was sent away from the capital to live in the Rint Forest, where everyone assumed she was just a fragile child, oblivious to the world around her. But the truth was far beyond what anyone imagined... She possessed extraordinary power that defied all expectations!\n\nWhen the king finally decided to bring her back, he sent the Vice Captain of the Holy Beast Knights, one of the strongest warriors in the kingdom, to escort her to the palace. However, upon meeting her, he immediately realized that this child was anything but ordinary\u2014she radiated an immeasurable force, a power that could change the fate of the entire kingdom. How will this journey back unfold? Will the young Saintess remain hidden in the shadows, or will her strength one day be revealed?","ja":"\u6700\u5f37\u306e\u9a0e\u58eb\u304c\u51fa\u4f1a\u3063\u305f\u306e\u306f\u3001\u898f\u683c\u5916\u306e\u529b\u3092\u6301\u3064\u5e7c\u304d\u8056\u5973\u3060\u3063\u305f\u2500\u2500\u3002\u30ca\u30fc\u30f4\u738b\u56fd\u306b\u306f\u3001\u76ee\u306e\u898b\u3048\u306a\u30446\u6b73\u306e\u7b2c\u4e8c\u738b\u5973\u304c\u3044\u305f\u3002\u653f\u4e89\u306b\u5dfb\u304d\u8fbc\u307e\u308c\u308b\u3053\u3068\u3092\u6182\u3044\u3066\u738b\u90fd\u304b\u3089\u96e2\u308c\u305f\u300c\u30ec\u30f3\u30c8\u306e\u68ee\u300d\u3067\u66ae\u3089\u3057\u3066\u3044\u308b\u304c\u3001\u56fd\u738b\u306f\u300c\u9023\u308c\u623b\u3057\u3066\u307b\u3057\u3044\u300d\u3068\u89d2\u7363\u9a0e\u58eb\u56e3\u526f\u7dcf\u9577\u306e\u30b7\u30ea\u30a6\u30b9\u3092\u6d3e\u9063\u3057\u2026\u3002"},"isLocked":false,"links":{"al":"171134","ap":"a-tale-of-the-secret-saint-zero-the-great-saint-of-remembrance","bl":"1536983","bw":"series\/461228","kt":"70873","mu":"yxcxsvq","amz":"https:\/\/www.amazon.co.jp\/dp\/B0CZ3VZT9Z","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/817295","mal":"170048","raw":"https:\/\/comic-earthstar.com\/episode\/14079602755509017351"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2024,"contentRating":"safe","tags":[{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2024-09-20T17:21