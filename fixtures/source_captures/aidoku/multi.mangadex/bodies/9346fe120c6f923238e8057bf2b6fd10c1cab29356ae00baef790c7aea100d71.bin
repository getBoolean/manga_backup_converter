:"\u0e0b\u0e27\u0e22\u0e40\u0e2b\u0e25\u0e37\u0e2d\u0e2b\u0e25\u0e32\u0e22\u0e40\u0e01\u0e34\u0e14\u0e43\u0e2b\u0e21\u0e48\u0e01\u0e25\u0e32\u0e22\u0e40\u0e1b\u0e47\u0e19\u0e14\u0e32\u0e1a"},{"ja":"\u8ee2\u751f\u3057\u305f\u3089\u5263\u3067\u3057\u305f"},{"ko":"\uc804\uc0dd\ud588\ub354\ub2c8 \uac80\uc774\uc5c8\uc2b5\ub2c8\ub2e4"},{"vi":"Chuy\u1ec3n Sinh Th\u00e0nh Ki\u1ebfm"}],"description":{"en":"When he realized it, the protagonist was in another world and had become a sword that was stabbed on an altar in a great plain, crowded with devil beast. The world he was in had a game like system; HP, MP, Strength, Vitality, Agility, Intelligence, Dexterity, Titles and Equipment. Following his instinct as a living sword, he traveled to find the one who could be his wielder, until he met with a cat girl that was about to be attacked by a bear type devil beast.","es-la":"Cuando se dio cuenta, el protagonista ya se encontraba en otro mundo. Se hab\u00eda convertido en una espada que se hab\u00eda clavado en una gran llanura, custodiada por bestias demoniacas. Hasta que su portador la encuentre. Y es en ese momento, cuando una gata negra apareci\u00f3."},"isLocked":true,"links":{"al":"98014","ap":"reincarnated-as-a-sword","bw":"series\/112059\/list","kt":"39113","mu":"nu8x6rp","nu":"i-was-a-sword-when-i-reincarnated-ln","amz":"https:\/\/www.amazon.co.jp\/dp\/B078ML3KX2","cdj":"https:\/\/www.cdjapan.co.jp\/product\/NEOBK-3078465","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/405310","mal":"103144","raw":"https:\/\/comic-boost.com\/content\/00290001","engtl":"https:\/\/sevenseasentertainment.com\/series\/reincarnated-as-a-sword-manga"},"officialLinks":null,"originalLanguage":"ja","lastVolume":null,"lastChapter":null,"publicationDemographic":null,"status":"ongoing","year":2016,"contentRating":"suggestive","tags":[{"id":"0bc90acb-ccc1-44ca-a34a-b9f3a73259d0","type":"tag","attributes":{"name":{"en":"Reincarnation"},"description":{},"group":"theme","version":1},"relationships":[]