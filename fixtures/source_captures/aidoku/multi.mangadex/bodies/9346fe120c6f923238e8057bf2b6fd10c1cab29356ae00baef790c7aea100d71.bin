,"es-la"],"latestUploadedChapter":"45feda08-bf3d-42f5-a188-4feea3e315dc"},"relationships":[{"id":"f515ea17-6c6c-4351-9e17-6cdf93f985a0","type":"author"},{"id":"0c6b6210-4c91-4fb9-a79a-3ca007ce5b8c","type":"artist"},{"id":"8fea1a34-04c0-412d-82a2-5c047ae2ccda","type":"cover_art","attributes":{"description":"","volume":"16","fileName":"690f3077-69c3-4a72-9f6b-700fe6488bff.jpg","locale":"ja","createdAt":"2026-10-19T12:22:52+00:00","updatedAt":"2026-10-19T12:22:52+00:00","version":1}}]},{"id":"baa96f52-19a3-4fe1-8000-1019a083c088","type":"manga","attributes":{"title":{"en":"The First Order"},"altTitles":[{"zh-ro":"Di Yi Xu Lie"},{"zh":"\u7b2c\u4e00\u5e8f\u5217"},{"zh-ro":"Di yi Xulie"},{"vi":"\u0110\u1ec7 Nh\u1ea5t Danh S\u00e1ch"},{"ko":"\ud3d0\uae09\uc5d0\uc11c \uc131\uc8fc\uae4c\uc9c0 \ub808\ubca8\uc5c5"},{"en":"The First Sequence"},{"ja":"\u6700\u9ad8\u5e8f\u5217\u306e\u6b66\u5668\u3092\u99c6\u4f7f\u3059\u308b\u30cf\u30f3\u30bf\u30fc"}],"description":{"en":"The world has ended and advanced technology is a relic of the past. In spite of his illness, Xiaosu hunts everyday, fighting to support himself and his brother Liuyan. But one day, Xiaosu is granted access to a palace. It presents quests that, when completed, grant Xiaosu greater strength and skills. As he grows stronger and sees more of his wasteland world, Xiaosu wonders: can the powerful and the powerless ever be equals?"},"isLocked":false,"links":{"al":"140154","ap":"the-first-order","kt":"62454","mu":"fea7f3b","raw":"https:\/\/ac.qq.com\/Comic\/comicInfo\/id\/650662","engtl":"https:\/\/tapas.io\/series\/the-first-order\/info"},"officialLinks":null,"originalLanguage":"zh","lastVolume":"","lastChapter":"608","publicationDemographic":"shounen","status":"completed","year":2021,"contentRating":"suggestive","tags":[{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"3b60b75c-a2d7-4860-ab56-05f391bb889c","type":"tag","attributes":{"name":{"en":"Psychological"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"3e2b8dae-350e-4ab8-a8ce-016e844b9f0d","type":"tag","attributes":{"name":{"en":"Long Strip"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdad7e68-1419-41dd-bdce-27753074a640","type":"tag","attributes":{"name":{"en":"Horror"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"eabc5b4c-6aff-42f3-b657-3e90cbd00b75","type":"tag","attributes":{"name":{"en":"Supernatural"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2021-10-13T17:36:05+00:00","updatedAt":"2025-12-02T18:22:22+00:00","version":20,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"0599e518-024c-4a98-8d99-960336c8a8ce"},"relationships":[{"id":"530117d1-7d54-425d-ab24-691e0f0a85e1","type":"author"},{"id":"da3fbbbe-74e9-403f-972f-864e133ec4d9","type":"artist"},{"id":"4012cab0-1463-4fad-887e-f829c0d06ca9","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"0d067157-9504-4381-a08e-7acb65717e39.jpg","locale":"zh","createdAt":"2021-10-13T17:41:38+00:00","updatedAt":"2021-10-13T17:41:38+00:00","version":1}},{"id":"46663ee4-068c-41d8-a7b5-e4c6e5310c0d","type":"manga","related":"same_franchise"},{"id":"9f082a4c-2a50-4859-ae0d-30a0bcf1cf9e","type":"manga","related":"sequel"},{"id":"201324f7-c7a5-4ca7-83bb-41b28a1fd913","type":"creator"}]},{"id":"71ad0a8c-1a51-4f51-9a0a-5d20c1fa3ec5","type":"manga","attributes":{"title":{"ja-ro":"Kanata Kara"},"altTitles":[{"id":"Dunia Mimpi"},{"en":"From Far Away"},{"en":"From the Other Side"},{"vi":"V\u00f9ng \u0110\u1ea5t Xa X\u0103m"},{"zh":"\u4f86\u81ea\u9060\u65b9"},{"ja":"\u5f7c\u65b9\u304b\u3089"},{"zh-hk":"\u7570\u5883\u5947\u7de3"}],"description":{"en":"Walking home from school one day, Noriko is innocently caught up in a terrorist bombing. Rather than being blown to bits, she finds herself transported to another world; a world in which darkness seems on the rise, as its powers desperately search for a being known as the Awakening whom it is said will awaken the Sky Demon. She finds this new world to be dangerous and overwhelming, and Noriko has little choice but to throw her lot in with the mysteriously powerful man she encounters upon her arrival. The enigma of this world and her role in it will gradually unfold, but first things first: Noriko must learn their language!  \n  \nIn 2004, this manga won the 35th annual Seiun Award for best science fiction comic."},"isLocked":false,"links":{"al":"30923","ap":"from-far-away","kt":"2012","mu":"az5r0us","mal":"923","engtl":"https:\/\/www.viz.com\/from-far-away"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"14","lastChapter":"57","publicationDemographic":"shoujo","status":"completed","year":1991,"contentRating":"safe","tags":[{"id":"0a39b5a1-b235-4886-a747-1d05d216532d","type":"tag","attributes":{"name":{"en":"Award Winning"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"