ame":{"en":"Psychological"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"5fff9cde-849c-4d78-aab0-0d52b2ee1d25","type":"tag","attributes":{"name":{"en":"Survival"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"92d6d951-ca5e-429c-ac78-451071cbf064","type":"tag","attributes":{"name":{"en":"Office Workers"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"b1e97889-25b4-4258-b28b-cd7f4d28ea9b","type":"tag","attributes":{"name":{"en":"Philosophical"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"cdad7e68-1419-41dd-bdce-27753074a640","type":"tag","attributes":{"name":{"en":"Horror"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f8f62932-27da-4fe4-8ee1-6779a8c5edba","type":"tag","attributes":{"name":{"en":"Tragedy"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2021-03-13T11:31:57+00:00","updatedAt":"2026-09-28T14:00:13+00:00","version":34,"availableTranslatedLanguages":["en","vi"],"latestUploadedChapter":"73deb0a5-1496-4c47-935d-5e1337d69b17"},"relationships":[{"id":"a747be07-91c2-4e1b-ba48-dd68b5b1e854","type":"author"},{"id":"408cd9f8-6ea1-4b08-8deb-70472b27e722","type":"artist"},{"id":"23414f2b-f381-4e23-8818-2ae83eb2fdaa","type":"cover_art","attributes":{"description":"","volume":"10","fileName":"785a6a6a-0957-4014-8cd0-60b8e3938c94.jpg","locale":"ja","createdAt":"2026-09-15T09:22:08+00:00","updatedAt":"2026-09-15T09:22:08+00:00","version":1}}]},{"id":"85a99758-de39-471e-9f6d-800547f53d0a","type":"manga","attributes":{"title":{"ja-ro":"Tougen Anki"},"altTitles":[{"ja":"\u6843\u6e90\u6697\u9b3c"},{"en":"Tougen Anki: Legend of the Cursed Blood"},{"fr":"Tougen Anki : La l\u00e9gende du sang maudit"}],"description":{"en":"Ichinose Shiki, an inheritor of the blood of Oni had lived out his entire childhood oblivious to this fact. However, when an unknown man comes rushing into his home in attempts to assassinate him, his foster father finally reveals the truth. In a world where Oni and Momotarou have never been able to coexist, join Ichinose in his struggle for power and unifying the two races!","fr":"Une l\u00e9gende raconte qu'un enfant extr\u00eamement fort serait n\u00e9 d'une p\u00eache et baptis\u00e9 Momotar\u00f4. Lorsqu'il devint assez grand et puissant, ce valeureux guerrier aurait chass\u00e9 les Oni qui pillaient les villages. Ce h\u00e9ros n'est pas une l\u00e9gende... Tout comme les Oni...\nLeurs descendants sont encore parmi nous et la bataille opposait le clan Momotar\u00f4 au clan des Oni fait rage ! Shiki est un jeune gar\u00e7on, au sang chaud. Alors qu'il vient de se faire renvoyer de l'\u00e9cole, il prend conscience qu'il poss\u00e8de du sang de Oni. Le clan Momotar\u00f4 le cherche et veut l'\u00e9liminer. la qu\u00eate de libert\u00e9 de Shiki et des autres Oni commence...","ja":"\u300c\u304a\u524d\u306f\u9b3c\u306e\u8840\u3092\u7d99\u3044\u3067\u3044\u308b\u2026\u2026\u300d\u4e3b\u4eba\u516c\u30fb\u56db\u5b63\u306f\u81ea\u3089\u306e\u8840\u306b\u68f2\u3080\u8005\u3068\u51fa\u9022\u3046\u3053\u3068\u306b\u306a\u308b\u3002","pt-br":"Ichinose Shiki, um herdeiro do sangue de Oni, viveu toda a sua inf\u00e2ncia alheio a esse fato. No entanto, quando um homem desconhecido entra correndo em sua casa na tentativa de assassin\u00e1-lo, seu pai adotivo finalmente revela a verdade. Em um mundo onde Oni e Momotarou nunca puderam coexistir, junte-se a Ichinose em sua luta pelo poder e unificando as duas ra\u00e7as!"},"isLocked":false,"links":{"al":"119968","ap":"tougen-anki-legend-of-the-cursed-blood","bl":"855263","bw":"series\/267197","kt":"59155","mu":"r3nvgud","amz":"https:\/\/www.amazon.co.jp\/dp\/B08RJ15R8R","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/607916\/","mal":"127436","raw":"https:\/\/mangacross.jp\/comics\/tougenanki"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2020,"contentRating":"suggestive","tags":[{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"39730448-9a5f-48a2-85b0-a70db87b1233","type":"tag","attributes":{"name":{"en":"Demons"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"b29d6a3d-1569-4e7a-8caf-7557bc92cd5d","type":"tag","attributes":{"name":{"en":"Gore"},"description":{},"group":"content","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"da2d50ca-3018-4cc0-ac7a-6b7d472a29ea","type":"tag","attributes":{"name":{"en":"Delinquents"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"dd1f77c5-dea9-4e2b-97ae-224af09caf99","type":"tag","attributes":{"name":{"en":"Monster Girls"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"eabc5b4c-6aff-42f3-b657-3e90cbd00b75","type":"tag","attributes":{"name":{"en":"Supernatural"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-07-29T06:27:29+00:00","updatedAt":"2026-07-29T17:33:49+00:00","version":55,"availableTranslatedLanguages":["es-la","en","fr","pl","ar","pt-br","ru","tr","it","ms"],"latestUploadedChapter":"3d26ca73-29f4-40c9-8af6-a6ec927ee18b"},"relationships":[{"id":"2dd0aabf-c68d-4012-b582-5f1520fa960e","type":"author"},{"id":"2dd0aabf-c68d-4012-b582-5f1520fa960e","type":"artist"},{"id":"fc81a7ae-0cd8-49f5-a103-b19930b00f89","type":"cover_art","attributes":{"description":"","volume":"31","fileName":"139b8f72-68fe-4d57-bd70-a210402eb173.jpg","locale":"ja","createdAt":"2026-10-06T10:15:26+00:00","updatedAt":"2026-10-06T10:15:26+00:00","version":1}},{"id":"4a0cc442-b083-4569-b071-d690e345721e","type":"manga","related":"alternate_story"}]},{"id":"38179337-1640-4927-8851-9bedd8d19e82","type":"manga","attributes":{"title":{"ja-ro":"Shiotaiou no Sato-san ga Ore ni dake Amai"},"altTitles":[{"ja":"\u5869\u5bfe\u5fdc\u306e\u4f50\u85e4\u3055\u3093\u304c\u4ffa\u306b\u3060\u3051\u7518\u3044\uff20comic"},{"en":"The Salty Koharu Has a Soft Spot for Me"},{"en":"Aren't You Too Sweet Salt-God Sato-San?"},{"zh":"\u51b7\u6de1\u7684\u4f50\u85e4\u540c\u5b78\u53ea\u5c0d\u6211\u6492\u5b0c"},{"th":"\u0e04\u0e38\u0e13\u0e0b\u0e32\u0e42\u0e15\u0e49\u0e22\u0e2d\u0e14\u0e19\u0e31\u0e01\u0e40\u0e21\u0e34\u0e19 \u0e40\u0e18\u0e2d\u0e2b\u0e27\u0e32\u0e19\u0e43\u0e2a\u0e48\u0e1c\u0e21\u0e41\u0e04\u0e48\u0e04\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27"},{"en":"The Salt-God Sato-san is Only Sweet to Me!"}],"description":{"en":"Satou-san is the unattainable flower of the class. She is always cold and curt with classmates, but only I know she's actually very cute when she smiles, even if she's not much of a photographer. Oshio-kun is friendly and lively, but only I know he works at his family's cafe after school. He does a great job with the cafe's SNS account, and his mischievous smile makes my heart skip a beat!","ja":"\u3053\u3093\u306a\u306b\u7518\u3044\u201d\u4e21\u7247\u60f3\u3044\u201d\u898b\u305f\u3053\u3068\u306a\u3044\uff01\n\n\u300c\u4f50\u85e4\u3055\u3093\u306f\u9ad8\u5dba\u306e\u82b1\u3067\u8ab0\u306b\u5bfe\u3057\u3066\u3082\u5869\u5bfe\u5fdc\u3002\u3067\u3082\u3001\u610f\u5916\u3068\u9699\u3060\u3089\u3051\u3060\u3063\u3066\u4ffa\u3060\u3051\u304c\u77e5\u3063\u3066\u308b\u3002\u5199\u771f\u3092\u64ae\u308b\u306e\u304c\u4e0b\u624b\u3002\u305d\u306e\u304f\u305b\u30c9\u30e4\u9854\u3057\u304c\u3061\u3002\u305d\u3057\u3066\u3001\u3078\u306b\u3083\u3063\u3068\u7b11\u3046\u9854\u304c\u3059\u3054\u304f\u53ef\u611b\u3044\u300d\n\n\u300c\u62bc\u5c3e\u541b\u306f\u8ab0\u306b\u5bfe\u3057\u3066\u3082\u512a\u3057\u3044\u3002\u3067\u3082\u3001\u610f\u5916\u3068\u3044\u3058\u308f\u308b\u306a\u3068\u3053\u308d\u3082\u3042\u308b\u3063\u3066\u79c1\u3060\u3051\u304c\u77e5\u3063\u3066\u308b\u3002SNS\u3092\u4f7f\u3046\u306e\u304c\u4e0a\u624b\u3002\u30aa\u30b7\u30e3\u30ec\u306a\u30ab\u30d5\u30a7\u306e\u5e97\u54e1\u3055\u3093\u3002\u305d\u3057\u3066\u3001\u60aa\u622f\u3063\u307d\u304f\u7b11\u3046\u9854\u306b\u3059\u3054\u304f\u30c9\u30ad\u30c9\u30ad\u3059\u308b\u300d\n\n\u2015\u2015\u3053\u308c\u306f\u5185\u7dd2\u3060\u3051\u3069\u3001\u4ffa\uff08\u79c1\uff09\u306f\u305d\u3093\u306a\u5f7c\u5973\uff08\u5f7c\uff09\u306e\u3053\u3068\u304c\u597d\u304d\u3060\u3002\n\n\u521d\u3005\u3057\u304f\u3066\u3001\u3082\u3069\u304b\u3057\u3044\u4e8c\u4eba\u306e\u521d\u604b\u3002\u5c0a\u3055\uff06\u7cd6\u5ea6120\uff05\uff01","pt-br":"Satou-san \u00e9 a flor inating\u00edvel da classe.  Ela \u00e9 sempre fria e r\u00edspida com os colegas de classe, mas s\u00f3 eu sei que ela \u00e9 realmente muito fofa quando sorri, mesmo que ela n\u00e3o seja muito fotog\u00eanica.\n  \nOshio-kun \u00e9 amig\u00e1vel e animado, mas s\u00f3 eu sei que ele trabalha no caf\u00e9 de sua fam\u00edlia depois da escola.  Ele faz um \u00f3timo trabalho com a conta da internet do caf\u00e9, e seu sorriso malicioso faz meu cora\u00e7\u00e3o bater mais forte!\n  \n Inocente e doce, mas \u00e0s vezes frustrante, esta \u00e9 uma hist\u00f3ria fofa 120% pura sobre duas pessoas se apaixonando pela primeira vez."},"isLocked":false,"links":{"al":"123130","ap":"shio-taiou-no-sato-san-ga-ore-ni-dake-amai","bl":"843292","bw":"series\/264202","kt":"60374","mu":"iq3jrwr","nu":"arent-you-too-sweet-salt-god-sato-san-ln","amz":"https:\/\/www.amazon.co.jp\/dp\/B0FCVFQW15","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/605761\/","mal":"129562","raw":"https:\/\/urasunday.com\/title\/1301"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2020,"contentRating":"safe","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-07-18T17:10:13+00:00","updatedAt":"2026-11-10T01:41:22+00:00","version":36,"availableTranslatedLanguages":["en","id","pt-br","vi","es-la","ar"],"latestUploadedChapter":"399f460b-327b-4f65-bc6e-4d14021aed57"},"relationships":[{"id":"9ddec818-1922-44f1-9e83-914a4cc6deaf","type":"author"},{"id":"394ec55d-cc53-4074-b264-899a1e82e222","type":"artist"},{"id":"807b0da2-eb99-44b5-8466-aa843d7a6d4d","type":"cover_art","attributes":{"description":"","volume":"11","fileName":"5466e035-50de-4ff5-86bf-29525a862203.jpg","locale":"ja","createdAt":"2026-10-07T12:32:47+00:00","updatedAt":"2026-10-07T12:32:47+00:00","version":1}}]},{"id":"20331b71-1d3f-4aed-b990-e54298424488","type":"manga","attributes":{"title":{"en":"Magic Knight Rayearth"},"altTitles":[{"ja":"\u9b54\u6cd5\u9a0e\u58eb\u30ec\u30a4\u30a2\u30fc\u30b9"}],"description":{"en":"Hikaru, Umi, and Fuu, girls from separate schools, find themselves linked together as they fall through the floor during a field trip to the Tokyo Tower. They land in a place called Cephiro, where their will controls what happens. They meet with Guru Clef and find out that they were summoned to save Princess Emeraude who has been imprisoned by High Priest Zagato. They learn magic and acquire weapons on their quest to save Cephiro from the evils of Zagato."},"isLocked":false,"links":{"al":"30119","ap":"magic-knight-rayearth","kt":"305","mu":"3hg5qxz","amz":"https:\/\/www.amazon.co.jp\/-\/en\/dp\/B074CJXG8R\/","mal":"119","raw":"https:\/\/kodansha.us\/series\/magic-knight-rayearth\/"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"3","lastChapter":"9","publicationDemographic":"shoujo","status":"completed","year":1993,"contentRating":"safe","tags":[{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"50880a9d-5440-4732-9afb-8f457127e836","type":"tag","attributes":{"name":{"en":"Mecha"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"ace04997-f6bd-436e-b261-779182193d3d","type":"tag","attributes":{"name":{"en":"Isekai"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2018-11-06T22:19:07+00:00","updatedAt":"2026-02-05T14:41:17+00:00","version":14,"availableTranslatedLanguages":["bg","pt-br","en","tr"],"latestUploadedChapter":"f8f2ee64-5d5f-4d76-9c2f-8e4dfe777507"},"relationships":[{"id":"60bc549c-f2ac-488e-9b83-c840a76d17ce","type":"author"},{"id":"60bc549c-f2ac-488e-9b83-c840a76d17ce","type":"artist"},{"id":"729b39a8-c847-43b8-b090-050bea87e69b","type":"cover_art","attributes":{"description":"Format: A5\r\nImprint: KC Deluxe\r\nPublisher: Kodansha\r\nYear: 1994","volume":"1","fileName":"67ba2366-4b75-463a-b49f-fad3f9b5cd3a.jpg","locale":"ja","createdAt":"2024-09-27T03:50:40+00:00","updatedAt":"2024-09-27T03:50:40+00:00","version":1}},{"id":"017ee020-493b-43b7-8d02-4121ec5b8d06","type":"manga","related":"doujinshi"},{"id":"8780e69b-0226-4f80-87c0-ac45bdf406b3","type":"manga","related":"spin_off"},{"id":"b68a8aa3-ac2b-4f66-bb09-adee3f32b323","type":"manga","related":"spin_off"},{"id":"f627c630-9d58-427c-ad74-2e57758f1c73","type":"manga","related":"side_story"},{"id":"f8bb9b41-d4a3-4851-a958-8c22cf6b752e","type":"manga","related":"sequel"}]},{"id":"9c756e83-1032-4338-82ca-47ae9d7f999a","type":"manga","attributes":{"title":{"ja-ro":"Doumo, Suki na hito ni Horegusuri o Iraisareta Majo desu."},"altTitles":[{"ja":"\u3069\u3046\u3082\u3001\u597d\u304d\u306a\u4eba\u306b\u60da\u308c\u85ac\u3092\u4f9d\u983c\u3055\u308c\u305f\u9b54\u5973\u3067\u3059\u3002"},{"en":"Hello, I Am a Witch, and My Crush Wants Me to Make a Love Potion!"},{"en":"I'm a Witch Whose Crush Requested a Love Potion."},{"zh":"\u4f60\u597d\u3001\u6211\u662f\u53d7\u5fc3\u4e0a\u4eba\u6240\u6258\u6765\u505a\u604b\u7231\u836f\u7684\u9b54\u5973"},{"id":"Hai, aku penyihir yang diminta membuat ramuan cinta untuk orang yang kucintai"},{"en":"Hi, I'm a Witch, and My Crush Wants Me to Make a Love Potion"},{"vi":"Crush Mu\u1ed1n T\u00f4i L\u00e0m M\u1ed9t L\u1ecd T\u00ecnh D\u01b0\u1ee3c Cho Anh \u1ea4y!"},{"th":"\u0e04\u0e19\u0e1b\u0e23\u0e38\u0e07\u0e22\u0e32\u0e40\u0e2a\u0e19\u0e48\u0e2b\u0e4c\u0e02\u0e27\u0e14\u0e19\u0e35\u0e49\u0e41\u0e2d\u0e1a\u0e21\u0e35\u0e43\u0e08\u0e43\u0e2b\u0e49\u0e2d\u0e22\u0e39\u0e48\u0e23\u0e39\u0e49\u0e1a\u0e49\u0e32\u0e07\u0e44\u0e2b\u0e21"}],"description":{"en":"\"I want you to make me a love potion.\"\n\nThe \u201cWitch of the Lake\u201d had her heart broken when the object of her one-sided affection requested that she make him a love potion.\n\nIf that\u2019s the case, then I wish to spend more time with him, even if it\u2019s just up until the preparations for the love potion are complete. That was what I had told myself, and yet\u2026\n\nThe romantic tale of a reclusive witch and a solemn knight that begins from unrequited love.\n\n---\n\n[Official English Light Novel](https:\/\/crossinfworld.com\/Hello-I-am-a-Witch-and-my-Crush-Wants-me-to-Make-a-Love-Potion.html)"},"isLocked":false,"links":{"al":"123545","ap":"hi-im-a-witch-and-my-crush-wants-me-to-make-a-love-potion","bl":"20029844","kt":"60018","mu":"xo079u2","nu":"i-am-a-witch-requested-by-my-crush-to-make-love-potion","mal":"130498","raw":"https:\/\/seiga.nicovideo.jp\/comic\/49494","engtl":"https:\/\/yenpress.com\/series\/hi-i-m-a-witch-and-my-crush-wants-me-to-make-a-love-potion"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"josei","status":"ongoing","year":2020,"contentRating":"safe","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-10-03T11:50:19+00:00","updatedAt":"2026-08-25T14:53:33+00:00","version":27,"availableTranslatedLanguages":["vi","pt-br","en","ru"],"latestUploadedChapter":"f8e98837-878d-4cb2-afa6-9af67cf57760"},"relationships":[{"id":"d207b4c5-c36a-4637-8690-d0dfd2197608","type":"author"},{"id":"032ced2c-b181-45c9-9602-bb60cbad4b06","type":"artist"},{"id":"91403be9-9e72-4d6d-84c3-d2fc438b9b58","type":"cover_art","attributes":{"description":"","volume":"6","fileName":"fc2e46fb-c205-40a7-8adb-2f77b17aa291.jpg","locale":"ja","createdAt":"2026-05-25T07:48:02+00:00","updatedAt":"2026-05-25T07:48:02+00:00","version":1}}]},{"id":"e18fe8c6-f6dc-4f05-8462-7b2083ff9a6c","type":"manga","attributes":{"title":{"ja-ro":"Kusuriya no Hitorigoto"},"altTitles":[{"en":"The Apothecary Diaries"},{"de":"Die Tageb\u00fccher der Apothekerin - Geheimnisse am Kaiserhof"},{"es":"Los Diarios de La Boticaria"},{"it":"I diari della speziale"},{"it":"Il monologo della speziale"},{"fr":"Les carnets de l'apothicaire"},{"pl":"Zapiski zielarki"},{"ru":"\u041c\u043e\u043d\u043e\u043b\u043e\u0433 \u0432 \u0430\u043f\u0442\u0435\u0447\u043d\u043e\u0439 \u043b\u0430\u0432\u043a\u0435"},{"uk":"\u0429\u043e\u0434\u0435\u043d\u043d\u0438\u043a \u0442\u0440\u0430\u0432\u043d\u0438\u043a\u0430\u0440\u043a\u0438"},{"ar":"\u064a\u0648\u0645\u064a\u0627\u062a \u0627\u0644\u0635\u064a\u062f\u0644\u0629"},{"th":"\u0e2a\u0e37\u0e1a\u0e04\u0e14\u0e35\u0e1b\u0e23\u0e34\u0e28\u0e19\u0e32 \u0e2b\u0e21\u0e2d\u0e22\u0e32\u0e15\u0e33\u0e23\u0e31\u0e1a\u0e42\u0e04\u0e21\u0e41\u0e14\u0e07 \u0e40\u0e25\u0e48\u0e21"},{"ko":"\uc57d\uc0ac\uc758 \ud63c\uc7a3\ub9d0"},{"zh":"\u836f\u5c4b\u5c11\u5973\u7684\u5462\u5583"},{"zh-hk":"\u85e5\u5e2b\u5c11\u5973\u7684\u7368\u8a9e"},{"vi":"D\u01b0\u1ee3c S\u01b0 T\u1ef1 S\u1ef1"},{"id":"Keseharian sang Apoteker"},{"ka":"\u10e4\u10d0\u10e0\u10db\u10d0\u10ea\u10d4\u10d5\u10e2\u10d8\u10e1 \u10db\u10dd\u10dc\u10dd\u10da\u10dd\u10d2\u10d8"},{"es":"El Mon\u00f3logo del Farmac\u00e9utico"},{"ja":"\u85ac\u5c4b\u306e\u3072\u3068\u308a\u3054\u3068"},{"pt-br":"Di\u00e1rios de uma apotec\u00e1ria"},{"hu":"A gy\u00f3gyszer\u00e9sz napl\u00f3ja"},{"eu":"Farmazialariaren Monologoa"}],"description":{"de":"Maomao ist eine unscheinbare Dienerin am Kaiserlichen kaiserlichen Hof. Zumindest bem\u00fcht sie sich, so gesehen zu werden. Denn seit sie in den Dienst des Kaisers verkauft wurde, hat die junge Apothekerin alles darangesetzt, ihre Schuld abzuarbeiten, ohne weiteres Aufsehen zu erregen, damit sie bald nach Hause zur\u00fcckkehren kann. Aber Maomao ist schlau \u2013 und viel zu neugierig. Als die Kronprinzen einer nach dem anderen einem mysteri\u00f6sen \u201eFluch\u201c erliegen, mischt sie sich heimlich ein, um das R\u00e4tsel zu l\u00f6sen. Dabei erregt sie die Aufmerksamkeit des Eunuchen Jinshi \u2013 und eh sie sichs versieht, wird sie mitten in die Intrigen am Kaiserhof hineingezogen\u2026","en":"Maomao, a young woman trained in the art of herbal medicine, is forced to work as a lowly servant in the inner palace. Though she yearns for life outside its perfumed halls, she isn\u2019t long for a life of drudgery! Using her wits to break a \u201ccurse\u201d afflicting the imperial heirs, Maomao attracts the attentions of the handsome eunuch Jinshi and is promoted to attendant food taster. But Jinshi has other plans for the erstwhile apothecary, and soon Maomao is back to brewing potions and\u2026solving mysteries?!\n___\nWinner of the [Tsugi ni Kuru Manga Award 2019](https:\/\/manba.co.jp\/awards\/813)","fr":"\u00c0 17 ans, Mao Mao a une vie compliqu\u00e9e. Form\u00e9e d\u00e8s son jeune \u00e2ge par un apothicaire du quartier des plaisirs, elle se retrouve enlev\u00e9e et vendue comme servante dans le quartier des femmes du palais imp\u00e9rial! Entour\u00e9 de hauts murs, il est coup\u00e9 du monde ext\u00e9rieur. Afin de survivre dans cette prison de luxe grouillant de complots et de basses man\u0153uvres, la jeune fille tente de cacher ses connaissances pour se fondre dans la masse.\n\nMais, quand les morts suspectes de princes nouveau-n\u00e9s mettent la cour en \u00e9moi, sa passion pour les poisons prend le dessus. Elle observe, enqu\u00eate\u2026 et trouve la solution! En voulant bien faire, la voil\u00e0 rep\u00e9r\u00e9e\u2026 Jinshi, haut fonctionnaire aussi beau que calculateur, devine son talent et la promeut go\u00fbteuse personnelle d\u2019une des favorites de l\u2019empereur. Au beau milieu de ce nid de serpents, le moindre faux pas peut lui \u00eatre fatal!\n\n---\n\nMaison d'\u00e9dition FR : **Ki-oon**","hu":"Maomao, egy fiatal n\u0151, akit a gy\u00f3gyn\u00f6v\u00e9nytan m\u0171v\u00e9szet\u00e9re k\u00e9peztek ki, k\u00e9nytelen alantas szolg\u00e1l\u00f3k\u00e9nt dolgozni a bels\u0151 palot\u00e1ban. B\u00e1r a parf\u00fcmillat\u00fa termeken k\u00edv\u00fcli \u00e9letre v\u00e1gyik, nem sok\u00e1ig marad meg a robotol\u00e1sban! Esz\u00e9t haszn\u00e1lva megt\u00f6ri a cs\u00e1sz\u00e1ri \u00f6r\u00f6k\u00f6s\u00f6ket s\u00fajt\u00f3 \u201e\u00e1tkot\u201d, amivel felkelti a j\u00f3k\u00e9p\u0171 eunuch, Jinshi figyelm\u00e9t, \u00e9s el\u0151l\u00e9ptetik udvari \u00e9telk\u00f3stol\u00f3v\u00e1. Jinshinek azonban m\u00e1s tervei is vannak az egykori gy\u00f3gyszer\u00e9sszel, \u00edgy Maomao hamarosan \u00fajra f\u0151zeteket k\u00e9sz\u00edt... \u00e9s rejt\u00e9lyeket old meg?!","id":"Diculik dan dijual ke harem, Maomao berusaha bertahan dengan kemampuannya beradaptasi. Wawasan yang luas tentang obat-obatan membuat karirnya melompat tinggi, langsung menjadi pelayan pribadi selir kesayangan kaisar!","it":"Maomao, una giovane farmacista del quartiere a luci rosse della capitale, viene venduta suo malgrado come sguattera alla corte imperiale. Anche se desidera ardentemente tornare libera, si ritrova a non disdegnare la vita tutto sommato comoda che \u00e8 riuscita a ritagliarsi a palazzo, dove, senza farsi notare, riesce a proseguire i suoi studi di fitoterapia e sulla preparazione dei veleni. Di fronte a un male che affligge i figli dell\u2019imperatore, Maomao sente tuttavia di farsi avanti e, sfruttando le sue conoscenze, riesce a salvare loro la vita. La ragazza attira cos\u00ec le attenzioni del bel eunuco Jinshi, che ha in mente per lei dei piani ben precisi.\n\n---\nGiovani donne vengono spesso vendute per lavorare per un breve periodo nell'harem dell'imperatore. \u00c8 questo il caso di Maomao, farmacista presso il quartiere a luci rosse. Non ha alcun interesse nel farsi notare a palazzo e preferisce starsene per conto suo a preparare medicine, studiare veleni o fare esperimenti su se stessa. Ma quando a corte si diffonde la voce che i figli dell'imperatore sono destinati a una morte prematura, Maomao non riesce a rimanere indifferente. Mentre cerca di indagare, cattura l'attenzione di misterioso e affascinante ufficiale di alto rango. Ha cos\u00ec inizio la sua particolare carriera.","ja":"\u5bae\u4e2d\u306b\u540d\u63a2\u5075\u8a95\u751f!?\n\n\u300c\u5c0f\u8aac\u5bb6\u306b\u306a\u308d\u3046\u300d\u767a! \n\u30d2\u30fc\u30ed\u30fc\u6587\u5eab\u306e\u5927\u4eba\u6c17\u30bf\u30a4\u30c8\u30eb\u300e\u85ac\u5c4b\u306e\u3072\u3068\u308a\u3054\u3068\u300f\u304c\u3001\u5f85\u671b\u306e\u30b3\u30df\u30ab\u30e9\u30a4\u30ba! \n\u4e2d\u4e16\u306e\u5bae\u4e2d\u3067\u4e0b\u50cd\u304d\u3092\u3059\u308b\u5c11\u5973\u30fb\u732b\u732b(\u30de\u30aa\u30de\u30aa)\u3002\n\u82b1\u8857\u3067\u85ac\u5e2b\u3092\u3084\u3063\u3066\u3044\u305f\u5f7c\u5973\u304c\u3001\u5e1d\u306e\u5fa1\u5b50\u305f\u3061\u304c\u7686\u77ed\u547d\u3067\u3042\u308b\u3053\u3068\u3044\u3046\u5642\u3092\u805e\u3044\u3066\u3057\u307e\u3063\u305f\u3068\u3053\u308d\u304b\u3089\u3001\u7269\u8a9e\u306f\u52d5\u304d\u59cb\u3081\u308b\u3002\n\u6301\u3061\u524d\u306e\u597d\u5947\u5fc3\u3068\u77e5\u8b58\u6b32\u306b\u7a81\u304d\u52d5\u304b\u3055\u308c\u3001\u8208\u5473\u672c\u4f4d\u3067\u305d\u306e\u539f\u56e0\u3092\u8abf\u3079\u59cb\u3081\u308b\u732b\u732b\u306e\u904b\u547d\u306f\u2015\u2015\u2026!?\n\u300c\u5c0f\u8aac\u5bb6\u306b\u306a\u308d\u3046\u300d\u306f\u682a\u5f0f\u4f1a\u793e\u30d2\u30ca\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u767b\u9332\u5546\u6a19\u3067\u3059\u3002","pl":"Maomao, ambitna m\u0142oda zielarka, zostaje porwana i trafia do haremu cesarza jako s\u0142u\u017c\u0105ca. Aby nie pogarsza\u0107 sytuacji, w kt\u00f3rej si\u0119 znalaz\u0142a, zataja swoje umiej\u0119tno\u015bci, a nawet fakt, \u017ce potrafi czyta\u0107 i pisa\u0107. Tymczasem nowo narodzone dzieci w\u0142adcy umieraj\u0105 na skutek tajemniczej kl\u0105twy. Zielarka szybko orientuje si\u0119, \u017ce to nie magia, ale trucizna jest przyczyn\u0105 \u015bmierci niemowl\u0105t. Decyduje si\u0119 ostrzec ksi\u0119\u017cniczki, podrzucaj\u0105c do ich komnat wiadomo\u015b\u0107 o powodach niezwyk\u0142ej choroby ich dzieci. Dziewczyna nie przypuszcza nawet, jak bardzo ta decyzja zawa\u017cy na jej losie. Tym bardziej, \u017ce znalaz\u0142a si\u0119 w miejscu, w kt\u00f3rym nikt nie mo\u017ce czu\u0107 si\u0119 bezpieczny...","ru":"\u0412 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0438\u0439 \u0434\u0432\u043e\u0440 \u0431\u044b\u043b\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u043c\u043e\u043b\u043e\u0434\u0430\u044f \u0434\u0435\u0432\u0443\u0448\u043a\u0430 \u041c\u0430\u043e\u043c\u0430\u043e. \u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0435\u0451 \u0431\u0435\u0440\u0451\u0442 \u043d\u0430\u0447\u0430\u043b\u043e \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 \u043a\u0440\u0430\u0441\u043d\u044b\u0445 \u0444\u043e\u043d\u0430\u0440\u0435\u0439, \u0433\u0434\u0435 \u043d\u0430\u0447\u0430\u043b\u0438 \u0445\u043e\u0434\u0438\u0442\u044c \u0441\u043b\u0443\u0445\u0438 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u0436\u0438\u0437\u043d\u0438 \u0434\u0435\u0442\u0435\u0439 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u043f\u043e\u0434 \u0443\u0433\u0440\u043e\u0437\u043e\u0439. \u0415\u044e \u0434\u0432\u0438\u0436\u0443\u0442 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u0441\u0442\u0432\u043e \u0438 \u0436\u0430\u0436\u0434\u0430 \u0437\u043d\u0430\u043d\u0438\u0439. \u0427\u0442\u043e\u0431\u044b \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u044c \u0441\u0432\u043e\u0451 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u0441\u0442\u0432\u043e, \u043c\u043e\u043b\u043e\u0434\u0430\u044f \u0446\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430 \u0431\u0443\u0434\u0435\u0442 \u0434\u043e\u043a\u0430\u043f\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u0434\u043e \u0438\u0441\u0442\u0438\u043d\u044b! \u0427\u0442\u043e \u0436\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u0441\u044f \u043f\u0440\u0438 \u0438\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u043e\u043c \u0434\u0432\u043e\u0440\u0435?! \u0410\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f \u043e\u0434\u043d\u043e\u0438\u043c\u0451\u043d\u043d\u043e\u0433\u043e \u0440\u0430\u043d\u043e\u0431\u044d.  \n\n\n---\n\n- Won the Grand Prize in the Printed Manga category at the Tsugi ni Kuru Manga Award 2019.  \n\n\n---\n\n**Links:**  \n- [Mangaka's Twitter](https:\/\/twitter.com\/nekokurage_)  \n- [Japanese Light Novel Bookwalker](https:\/\/bookwalker.jp\/series\/160955\/)  \n- [Official English Light Novel Translation](https:\/\/j-novel.club\/s\/the-apothecary-diaries\/)  \n- [Official French Translation](http:\/\/www.ki-oon.com\/mangas\/tomes-1382-carnets-de-l-apothicaire.html)  \n- [Official Chinese (Simplified) Translation](https:\/\/manga.bilibili.com\/detail\/mc28218)","th":"\u0e13 \u0e2d\u0e32\u0e13\u0e32\u0e08\u0e31\u0e01\u0e23\u0e43\u0e2b\u0e0d\u0e48\u0e22\u0e31\u0e01\u0e29\u0e4c\u0e41\u0e2b\u0e48\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e0b\u0e36\u0e48\u0e07\u0e15\u0e31\u0e49\u0e07\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e08\u0e01\u0e25\u0e32\u0e07\u0e17\u0e27\u0e35\u0e1b \u0e40\u0e14\u0e47\u0e01\u0e2a\u0e32\u0e27\u0e19\u0e32\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e1c\u0e39\u0e49\u0e17\u0e33\u0e07\u0e32\u0e19\u0e40\u0e1b\u0e47\u0e19\u0e2b\u0e21\u0e2d\u0e22\u0e32\u0e43\u0e19\u0e2a\u0e16\u0e32\u0e19\u0e40\u0e23\u0e34\u0e07\u0e23\u0e21\u0e22\u0e4c\u0e22\u0e48\u0e32\u0e19\u0e42\u0e04\u0e21\u0e41\u0e14\u0e07\u0e2d\u0e31\u0e19\u0e21\u0e35\u0e19\u0e32\u0e21\u0e27\u0e48\u0e32 \u2018\u0e40\u0e21\u0e32\u0e40\u0e21\u0e32\u2019 \u0e1a\u0e31\u0e14\u0e19\u0e35\u0e49\u0e40\u0e01\u0e34\u0e14\u0e08\u0e31\u0e1a\u0e1e\u0e25\u0e31\u0e14\u0e08\u0e31\u0e1a\u0e1c\u0e25\u0e39\u0e15\u0e49\u0e2d\u0e07\u0e21\u0e32\u0e17\u0e33\u0e07\u0e32\u0e19\u0e23\u0e31\u0e1a\u0e43\u0e0a\u0e49\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e27\u0e31\u0e07\u0e2b\u0e25\u0e31\u0e07\n\n\u0e40\u0e18\u0e2d\u0e17\u0e33\u0e44\u0e14\u0e49\u0e40\u0e1e\u0e35\u0e22\u0e07\u0e40\u0e1d\u0e49\u0e32\u0e23\u0e2d\u0e43\u0e2b\u0e49\u0e2b\u0e21\u0e14\u0e27\u0e32\u0e23\u0e30\u0e01\u0e32\u0e23\u0e17\u0e33\u0e07\u0e32\u0e19\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e2a\u0e07\u0e1a\u0e40\u0e2a\u0e07\u0e35\u0e48\u0e22\u0e21\u0e40\u0e08\u0e35\u0e22\u0e21\u0e15\u0e31\u0e27 \u0e14\u0e49\u0e27\u0e22\u0e23\u0e39\u0e1b\u0e23\u0e48\u0e32\u0e07\u0e2b\u0e19\u0e49\u0e32\u0e15\u0e32\u0e17\u0e35\u0e48\u0e44\u0e21\u0e48\u0e2a\u0e30\u0e2a\u0e27\u0e22\u0e08\u0e36\u0e07\u0e21\u0e31\u0e48\u0e19\u0e43\u0e08\u0e40\u0e1b\u0e47\u0e19\u0e19\u0e31\u0e01\u0e2b\u0e19\u0e32\u0e27\u0e48\u0e32\u0e15\u0e19\u0e08\u0e30\u0e44\u0e21\u0e48\u0e21\u0e35\u0e27\u0e31\u0e19\u0e42\u0e14\u0e19\u0e08\u0e31\u0e01\u0e23\u0e1e\u0e23\u0e23\u0e14\u0e34\u0e40\u0e23\u0e35\u0e22\u0e01\u0e44\u0e1b\u0e40\u0e1b\u0e47\u0e19 \u2018\u0e04\u0e39\u0e48\u0e19\u0e2d\u0e19\u2019 \u0e2d\u0e22\u0e48\u0e32\u0e07\u0e41\u0e19\u0e48\u0e41\u0e17\u0e49\n\n\u0e41\u0e15\u0e48\u0e43\u0e19\u0e02\u0e13\u0e30\u0e19\u0e31\u0e49\u0e19\u0e40\u0e2d\u0e07 \u0e42\u0e2d\u0e23\u0e2a\u0e18\u0e34\u0e14\u0e32\u0e02\u0e2d\u0e07\u0e08\u0e31\u0e01\u0e23\u0e1e\u0e23\u0e23\u0e14\u0e34\u0e01\u0e25\u0e31\u0e1a\u0e21\u0e35\u0e40\u0e2b\u0e15\u0e38\u0e43\u0e2b\u0e49\u0e2d\u0e32\u0e22\u0e38\u0e2a\u0e31\u0e49\u0e19\n\u0e1e\u0e2d\u0e23\u0e39\u0e49\u0e27\u0e48\u0e32\u0e2a\u0e2d\u0e07\u0e17\u0e32\u0e23\u0e01\u0e19\u0e49\u0e2d\u0e22\u0e17\u0e35\u0e48\u0e22\u0e31\u0e07\u0e40\u0e2b\u0e25\u0e37\u0e2d\u0e23\u0e2d\u0e14\u0e01\u0e33\u0e25\u0e31\u0e07\u0e1b\u0e48\u0e27\u0e22\u0e2b\u0e19\u0e31\u0e01 \u0e40\u0e21\u0e32\u0e40\u0e21\u0e32\u0e08\u0e36\u0e07\u0e25\u0e07\u0e21\u0e37\u0e2d\u0e02\u0e38\u0e14\u0e04\u0e38\u0e49\u0e22\u0e2b\u0e32\u0e2a\u0e32\u0e40\u0e2b\u0e15\u0e38\u2014","uk":"\u0429\u0435 \u0437\u043e\u0432\u0441\u044b\u043c \u044e\u043d\u0430 \u041c\u0430\u043c\u0430\u043e \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0454 \u043c\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u043e \u043b\u0456\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0440\u0430\u0432\u0430\u043c\u0438, \u043c\u0440\u0456\u044e\u0447\u0438 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u043b\u0456\u043a\u0438 \u0432\u0456\u0434 \u0443\u0441\u0456\u0445 \u043d\u0435\u0434\u0443\u0433. \u041e\u0434\u043d\u0430\u043a \u043f\u0440\u043e\u0442\u0438 \u0441\u0432\u043e\u0454\u0457 \u0432\u043e\u043b\u0456 \u0432\u043e\u043d\u0430 \u043f\u043e\u0442\u0440\u0430\u043f\u043b\u044f\u0454 \u0432 \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0441\u044c\u043a\u0438\u0439 \u0433\u0430\u0440\u0435\u043c \u044f\u043a \u0441\u043b\u0443\u0436\u043d\u0438\u0446\u044f. \u0412\u043e\u043d\u0430 \u0432\u0438\u0440\u0456\u0448\u0443\u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u0442\u0438 \u043d\u0430\u0431\u0443\u0442\u0456 \u0437\u043d\u0430\u043d\u043d\u044f, \u0442\u043e\u043c\u0443 \u043f\u0440\u0438\u043a\u0438\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u043e\u0434\u043d\u0456\u0454\u044e \u0437 \u0431\u0430\u0433\u0430\u0442\u044c\u043e\u0445 \u043d\u0435\u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u0438\u0445 \u0434\u0456\u0432\u0447\u0430\u0442. \u0422\u0438\u043c \u0447\u0430\u0441\u043e\u043c \u0434\u0456\u0442\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044f \u0433\u0438\u043d\u0443\u0442\u044c \u0437\u0430 \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0432\u0438\u0445 \u043e\u0431\u0441\u0442\u0430\u0432\u0438\u043d. \u041a\u043e\u043b\u0438 \u0432\u0435\u0441\u044c \u0434\u0432\u0456\u0440 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043f\u0440\u043e \u0442\u0430\u0454\u043c\u043d\u0438\u0447\u0435 \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u0442\u044f, \u041c\u0430\u043e\u043c\u0430\u043e \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0454 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0438 \u043e\u0442\u0440\u0443\u0454\u043d\u043d\u044f. \u0410\u043b\u0435 \u044f\u043a \u0437\u0430\u0441\u0442\u0435\u0440\u0435\u0433\u0442\u0438 \u0437\u043d\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0456\u0432 \u0432\u0456\u0434 \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u043a\u0438, \u043a\u043e\u043b\u0438 \u0432 \u043e\u0442\u043e\u0447\u0435\u043d\u043d\u0456 \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0433\u043e\u043b\u043e\u0441 \u043f\u0440\u043e\u0441\u0442\u043e\u0433\u043e \u0441\u043b\u0443\u0433\u0438 \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0454? \u0417\u0430 \u0432\u043e\u0440\u043e\u0442\u0430\u043c\u0438 \u0412\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u043f\u0430\u043b\u0430\u0446\u0443 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u0457 \u043c\u0438\u0442\u0456 \u043c\u043e\u0436\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u044f \u0447\u0435\u0440\u0433\u043e\u0432\u0430 \u0442\u0440\u0430\u0433\u0435\u0434\u0456\u044f. \u0427\u0438 \u0437\u043d\u0430\u0439\u0434\u0435 \u041c\u0430\u043e\u043c\u0430\u043e \u0441\u0432\u043e\u0454 \u043c\u0456\u0441\u0446\u0435 \u0432 \u0446\u044c\u043e\u043c\u0443 \u0441\u0432\u0456\u0442\u0456, \u043f\u043e\u0432\u043d\u043e\u043c\u0443 \u0456\u043d\u0442\u0440\u0438\u0433?","vi":"Mi\u00eau Mi\u00eau l\u00e0 m\u1ed9t c\u00f4 g\u00e1i l\u00e0m c\u00f4ng vi\u1ec7c h\u1ea7u h\u1ea1 trong cung \u0111\u00ecnh th\u1eddi phong ki\u1ebfn.\nC\u00e2u chuy\u1ec7n c\u1ee7a ch\u00fang ta b\u1eaft \u0111\u1ea7u v\u1edbi vi\u1ec7c c\u00f4 g\u00e1i t\u1eebng h\u00e0nh ngh\u1ec1 d\u01b0\u1ee3c s\u01b0 \u1edf ph\u1ed1 hoa n\u00e0y nghe th\u1ea5y ng\u01b0\u1eddi ta \u0111\u1ed3n th\u1ed5i r\u1eb1ng: t\u1ea5t c\u1ea3 nh\u1eefng \u0111\u1ee9a con c\u1ee7a Ho\u00e0ng \u0111\u1ebf \u0111\u1ec1u \u0111o\u1ea3n m\u1ec7nh.\nB\u1ecb th\u00fac \u0111\u1ea9y b\u1edfi ni\u1ec1m kh\u00e1t khao tri th\u1ee9c v\u00e0 t\u00ednh hi\u1ebfu k\u00ec c\u1ed1 h\u1eefu, Mi\u00eau Mi\u00eau b\u1eaft tay v\u00e0o t\u00ecm hi\u1ec3u nguy\u00ean nh\u00e2n, xem \u0111\u00f3 nh\u01b0 m\u1ed9t c\u00e1ch gi\u1ea3i khu\u00e2y kh\u00f4ng h\u01a1n kh\u00f4ng k\u00e9m.","pt-br":"Em uma certa corte imperial, j\u00e1 faz alguns meses desde que uma garota de 17 anos conhecida como Maomao foi sequestrada e for\u00e7ada a trabalhar como uma serva de baixo escal\u00e3o no pal\u00e1cio do imperador. Ainda assim, ela consegue manter seu esp\u00edrito curioso e pragm\u00e1tico, planejando trabalhar at\u00e9 que seus anos de servid\u00e3o acabem. Um dia, no entanto, ela descobre que os dois beb\u00eas do imperador ficaram gravemente doentes. Ela decide agir secretamente, aproveitando sua experi\u00eancia como farmac\u00eautica criada no pobre distrito da luz vermelha.\n\nApesar das tentativas de Maomao de permanecer an\u00f4nima, ela logo chama a aten\u00e7\u00e3o de Jinshi, um eunuco influente que reconhece seus talentos. Maomao logo se encontra na corte interna do imperador, onde gradualmente faz seu nome ao utilizar seu conhecimento e personalidade exc\u00eantrica para resolver v\u00e1rios mist\u00e9rios m\u00e9dicos.\n\n[ 1\u00b0 TEMP. DO ANIME ADAPTOU AT\u00c9: Vol. 5, Cap 40. ]","zh-hk":"\u6642\u503c\u4e2d\u4e16\u7d00\uff0c\u4f4d\u8655\u5927\u9678\u4e2d\u592e\u7684\u67d0\u500b\u5927\u570b\uff0c\u6709\u4f4d\u59d1\u5a18\u540d\u559a\u8c93\u8c93\uff0c\u539f\u672c\u5728\u7159\u82b1\u5df7\u64d4\u4efb\u85e5\u5e2b\uff0c\u73fe\u5728\u5247\u5728\u5f8c\u5bae\u7576\u4e0b\u5973\u3002\u5176\u9593\uff0c\u8c93\u8c93\u7121\u610f\u9593\u807d\u8aaa\u7687\u5b50\u7686\u5e74\u5e7c\u65e9\u592d\u7684\u50b3\u805e\uff0c\u4e26\u5f97\u77e5\u9023\u5c1a\u5728\u4eba\u4e16\u7684\u7687\u5b50\u7687\u5973\u4e5f\u8eab\u67d3\u91cd\u75c5\uff0c\u5979\u65bc\u662f\u958b\u59cb\u8abf\u67e5\u5176\u75c5\u56e0\u2500\u2500\u5ee3\u7372\u8b9a\u8b7d\u7684\u9163\u66a2\u6dcb\u6f13\u63a8\u7406\u4e4b\u4f5c\uff0c\u773e\u6240\u671f\u76fc\u7684\u7b2c\u4e00\u96c6\u7d42\u65bc\u51fa\u7248\u3002\u4ee5\u4e2d\u4e16\u7d00\u6771\u65b9\u70ba\u821e\u81fa\uff0c\u300c\u8a66\u6bd2\u300d\u5c11\u5973\u5c07\u4e00\u4e00\u89e3\u6c7a\u5bae\u4e2d\u767c\u751f\u7684\u61f8\u7591\u6848\u4ef6\uff01"},"isLocked":false,"links":{"al":"99022","ap":"the-apothecary-diaries","bl":"464597","bw":"series\/130765\/list","kt":"39631","mu":"6y4x7mq","nu":"kusuriya-no-hitorigoto","amz":"https:\/\/www.amazon.co.jp\/dp\/B07BHZ7W3S","cdj":"https:\/\/www.cdjapan.co.jp\/product\/NEOBK-3045807","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/423421","mal":"107562","raw":"https:\/\/www.manga-up.com\/titles\/356","engtl":"https:\/\/global.manga-up.com\/manga\/164"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2017,"contentRating":"suggestive","tags":[{"id":"0a39b5a1-b235-4886-a747-1d05d216532d","type":"tag","attributes":{"name":{"en":"Award Winning"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"33771934-028e-4cb3-8744-691e866a923e","type":"tag","attributes":{"name":{"en":"Historical"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"c8cbe35b-1b2b-4a3f-9c37-db84c4514856","type":"tag","attributes":{"name":{"en":"Medical"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"ee968100-4191-4968-93d3-f82d72be7e46","type":"tag","attributes":{"name":{"en":"Mystery"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2019-02-14T20:38:13+00:00","updatedAt":"2026-07-21T16:06:22+00:00","version":99,"availableTranslatedLanguages":["hu","en","tr","pt-br","fr","es-la","vi","ar","pt","ru","de","it","uk","id"],"latestUploadedChapter":"1653392e-1239-4913-a96d-65d7e80b5c0c"},"relationships":[{"id":"4250d940-37ba-45df-a449-4b0fbed2da71","type":"author"},{"id":"b3dafa43-d878-4b5a-8f7f-27797a3618a6","type":"author"},{"id":"96f809b7-196f-4e7f-8659-f2f1fd7b5729","type":"artist"},{"id":"d899120e-d28c-4b1b-9a41-1173ed7d013b","type":"cover_art","attributes":{"description":"","volume":"17","fileName":"530a4ffb-87cb-4156-bdeb-61670532e20f.jpg","locale":"ja","createdAt":"2026-07-21T13:31:17+00:00","updatedAt":"2026-07-21T13:31:17+00:00","version":1}},{"id":"5446b906-bb90-404e-bb68-6703c90bcf71","type":"manga","related":"doujinshi"},{"id":"80a64000-a9af-4b19-8b37-0024030934d4","type":"manga","related":"doujinshi"},{"id":"8c1d7d0c-e0b7-4170-941d-29f652c3c19d","type":"manga","related":"alternate_story"},{"id":"bef2a2d4-2ff5-437d-bc6c-8ec49c452a36","type":"manga","related":"spin_off"},{"id":"cd61630f-1efa-44b9-957d-371f856714ec","type":"manga","related":"doujinshi"}]},{"id":"8aa1fb77-c86e-41db-adfb-0737c3438113","type":"manga","attributes":{"title":{"ja-ro":"Watashi no Shiawase na Kekkon"},"altTitles":[{"ja":"\u308f\u305f\u3057\u306e\u5e78\u305b\u306a\u7d50\u5a5a"},{"ja":"\u308f\u305f\u7d50\u5a5a"},{"ja-ro":"WataKekkon"},{"en":"My Happy Marriage"},{"en":"My Blissful Marriage"},{"en":"As Long as We Both Shall Live"},{"de":"Meine ganz besondere Hochzeit"},{"fr":"Mon bienheureux mariage"},{"it":"Il mio matrimonio felice"},{"it":"Un matrimonio felice"},{"pt":"Meu casamento feliz"},{"pt-br":"Meu casamento feliz"},{"es":"Mi feliz matrimonio"},{"pl":"Moje szcz\u0119\u015bliwe ma\u0142\u017ce\u0144stwo"},{"ar":"\u0632\u0648\u0627\u062c\u064a \u0627\u0644\u0633\u0639\u064a\u062f"},{"vi":"H\u00f4n nh\u00e2n h\u1ea1nh ph\u00fac c\u1ee7a t\u00f4i"},{"zh":"\u6211\u7684\u7f8e\u597d\u5a5a\u4e8b"},{"zh-hk":"\u6211\u7684\u5e78\u798f\u5a5a\u59fb"},{"th":"\u0e02\u0e2d\u0e43\u0e2b\u0e49\u0e23\u0e31\u0e01\u0e40\u0e23\u0e32\u0e19\u0e35\u0e49\u0e44\u0e14\u0e49\u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e38\u0e02"},{"ko":"\ub098\uc758 \ud589\ubcf5\ud55c \uacb0\ud63c"}],"description":{"en":"I wish for an ephemeral \u201chappiness\u201d\u2026\n\nDespite being born into a family with unusual powers in its bloodline, Saimori Miyo had not inherited any special abilities. Moreover, she was treated like a lowly servant by her half-sister, who in an ironic twist of fate had awakened an ability of her own. Unloved by her parents and shunned by all, Miyo was a forgotten daughter. Even her childhood friend, her one and only ally, chose to marry her half-sister in order to take over the estate. Seen as nothing more than a hindrance, Miyo is married off to the Kudou family. To a man rumored to be cold and ruthless\u2026\n\nAdapted from a light novel! Japanese-style fantasy x Marriage. A story of love blossoming from marriage.\n\n---\n**Links:**\n- Alternative Official English - [Manga UP!](https:\/\/global.manga-up.com\/manga\/161)","it":"La sua sorellastra aveva tutto: buona educazione, bellezza e dei poteri psionici. Lei invece non aveva nulla; anzi era la figlia indesiderata: trasandata, considerata quanto una serva. Il suo migliore amico aveva finito per sposare la sua sorellastra. Ritenuta fastidiosa e inutile, viene promessa in sposa ad un uomo dalla fama orribile. Ma saranno veritiere le voci che circolano sul suo futuro marito?","pt-br":"Miyo Saimori, um desafortunado fruto de um casamento arranjado e sem amor.\n\nPara piorar a situa\u00e7\u00e3o, ap\u00f3s a morte de sua m\u00e3e, seu pai trouxe a pr\u00f3pria amante e sua filha, Kaya, para sua casa. A partir desse momento, Miyo foi reduzida a uma mera servente; Situa\u00e7\u00e3o que se tornou ainda pior quando Kaya herdou as habilidades da fam\u00edlia Saimori, enquanto Miyo n\u00e3o possu\u00eda nenhuma.\n\nAp\u00f3s anos sendo tratada como lixo, Miyo aprendeu a manter sua cabe\u00e7a abaixada diante dos demais, ocultar sua dor e acatar todas as ordens. Portanto, n\u00e3o \u00e9 de se estranhar que a garota estivesse disposta a se casar com Kiyoka Kudou, um capit\u00e3o do ex\u00e9rcito que, de acordo com os rumores, havia afugentado todas as pretendes dispon\u00edveis devido a sua crueldade.\n\nUma inf\u00e2ncia dolorosa seguida de um matrim\u00f4nio ainda pior, esse era o fim que Miyo esperava. Contudo, contrariando suas expectativas, seu esposo demonstrou possuir uma personalidade incrivelmente bondosa.\n\nNo fim, o que a esperava era um casamento pleno e repleto de felicidade."},"isLocked":false,"links":{"al":"106531","ap":"my-happy-marriage","kt":"57874","mu":"1ee3hlj","mal":"118232","raw":"http:\/\/www.ganganonline.com\/contents\/kekkon\/"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shoujo","status":"ongoing","year":2019,"contentRating":"safe","tags":[{"id":"33771934-028e-4cb3-8744-691e866a923e","type":"tag","attributes":{"name":{"en":"Historical"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"eabc5b4c-6aff-42f3-b657-3e90cbd00b75","type":"tag","attributes":{"name":{"en":"Supernatural"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-07-06T22:19:56+00:00","updatedAt":"2026-09-07T11:10:46+00:00","version":36,"availableTranslatedLanguages":["en","pt-br","ru","it"],"latestUploadedChapter":"ae77849b-0945-4759-8f4b-81c4ff26cf31"},"relationships":[{"id":"9bcdb0b1-f741-4762-ad3a-d1711a951714","type":"author"},{"id":"c47f595f-25de-4f35-b761-3264ed33aa2c","type":"artist"},{"id":"3ee8f471-0a0b-4421-8827-ab970d741e37","type":"cover_art","attributes":{"description":"","volume":"5","fileName":"d59610ac-f16d-4fb3-aea4-053ff20f7702.jpg","locale":"ja","createdAt":"2024-07-21T19:17:29+00:00","updatedAt":"2024-07-21T19:17:29+00:00","version":1}}]},{"id":"5cb6e7dd-0fd8-4aab-be7c-5446b007f9bb","type":"manga","attributes":{"title":{"ja-ro":"Kyouran Reijou Nia Liston - Byoujaku Reijou ni Tensei Shita Kami-goroshi no Bujin no Karei Naru Musouroku"},"altTitles":[{"ja":"\u51f6\u4e71\u4ee4\u5b22\u30cb\u30a2\u30fb\u30ea\u30b9\u30c8\u30f3\u3000\u75c5\u5f31\u4ee4\u5b22\u306b\u8ee2\u751f\u3057\u305f\u795e\u6bba\u3057\u306e\u6b66\u4eba\u306e\u83ef\u9e97\u306a\u308b\u7121\u53cc\u9332"},{"en":"Nia Liston: The Merciless Maiden"},{"vi":"Cu\u1ed3ng lo\u1ea1n l\u1ec7nh n\u01b0\u01a1ng - Nia Liston"}],"description":{"en":"\"I wanted to die in battle.\"\n\nThere once was a great hero, capable of killing a god, who longed to fight even at the brink of death. What awaited her was her reincarnation as Nia Liston, a beautiful but sickly daughter of nobles in a future world. Now in her second life, she gets another chance to rampage in fights, dabble in broadcasting, and even experience academy life! Thus begin the epic battle records of a heroine who will one day be called the \"The Merciless Maiden, Nia Liston\"!\n\n*Source: Manga UP! Global*","ja":"\u300c\u3069\u3046\u305b\u306a\u3089\u3001\u6226\u3063\u3066\u6b7b\u306b\u305f\u304b\u3063\u305f\u300d\u304b\u3064\u3066\u795e\u6bba\u3057\u3092\u3082\u6210\u3057\u9042\u3052\u305f\u5927\u82f1\u96c4\u306f\u3001\u6b7b\u306e\u9593\u969b\u3067\u3055\u3048\u6226\u3044\u3092\u671b\u3093\u3067\u3044\u305f\u3002\u305d\u3093\u306a\u5f7c\u5973\u3092\u5f85\u3061\u53d7\u3051\u3066\u3044\u305f\u306e\u306f\u3001\u75c5\u5f31\u306a\u8cb4\u65cf\u4ee4\u5b22\u3078\u306e\u8ee2\u751f\u3067\u2015\u2015\u3002\u672a\u6765\u306e\u4e16\u754c\u3067\u7f8e\u3057\u304f\u3082\u5f31\u3059\u304e\u308b\u4ee4\u5b22\u30cb\u30a2\u30fb\u30ea\u30b9\u30c8\u30f3\u3068\u306a\u3063\u305f\u5f7c\u5973\u3060\u3063\u305f\u304c\u3001\u7b2c\u4e8c\u306e\u4eba\u751f\u3067\u306f\u6226\u3044\u3067\u3082\u3001\u914d\u4fe1\u6d3b\u52d5\u3067\u3082\u3001\u5b66\u9662\u751f\u6d3b\u3067\u3082\u5927\u66b4\u308c!?\u3053\u308c\u306f\u3001\u3044\u305a\u308c\u300c\u51f6\u4e71\u4ee4\u5b22\u300d\u3068\u547c\u3070\u308c\u308b\u82f1\u96c4\u306e\u3001\u83ef\u9e97\u306a\u308b\u6226\u3044\u306e\u8a18\u9332\u3002"},"isLocked":false,"links":{"al":"174279","ap":"kyouran-reijou-nia-liston-byoujaku-reijou-ni-tensei-shita-kamigoroshi-no-bujin-no-karei-naru-musouroku","bl":"20059610","bw":"series\/410014\/list","kt":"kyouran-reijou-nia-liston-byoujaku-reijou-ni-tensei-shita-kami-goroshi-no-bujin-no-kareinaru-musouroku","mu":"6bl9p6h","nu":"kyouran-reijou-nia-liston","amz":"https:\/\/www.amazon.co.jp\/dp\/B0C45NMFDR","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/762524","mal":"164869","raw":"https:\/\/www.manga-up.com\/titles\/1069","engtl":"https:\/\/global.manga-up.com\/manga\/448"},"officialLinks":null,"originalLanguage":"ja","lastVolume":null,"lastChapter":null,"publicationDemographic":"shounen","status":"ongoing","year":2022,"contentRating":"safe","tags":[{"id":"0bc90acb-ccc1-44ca-a34a-b9f3a73259d0","type":"tag","attributes":{"name":{"en":"Reincarnation"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2022-12-11T14:37:42+00:00","updatedAt":"2026-07-03T14:41:15+00:00","version":35,"availableTranslatedLanguages":["en","es-la","vi","id"],"latestUploadedChapter":"c0904a11-8684-4500-9a39-7751e3792622"},"relationships":[{"id":"053dfc71-1099-46a2-85c3-7a6799a5ac0d","type":"author"},{"id":"74cc02e9-9958-4780-846e-eb30a9c0d808","type":"author"},{"id":"053dfc71-1099-46a2-85c3-7a6799a5ac0d","type":"artist"},{"id":"7ec43bb9-da60-4914-8cee-8d9697fc299c","type":"cover_art","attributes":{"description":"","volume":"9","fileName":"56922a7b-7cde-4f07-aea7-c6beb3741730.jpg","locale":"ja","createdAt":"2026-10-06T09:39:53+00:00","updatedAt":"2026-10-06T09:39:53+00:00","version":1}},{"id":"39818054-f521-43d8-a5d2-fed5aa4f6a86","type":"creator"}]},{"id":"fef2e4da-36f9-48e9-8317-2516f4b6ab14","type":"manga","attributes":{"title":{"ja-ro":"Tensei Kizoku, Kantei Skill de Nariagaru: Jakushou Ryouchi o Uketsuida node, Yuushuu na Jinzai o Fuyashiteitara, Saikyou Ryouchi ni Natteta"},"altTitles":[{"ja":"\u8ee2\u751f\u8cb4\u65cf\u3001\u9451\u5b9a\u30b9\u30ad\u30eb\u3067\u6210\u308a\u4e0a\u304c\u308b\uff5e\u5f31\u5c0f\u9818\u5730\u3092\u53d7\u3051\u7d99\u3044\u3060\u306e\u3067\u3001\u512a\u79c0\u306a\u4eba\u6750\u3092\u5897\u3084\u3057\u3066\u3044\u305f\u3089\u3001\u6700\u5f37\u9818\u5730\u306b\u306a\u3063\u3066\u305f\uff5e"},{"en":"As a Reincarnated Aristocrat, I'll Use My Appraisal Skill to Rise in the World: I Inherited a Weak Territory, and If I Increase the Number of Capable Personnel, It Will Become the Strongest Territory"},{"zh-hk":"\u8f49\u751f\u8cb4\u65cf\uff0c\u4ee5\u9451\u5b9a\u6280\u80fd\u6210\u540d\uff5e\u56e0\u70ba\u7e7c\u627f\u4e86\u5f31\u5c0f\u7684\u9818\u5730\uff0c\u6240\u4ee5\u5982\u679c\u589e\u52a0\u4e86\u512a\u79c0\u7684\u4eba\u624d\uff0c\u5c31\u6703\u6210\u70ba\u6700\u5f37\u7684\u9818\u5730\uff5e"},{"id":"Terlahir kembali menjadi seorang bangsawan dengan skill penilaian"},{"id":"Seorang bangsawan yang bereinkarnasi, bangkit dengan kemampuan analisis"},{"pt-br":"Como um Aristocrata Reencarnado, Usarei Minha Habilidade de Avalia\u00e7\u00e3o para Subir no Mundo"},{"vi":"Qu\u00fd T\u1ed9c T\u00e1i Sinh Th\u0103ng Ti\u1ebfn Nh\u1edd K\u1ef9 N\u0103ng Th\u1ea9m \u0110\u1ecbnh: V\u00ec Th\u1eeba K\u1ebf M\u1ed9t L\u00e3nh \u0110\u1ecba Nh\u1ecf Y\u1ebfu, N\u00ean Khi Tuy\u1ec3n D\u1ee5ng Ng\u01b0\u1eddi T\u00e0i, \u0110\u00e3 Tr\u1edf Th\u00e0nh L\u00e3nh \u0110\u1ecba M\u1ea1nh Nh\u1ea5t"},{"vi":"T\u00e1i Sinh Th\u00e0nh Qu\u00fd T\u1ed9c V\u1edbi K\u0129 N\u0103ng \"Th\u1ea9m \u0110\u1ecbnh\""}],"description":{"en":"After being reincarnated, Ars Louvent is supposed to live in a different world as a weak aristocrat. Both his physical strength and intelligence were mediocre in both worlds, but here he naturally possessed a skill called \"Appraisal\" that allowed him to see the potential of any person. By gathering talented people by his side, Ars uses this \"Appraisal\" skill to transform his weak territory into the strongest one! But the road ahead of him won't be so simple.","ja":"\u8ee2\u751f\u3057\u3001\u5f31\u5c0f\u8cb4\u65cf\u3068\u3057\u3066\u7570\u4e16\u754c\u3092\u751f\u304d\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u30a2\u30eb\u30b9\u30fb\u30ed\u30fc\u30d9\u30f3\u30c8\u3002\u73fe\u4ee3\u540c\u69d8\u3001\u7570\u4e16\u754c\u3067\u3082\u4f53\u529b\u30fb\u77e5\u529b\u3068\u3082\u306b\u5e73\u51e1\u3060\u3063\u305f\u304c\u3001\u201c\u9451\u5b9a\u30b9\u30ad\u30eb\u201d\u3068\u3044\u3046\u4eba\u306e\u6f5c\u5728\u80fd\u529b\u3092\u77e5\u308b\u3053\u3068\u304c\u51fa\u6765\u308b\u30b9\u30ad\u30eb\u3092\u751f\u307e\u308c\u3064\u304d\u6240\u6301\u3057\u3066\u3044\u305f\u3002\u30a2\u30eb\u30b9\u306f\u81ea\u5206\u306e\u6c11\u305f\u3061\u3092\u5b88\u308b\u305f\u3081\u3001\u201c\u9451\u5b9a\u30b9\u30ad\u30eb\u201d\u3067\u5f31\u5c0f\u9818\u5730\u3092\u6700\u5f37\u306e\u9818\u5730\u3078\u3068\u5909\u8c8c\u3055\u305b\u3066\u3044\u304f\u2500\u2500\u2500\uff01","vi":"Sau khi \u0111\u01b0\u1ee3c t\u00e1i sinh, Ars Louvent \u0111\u01b0\u1ee3c cho l\u00e0 m\u1ed9t qu\u00fd t\u1ed9c y\u1ebfu k\u00e9m. C\u1ea3 s\u1ee9c m\u1ea1nh th\u1ec3 ch\u1ea5t v\u00e0 tr\u00ed tu\u1ec7 c\u1ee7a c\u1eadu \u0111\u1ec1u \u1edf m\u1ee9c trung b\u00ecnh \u1edf c\u1ea3 2 th\u1ebf gi\u1edbi. Nh\u01b0ng c\u1eadu s\u1edf h\u1eefu m\u1ed9t k\u0129 n\u0103ng \u0111\u1ed9c nh\u1ea5t c\u00f3 t\u00ean ' Th\u1ea9m \u0111\u1ecbnh' cho ph\u00e9p c\u1eadu c\u00f3 th\u1ec3 nh\u00ecn \u0111\u01b0\u1ee3c ch\u1ec9 s\u1ed1 v\u00e0 ti\u1ec1m n\u0103ng c\u1ee7a m\u1ecdi ng\u01b0\u1eddi. B\u1eb1ng c\u00e1ch t\u1eadp h\u1ee3p nh\u1eefng ng\u01b0\u1eddi t\u00e0i n\u0103ng v\u1ec1 b\u00ean c\u1ea1nh, Ars s\u1ebd s\u1eed d\u1ee5ng k\u0129 n\u0103ng 'Th\u1ea9m \u0111\u1ecbnh' n\u00e0y \u0111\u1ec3 khi\u1ebfn l\u00e3nh th\u1ed5 y\u1ebfu \u1edbt c\u1ee7a m\u00ecnh th\u00e0nh n\u01a1i m\u1ea1nh nh\u1ea5t! Nh\u01b0ng con \u0111\u01b0\u1eddng ph\u00eda tr\u01b0\u1edbc c\u1ee7a c\u1eadu s\u1ebd kh\u00f4ng h\u1ec1 d\u1ec5 d\u00e0ng.","pt-br":"Ap\u00f3s ser reencarnado, Ars Louvent deve viver em um mundo diferente como um aristocrata fraco. Tanto sua for\u00e7a f\u00edsica quanto sua intelig\u00eancia eram med\u00edocres em ambos os mundos, mas aqui ele naturalmente possu\u00eda uma habilidade chamada \u201cAvalia\u00e7\u00e3o\u201d que lhe permitia ver o potencial de qualquer pessoa. Ao reunir pessoas talentosas ao seu lado, Ars usa esta habilidade de \u201cAvalia\u00e7\u00e3o\u201d para transformar seu territ\u00f3rio fraco no mais forte! Mas o caminho \u00e0 sua frente n\u00e3o ser\u00e1 t\u00e3o simples."},"isLocked":false,"links":{"al":"121753","ap":"as-a-reincarnated-aristocrat-ill-use-my-appraisal-skill-to-rise-in-the-world","bl":"866752","bw":"series\/275621\/list","kt":"56909","mu":"7cfr08f","nu":"reincarnated-as-an-aristocrat-with-an-appraisal-skill","amz":"https:\/\/www.amazon.co.jp\/dp\/B08VS6HV53","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/610094\/","mal":"127781","raw":"https:\/\/pocket.shonenmagazine.com\/episode\/13933686331666634269","engtl":"https:\/\/kmanga.kodansha.com\/title\/10037\/episode\/315118"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2020,"contentRating":"safe","tags":[{"id":"0bc90acb-ccc1-44ca-a34a-b9f3a73259d0","type":"tag","attributes":{"name":{"en":"Reincarnation"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"ac72833b-c4e9-4878-b9db-6c8a4a99444a","type":"tag","attributes":{"name":{"en":"Military"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"ace04997-f6bd-436e-b261-779182193d3d","type":"tag","attributes":{"name":{"en":"Isekai"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-08-26T10:56:51+00:00","updatedAt":"2026-08-10T05:19:03+00:00","version":69,"availableTranslatedLanguages":["fr","pt-br","vi","es-la","en","id","pl"],"latestUploadedChapter":"d96f7a60-7903-4c38-beb8-c1656bd58661"},"relationships":[{"id":"87ec5454-c7a7-4bc8-8ae9-a459a4c44148","type":"author"},{"id":"3c22c004-557b-428e-8443-61aab4f88ba2","type":"artist"},{"id":"05d451db-1144-42a4-9d29-4293f3cbe90b","type":"cover_art","attributes":{"description":"","volume":"21","fileName":"9c91f825-45c9-44ba-a77a-426383eba467.jpg","locale":"ja","createdAt":"2026-05-28T11:50:25+00:00","updatedAt":"2026-05-28T11:50:25+00:00","version":1}}]},{"id":"febd3e05-6300-4105-95cc-2c39c19ce876","type":"manga","attributes":{"title":{"ja-ro":"Magical\u2605Explorer - Eroge no Yuujin Chara ni Tensei Shita kedo, Game Chishiki Tsukatte Jiyuu ni Ikiru"},"altTitles":[{"ja":"\u30de\u30b8\u30ab\u30eb\u2605\u30a8\u30af\u30b9\u30d7\u30ed\u30fc\u30e9\u30fc\u3000\u30a8\u30ed\u30b2\u306e\u53cb\u4eba\u30ad\u30e3\u30e9\u306b\u8ee2\u751f\u3057\u305f\u3051\u3069\u3001\u30b2\u30fc\u30e0\u77e5\u8b58\u4f7f\u3063\u3066\u81ea\u7531\u306b\u751f\u304d\u308b"},{"en":"Magical \u2605 Explorer: Reborn as a Side Character in a Fantasy Dating Sim"},{"ru":"\u041f\u0435\u0440\u0435\u0440\u043e\u0434\u0438\u0432\u0448\u0438\u0441\u044c \u0432 \u0434\u0440\u0443\u0433\u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0433\u0435\u0440\u043e\u044f \u044d\u0440\u043e\u0433\u0435, \u044f \u0431\u0443\u0434\u0443 \u0436\u0438\u0442\u044c \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043c\u043e\u0438 \u0437\u043d\u0430\u043d\u0438\u044f \u044d\u0440\u043e\u0433\u0435"}],"description":{"en":"There's a legendary Bishoujo Game that has become popular among Japanese gentlemen. Its name is \"Magical\u2605Explorer\" or Magiero for short. The game's protagonist has a cheat-like power with 12 different beautiful heroines to flirt with, including additional 12 heroines from the DLC, a harem of 24 beauties. I have become that protagonist...! Not! Instead, I have become the third-wheel character who always laughing like an idiot next to him. There's no heroine that would lay their eyes on me.\n\nBut now I couldn't care less about the protagonist and his heroines. Why? Because I discovered magic. While I was using it, I have become interested in it. I want to master it. I want to become the strongest. Thus I have decided. I would abandon half my role as a protagonist's friend to train my magic and then I would beat the hell out of that cheat who can solo the Demon King. I was training with that thought in mind, but somehow I keep getting closer to the heroines and furthermore, I don't know why I keep encounter events like I am some Eroge's protagonist.\n___\n**Links:**\n- Web novel: [NovelUpdates](https:\/\/www.novelupdates.com\/series\/magical%e2%98%85explorer)","ja":"\u4f1d\u8aac\u306e\u7f8e\u5c11\u5973\u30b2\u30fc\u30e0\u300e\u30de\u30b8\u30ab\u30eb\u2605\u30a8\u30af\u30b9\u30d7\u30ed\u30fc\u30e9\u30fc\u300f\u3002\u4ffa\u306f\u3053\u306e\u30b2\u30fc\u30e0\u3067\u30c1\u30fc\u30c8\u306a\u30b9\u30ad\u30eb\u3092\u6301\u3064\u30e2\u30c6\u30e2\u30c6\u306e\u4e3b\u4eba\u516c\uff01\u2026\u2026\u306e\u6a2a\u3067\u3078\u3089\u3078\u3089\u3068\u7b11\u3046\u4e0d\u9047\u306a\u53cb\u4eba\u30ad\u30e3\u30e9\u306b\u8ee2\u751f\u3057\u3066\u3044\u305f\u2026\uff01\uff1f"},"isLocked":false,"links":{"al":"116031","ap":"magical-explorer","bl":"20031425","bw":"series\/290005","kt":"57407","mu":"e915ol0","amz":"https:\/\/www.amazon.co.jp\/dp\/B0CY9M2J79","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/627958\/","mal":"129305","raw":"https:\/\/comic-walker.com\/detail\/KC_006940_S","engtl":"https:\/\/yenpress.com\/series\/magical-explorer-manga"},"officialLinks":null,"originalLanguage":"ja","lastVolume":null,"lastChapter":null,"publicationDemographic":"seinen","status":"ongoing","year":2019,"contentRating":"suggestive","tags":[{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"aafb99c1-7f60-43fa-b75f-fc9502ce29c7","type":"tag","attributes":{"name":{"en":"Harem"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"ace04997-f6bd-436e-b261-779182193d3d","type":"tag","attributes":{"name":{"en":"Isekai"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-03-27T10:32:53+00:00","updatedAt":"2026-10-06T17:14:23+00:00","version":54,"availableTranslatedLanguages":["pt-br","en","ru","id","es-la"],"latestUploadedChapter":"049ff6ce-6aeb-48f6-9c37-848a6dbe4a96"},"relationships":[{"id":"1c3a4c1d-b254-4f7a-97d5-155541694c2b","type":"author"},{"id":"b0f9c45c-7c88-4dd3-a87d-cb22167a5c94","type":"artist"},{"id":"db335de9-2d7b-4cc9-bcd8-457f791cb744","type":"cover_art","attributes":{"description":"","volume":"4","fileName":"476358a2-667d-4ae4-87f3-8bf77b904f9e.jpg","locale":"ja","createdAt":"2026-09-28T15:33:32+00:00","updatedAt":"2026-09-28T15:33:32+00:00","version":1}}]},{"id":"6c079564-363d-4d95-9410-4a841e6a33fb","type":"manga","attributes":{"title":{"ja-ro":"Sekai Saikyou no Majo, Hajimemashita ~Watashi Dake \"Kouryaku Site\" wo Miseru Sekai de Jiyuu ni Ikimasu~"},"altTitles":[{"ja":"\u4e16\u754c\u6700\u5f37\u306e\u9b54\u5973\u3001\u59cb\u3081\u307e\u3057\u305f\uff5e\u79c1\u3060\u3051\u300e\u653b\u7565\u30b5\u30a4\u30c8\u300f\u3092\u898b\u308c\u308b\u4e16\u754c\u3067\u81ea\u7531\u306b\u751f\u304d\u307e\u3059\uff5e"},{"ja-ro":"Sekai Saikyou no Majo, Hajimemashita ~Watashi Dake \"Kouryaku Site\" o Miseru Sekai de Jiyuu ni Ikimasu~"},{"en":"I Became the World's Strongest Witch: I Will Live Freely in a World Where Only I can Access the \"Guide Site\""},{"en":"The World's Strongest Witch has Begun: I Will Live Freely in a World Where Only I can View the \"Strategy Site\""},{"ko":"\uc138\uacc4 \ucd5c\uac15\uc758 \ub9c8\ub140, \uc2dc\uc791\ud588\uc2b5\ub2c8\ub2e4 ~\uc800\ub9cc \uacf5\ub7b5 \uc0ac\uc774\ud2b8\ub97c \ubcfc \uc218 \uc788\ub294 \uc138\uacc4\uc5d0\uc11c \uc790\uc720\ub86d\uac8c \uc0b4 \uac70\uc608\uc694~"},{"zh":"\u4e16\u754c\u6700\u5f3a\u9b54\u5973\uff0c\u59cb\u52a8 \u301c\u5728\u53ea\u6709\u6211\u80fd\u770b\u5230\u300e\u653b\u7565\u7f51\u7ad9\u300f\u7684\u4e16\u754c\u81ea\u7531\u8fc7\u6d3b\u301c"},{"zh-hk":"\u4e16\u754c\u6700\u5f37\u9b54\u5973\uff0c\u59cb\u52d5 \u301c\u5728\u53ea\u6709\u6211\u80fd\u770b\u5230\u300e\u653b\u7565\u7db2\u7ad9\u300f\u7684\u4e16\u754c\u81ea\u7531\u904e\u6d3b\u301c"},{"id":"Aku Menjadi Penyihir Terkuat di Dunia: Aku Akan Hidup dengan Bebas di Dunia di Mana Hanya Aku yang Bisa Mengakses \"Situs Panduan\""},{"ru":"\u0421\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0430\u044f \u0432\u0435\u0434\u044c\u043c\u0430 \u0432 \u043c\u0438\u0440\u0435 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u043b\u0430"},{"th":"\u0e41\u0e21\u0e48\u0e21\u0e14\u0e2a\u0e38\u0e14\u0e41\u0e01\u0e23\u0e48\u0e07\u0e41\u0e2b\u0e48\u0e07\u0e1b\u0e10\u0e1e\u0e35 \u0e2d\u0e2d\u0e01\u0e42\u0e23\u0e07\u0e41\u0e25\u0e49\u0e27\u0e04\u0e48\u0e30"}],"description":{"en":"An unknown skill turns into unlimited power with divine knowledge [Internet]!\n\n\"To manifest an SSS rank with the weakest skill is a disgrace!\"\n\nRona is a girl who was expelled from her home due to her lack of money, food, and power. Lost and hopeless, she suddenly hears the words...\n\n\"Would you like some guidance?\"\n\nShe discovers how to utilize her unique SSS rank skill: [Internet], which she alone possesses. The true nature of this skill is the ability to access this world's 'guide sites' - an extraordinary cheat skill! Endless production of valuable items! Acquiring ultra-rare equipment! Thanks to her skill, she can do as she pleases...!","ja":"\u300c\u2026\u653b\u7565\u3046\u3043\u304d\uff1f\u300d\u2015\u2015\u6700\u5f31\u30af\u30e9\u30b9\u306e\u30b9\u30ad\u30eb\u3092\u767a\u73fe\u3057\u3066\u3057\u307e\u3044\u8ffd\u653e\u3055\u308c\u305f\u5c11\u5973\u30fb\u30ed\u30fc\u30ca\u3002\u3057\u304b\u3057\u305d\u306e\u30b9\u30ad\u30eb\u306e\u6b63\u4f53\u306f\u3001\u3053\u306e\u4e16\u754c\u306e\u300e\u653b\u7565\u30b5\u30a4\u30c8\u300f\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\uff33\uff33\uff33\u30e9\u30f3\u30af\u306e\u30c1\u30fc\u30c8\u30b9\u30ad\u30eb\u3010\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u3011\u3060\u3063\u305f\uff01\n\n\uff08\uff11\uff09\u5192\u967a\u958b\u59cb\u2192\uff08\uff12\uff09\u5373\u30fb\u6700\u5f37\u6b66\u5668\u767a\u898b\u2192\uff08\uff13\uff09\u4e16\u754c\u3092\u6df7\u4e71\u306b\u9665\u308c\u308b\u6700\u5f37\u5c11\u5973\u306b\u2025\u2025\u2025\u3002\u30ed\u30fc\u30ca\u306f\u8a00\u3046\u3002\u300c\u79c1\u306f\u305f\u3060\u3001\u5e73\u548c\u306b\u81ea\u7531\u306b\u751f\u304d\u305f\u3044\u3060\u3051\u306a\u306e\u306b\u3044\u3043\u2025\u2025\u2025\uff01\u300d"},"isLocked":false,"links":{"al":"176270","ap":"sekai-saikyou-no-majo-hajimemashita-watashi-dake-kouryaku-site-wo-mireru-sekai-de-jiyuu-ni-ikimasu","bl":"1415464","bw":"series\/434629","kt":"73213","mu":"gb8kbbj","nu":"the-strongest-witch-in-the-world-has-started-i-can-live-freely-in-the-world-where-i-can-only-see-the-capture-site","amz":"https:\/\/www.amazon.co.jp\/dp\/B0CHMTG6HH","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/781470","mal":"162463","raw":"https:\/\/comic-days.com\/episode\/4856001361157619447"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2023,"contentRating":"safe","tags":[{"id":"36fd93ea-e8b8-445e-b836-358f02b3d33d","type":"tag","attributes":{"name":{"en":"Monsters"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"5fff9cde-849c-4d78-aab0-0d52b2ee1d25","type":"tag","attributes":{"name":{"en":"Survival"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"9438db5a-7e2a-4ac0-b39e-e0d95a34b8a8","type":"tag","attributes":{"name":{"en":"Video Games"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2023-06-27T06:51:19+00:00","updatedAt":"2026-10-15T20:41:20+00:00","version":50,"availableTranslatedLanguages":["th","id","en"],"latestUploadedChapter":"db1246bc-c375-4df4-bf46-1f7ced5e4c5a"},"relationships":[{"id":"891469f4-bbb7-43ab-91fd-0b34c2b6bd9c","type":"author"},{"id":"413dc062-d322-469e-a886-771c1407389b","type":"artist"},{"id":"2ed4c4df-5b51-4325-a5a1-0b8b8731d68f","type":"cover_art","attributes":{"description":"","volume":"14","fileName":"a67b7733-0c98-4550-ac42-575cb4556cbe.jpg","locale":"ja","createdAt":"2026-09-28T10:11:21+00:00","updatedAt":"2026-09-28T10:11:21+00:00","version":1}},{"id":"2e411f7f-ba82-4750-8282-9e7f2863b343","type":"creator"}]},{"id":"b73371d4-02dd-4db0-b448-d9afa3d698f1","type":"manga","attributes":{"title":{"ja-ro":"Ao Ashi"},"altTitles":[{"ja":"\u30a2\u30aa\u30a2\u30b7"},{"ko":"\uc544\uc624\uc544\uc2dc"},{"zh":"\u9752\u4e4b\u82a6\u82c7"},{"zh-hk":"\u9752\u4e4b\u8606\u8466"},{"fr":"Ao Ashi - Playmaker"},{"de":"Blaue Beine ~Ao Ashi~"},{"id":"Ao Ashi"},{"pt-br":"Ao Ashi - Craques da Bola"},{"ru":"\u0410\u043e \u0410\u0448\u0438"},{"th":"AOASHI \u0e41\u0e02\u0e49\u0e07\u0e40\u0e14\u0e47\u0e01\u0e2b\u0e31\u0e27\u0e43\u0e08\u0e19\u0e31\u0e01\u0e2a\u0e39\u0e49"},{"tr":"Mavi Bacak"},{"vi":"Ao Ashi"},{"en":"Aoashi"},{"pl":"Ao Ashi"}],"description":{"de":"Aoi Ashito ist ein Mittelsch\u00fcler im dritten Jahr aus Ehime. Hinter seinem rohen Spiel verbirgt sich sein immenses Talent, aber Ashito erleidet wegen seiner allzu geradlinigen Pers\u00f6nlichkeit einen gro\u00dfen R\u00fcckschlag. Der Manager der Jugendmannschaft des J1-Clubs Tokyo City Esperion, Fukuda Tetsuya, erscheint vor Ashito. Fukuda sieht Ashitos grenzenloses Potenzial und l\u00e4dt ihn ein, an den Probespielen seines Teams in Tokio teilzunehmen. Die Geschichte des Jungen, der den Fu\u00dfball in Japan revolutionieren wird, beginnt sich schnell zu entfalten.","en":"Aoi Ashito is a third year middle school student from Ehime. Behind his raw game hides his immense talent, but Ashito suffers a huge setback because of his overly straightforward personality. One day the youth team manager of J1 club Tokyo City Esperion, Fukuda Tetsuya, appears in front of him. Fukuda sees his limitless potential and invites him to take part in his team's tryouts in Tokyo.\n___\n- **Won the 65th Shogakukan Manga Award for General Manga in 2019.**","ja":"\u611b\u5a9b\u306b\u66ae\u3089\u3059\u4e2d\u5b66\u4e09\u5e74\u751f\u30fb\u9752\u4e95\u8466\u4eba\uff08\u3042\u304a\u3044\u30a2\u30b7\u30c8\uff09\u3002\u7c97\u524a\u308a\u306a\u304c\u3089\u3001\u5f37\u70c8\u306a\u30b5\u30c3\u30ab\u30fc\u306e\u624d\u80fd\u3092\u79d8\u3081\u3066\u3044\u308b\u30a2\u30b7\u30c8\u3060\u3063\u305f\u304c\u3001\u307e\u3063\u3059\u3050\u3059\u304e\u308b\u6027\u683c\u304c\u707d\u3044\u3057\u3066\u3001\u5927\u304d\u306a\u632b\u6298\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u306b\u2015\u2015\u2015\u305d\u3093\u306a\u30a2\u30b7\u30c8\u306e\u524d\u306b\u3001\u6771\u4eac\u306b\u3042\u308b\u5f37\u8c6aJ\u30af\u30e9\u30d6\u300c\u6771\u4eac\u30b7\u30c6\u30a3\u30fb\u30a8\u30b9\u30da\u30ea\u30aa\u30f3\u300d\u306e\u30e6\u30fc\u30b9\u30c1\u30fc\u30e0\u76e3\u7763\u30fb\u798f\u7530\u9054\u4e5f\uff08\u3075\u304f\u3060\u305f\u3064\u3084\uff09\u304c\u73fe\u308c\u308b\u3002\u30a2\u30b7\u30c8\u306e\u7121\u9650\u306e\u53ef\u80fd\u6027\u3092\u898b\u629c\u3044\u305f\u798f\u7530\u306f\u3001\u6771\u4eac\u3067\u958b\u50ac\u3055\u308c\u308b\u81ea\u30c1\u30fc\u30e0\u306e\u30bb\u30ec\u30af\u30b7\u30e7\u30f3\u3092\u53d7\u3051\u308b\u3088\u3046\u52e7\u3081\u3066\uff01\uff1f","ru":"\u0410\u0448\u0438\u0442\u043e \u0410\u043e\u0439, \u0443\u0447\u0435\u043d\u0438\u043a \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0448\u043a\u043e\u043b\u044b \u0438\u0437 \u043f\u0440\u0435\u0444\u0435\u043a\u0442\u0443\u0440\u044b \u042d\u0445\u0438\u043c\u0435, \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0442\u0440\u0435\u043d\u0435\u0440\u0430 \u00ab\u041c\u043e\u043b\u043e\u0434\u0435\u0436\u043d\u043e\u0439 \u043b\u0438\u0433\u0438 J\u00bb \u0424\u0443\u043a\u0443\u0434\u0443 \u0422\u0430\u0446\u0443\u044e. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u0432\u043e\u044e \u0433\u0440\u0443\u0431\u043e\u0441\u0442\u044c, \u0410\u0448\u0438\u0442\u043e \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0442\u0430\u043a\u0438\u043c \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u043e\u043c, \u0447\u0442\u043e \u0442\u0440\u0435\u043d\u0435\u0440 \u0424\u0443\u043a\u0443\u0434\u0430 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0435\u0442 \u0435\u0433\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043e\u0442\u0431\u043e\u0440\u043e\u0447\u043d\u044b\u0445 \u0442\u0435\u0441\u0442\u0430\u0445 \u0441\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0432 \u0422\u043e\u043a\u0438\u043e. \u0412\u0437\u0433\u043b\u044f\u043d\u0438\u0442\u0435 \u043d\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044e \u0432 \u044f\u043f\u043e\u043d\u0441\u043a\u043e\u043c \u0444\u0443\u0442\u0431\u043e\u043b\u0435.","tr":"Aoi Ashito Ehime'de ortaokul 3. s\u0131n\u0131fa giden bir \u00f6\u011frencidir. Bir g\u00fcn kar\u015f\u0131s\u0131na J1 Ligi kul\u00fcb\u00fc Tokyo City Esperion'un altyap\u0131 tak\u0131m\u0131 menajeri Fukuda Tetsuya \u00e7\u0131kar. Fukuda Aoi'nin sonsuz potansiyelini farkeder ve onu Tokyo'daki altyap\u0131 se\u00e7melerine davet eder. B\u00f6ylece Japon futbolunda devrim yapacak \u00e7ocu\u011fun hikayesi ba\u015flar.","pt-br":"Ashito Aoi, um estudante do terceiro ano do ensino m\u00e9dio de Ehime, conhece Fukuda Tatsuya, um treinador da \"J Youth League\". Mesmo que ainda tenha uma personalidade forte, Ashito tem um incr\u00edvel pot\u00eancial que o fez ser convidado pelo treinador Fukuda para participar da sele\u00e7\u00e3o de sua equipe em T\u00f3quio. A hist\u00f3ria do garoto que vai revolucionar o futebol no Jap\u00e3o vai come\u00e7ar."},"isLocked":false,"links":{"al":"107279","ap":"aoashi","bl":"318311","bw":"series\/125331\/list","kt":"46620","mu":"tszfquh","mal":"102256","raw":"https:\/\/bigcomicbros.net\/work\/6196\/"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"40","lastChapter":"410","publicationDemographic":"seinen","status":"completed","year":2015,"contentRating":"safe","tags":[{"id":"0a39b5a1-b235-4886-a747-1d05d216532d","type":"tag","attributes":{"name":{"en":"Award Winning"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"69964a64-2f90-4d33-beeb-f3ed2875eb4c","type":"tag","attributes":{"name":{"en":"Sports"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2018-11-26T11:57:23+00:00","updatedAt":"2026-05-21T08:03:59+00:00","version":49,"availableTranslatedLanguages":["en","pt-br","vi","es-la","id","fr","ru","pl","ar","it","fa","es"],"latestUploadedChapter":"544dabb2-ccba-4ec8-9232-ba9126217636"},"relationships":[{"id":"c60b8feb-97fd-4340-866c-58e825d9b3d4","type":"author"},{"id":"c60b8feb-97fd-4340-866c-58e825d9b3d4","type":"artist"},{"id":"d9f00796-c1cf-4a48-86bd-15e889d1798a","type":"cover_art","attributes":{"description":"","volume":"40","fileName":"8ecd4b0f-5746-4f75-a836-c132d361d9ee.jpg","locale":"ja","createdAt":"2025-08-26T13:11:44+00:00","updatedAt":"2025-