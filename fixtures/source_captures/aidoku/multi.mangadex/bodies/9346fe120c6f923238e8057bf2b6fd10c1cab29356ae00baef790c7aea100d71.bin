082\u306e\u304c\u304a\u597d\u304d\u3002"},{"zh":"\u5927\u53d4\u559c\u6b22\u53ef\u7231\u5c0f\u73a9\u610f"}],"description":{"en":"Handsome and hardworking manager Oji has a secret. He is obsessed with \"cute characters\"! But\u2026 he can't exactly tell his subordinates that\u2014(><)! A comedy centered around this \"uncle's secret,\" which depicts the daily struggles of how he gets by in the world with his love of cute things. Where will manager Oji go tomorrow?!"},"isLocked":false,"links":{"al":"120567","ap":"oji-san-wa-kawaii-mono-ga-osuki","bl":"20017284","kt":"53505","mu":"mb1du9a","mal":"114121","raw":"https:\/\/comic-polaris.jp\/ojisanha\/"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shoujo","status":"ongoing","year":2017,"contentRating":"safe","tags":[{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"92d6d951-ca5e-429c-ac78-451071cbf064","type":"tag","attributes":{"name":{"en":"Office Workers"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-10-05T10:48:09+00:00","updatedAt":"2026-10-03T11:57:39+00:00","version":9,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"e5a6b1c4-3d9c-4074-8f11-835c346949ce"},"relationships":[{"id":"d6ac7473-7fdc-4d07-89ea-aa6c932ff35a","type":"author"},{"id":"d6ac7473-7fdc-4d07-89ea-aa6c932ff35a","type":"artist"},{"id":"f5129d04-3ad4-4dc6-a970-4b7c6b75f9ac","type":"cover_art","attributes":{"description":"","volume":"13","fileName":"6ec81174-77d9-4d8b-a7cb-19378b10305c.jpg","locale":"ja","createdAt":"2026-10-03T11:58:14+00:00","updatedAt":"2026-10-03T11:58:14+00:00","version":1}}]},{"id"