iens"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2020-04-28T14:32:53+00:00","updatedAt":"2026-11-08T18:27:48+00:00","version":60,"availableTranslatedLanguages":["en","fr","ru","pt-br","zh","es-la"],"latestUploadedChapter":"da744983-d746-4759-8b40-db48b82ec3a8"},"relationships":[{"id":"f418bfc1-b220-4229-b2ee-f1d9df02cdad","type":"author"},{"id":"167d57dd-ecc2-4d18-820f-e2591bba778b","type":"artist"},{"id":"7ecd361d-99b1-4766-8ba1-a3c32a46e78a","type":"cover_art","attributes":{"description":"","volume":"12","fileName":"9b875b58-f110-4291-bb25-297495322436.jpg","locale":"ja","createdAt":"2026-10-19T11:22:25+00:00","updatedAt":"2026-10-19T11:22:25+00:00","version":1}}]},{"id":"69aa984a-f5c0-4505-a11f-fe50e5fd16c9","type":"manga","attributes":{"title":{"ja-ro":"Toaru Anbu no ITEM"},"altTitles":[{"ja":"\u3068\u3042\u308b\u6697\u90e8\u306e\u5c11\u5973\u5171\u68f2"},{"ja-ro":"Toaru Anbu no Shoujo Kyousei"},{"en":"A Certain Dark Side's ITEM"},{"ru":"\u041d\u0435\u043a\u0438\u0439 ITEM \u0442\u0451\u043c\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b"}],"description":{"en":"In Academy City, where esper abilities have been recognized as a general science. Behind the peace, there is a dark side organization that undertakes missions that cannot be made public.\n\n\"Item\" is an elite unit consisting of four girls. Takitsubo Rikou is able to read and track the weak power emitted by those with abilities. Frenda Seivelun, who excels in combat using explosives and traps. Kinuhata Saiai, who can manipulate nitrogen at will and plays a defensive role. And one of the 7 espers that Academy City is proud of: Mugino Shizuri. They live freely in the darkness of the Academy City, and quietly set their sights on their target...!","ja":"\u5b66\u5712\u90fd\u5e02\u306e\u95c7\u306e\u4e2d\u3067\u3001\u5c11\u5973\u305f\u3061\u306f\u81ea\u7531\u306b\u751f\u304d\u308b\u2015\u2015\uff01\uff01\n\n\u79d1\u5b66\u6280\u8853\u306e\u7c8b\u3092\u96c6\u3081\u3001\u8d85\u80fd\u529b\u958b\u767a\u304c\u9032\u3081\u3089\u308c\u308b\u5b66\u5712\u90fd\u5e02\u3002\u4e00\u898b\u3059\u308b\u3068\u5e73\u548c\u3067\u83ef\u3084\u304b\u306a\u3053\u306e\u8857\u306e\u88cf\u5074\u306b\u306f\u3001\u300c\u6697\u90e8\u300d\u3068\u547c\u3070\u308c\u308b\u8005\u305f\u3061\u304c\u5b58\u5728\u3057\u305f\u3002\u300c\u30a2\u30a4\u30c6\u30e0\u300d\u306e\u30b3\u30fc\u30c9\u30cd\u30fc\u30e0\u3067\u77e5\u3089\u308c\u308b\u5c11\u5973\u305f\u3061\u3082\u305d\u306e\u4e00\u90e8\u3067\u3001\u8d85\u80fd\u529b\u8005\uff08\u30ec\u30d9\u30eb\uff15\uff09\u3067\u3042\u308b\u9ea6\u91ce\u6c88\u5229\u3092\u7b46\u982d\u306b\u5404\u5206\u91ce\u306e\u30b9\u30da\u30b7\u30e3\u30ea\u30b9\u30c8\u3067\u69cb\u6210\u3055\u308c\u308b\u7cbe\u92ed\u90e8\u968a\u3060\u3002\u305d\u306e\u300c\u30a2\u30a4\u30c6\u30e0\u300d\u306b\u3072\u3068\u308a\u306e\u65b0\u30e1\u30f3\u30d0\u30fc\u304c\u52a0\u5165\u3057\u305f\u3053\u3068\u3092\u6a5f\u306b\u3001\u5f7c\u5973\u305f\u3061\u306f\u3053\u306e\u8857\u306e\u5730\u4e0b\u3067\u8822\u304f\u9670\u8b00\u306b\u5dfb\u304d\u8fbc\u307e\u308c\u3066\u3044\u304f\u306e\u3060\u304c\u2026\u2026\u3002"},"isLocked":false,"links":{"al":"162615","ap":"toaru-anbu-no-item","bl":"20089895","bw":"series\/476024","kt":"70129","mu":"vqt7ot2","amz":"https:\/\/www.amazon.co.jp\/dp\/B0CZ45X83L","cdj":"https:\/\/www.cdjapan.co.jp\/product\/NEOBK-2991785","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/835817","mal":"164597","raw":"https:\/\/comic-walker.com\/contents\/detail\/KDCW_AM05204439010000_68"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2023,"contentRating":"suggestive","tags":[{"id":"256c8bd9-4904-4360-bf4f-508a76d67183","type":"tag","attributes":{"name":{"en":"Sci-Fi"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2023-10-25T21:10:13+00:00","updatedAt":"2026-09-05T16:16:43+00:00","version":20,"availableTranslatedLanguages":["ru","zh","en","vi","es-la","fr","pt-br"],"latestUploadedChapter":"55bb6487-532b-4b42-9aa5-a81da4b12d9a"},"relationships":[{"id":"2d4c6987-4017-4c46-a3d1-88c6d94392d7","type":"author"},{"id":"716da2cc-9333-4060-850a-9e3125194c10","type":"artist"},{"id":"ca58a406-b76d-478c-8d91-47e065061a06","type":"cover_art","attributes":{"description":"","volume":"2","fileName":"a44cba6c-bd67-4b66-9fb9-4c3f0a8d941e.jpg","locale":"ja","createdAt":"2025-04-20T06:27:55+00:00","updatedAt":"2025-04-20T06:27:55+00:00","version":1}},{"id":"229e5177-2e71-4642-bd56-a9b0b0ba0e60","type":"manga","related":"main_story"},{"id":"4e0ab019-afcb-4fd9-98eb-fcb28cf7fc81","type":"manga","related":"shared_universe"},{"id":"84568957-a4ff-4419-8bf6-35b08590b2eb","type":"manga","related":"shared_universe"},{"id":"a828036b-c905-4798-aa84-593fef1e10ab","type":"manga","related":"shared_universe"},{"id":"d00bd104-d9b2-4ee9-a088-b5065d1c406a","type":"manga","related":"shared_universe"},{"id":"e10c02da-e7a3-40e2-8b3d-c6f769d4618c","type":"manga","related":"shared_universe"},{"id":"e8d89021-c5e3-4f1c-aa21-fd275344b136","type":"manga","related":"shared_universe"},{"id":"1b4f62ed-f7d3-4a8b-aa74-0f7ef34bc072","type":"creator"}]},{"id":"822c9883-385c-4fd0-9523-16e7789cbeae","type":"manga","attributes":{"title":{"ja-ro":"Seitokai ni mo Ana wa Aru!"},"altTitles":[{"ja":"\u751f\u5f92\u4f1a\u306b\u3082\u7a74\u306f\u3042\u308b"},{"en":"Even the Student Council Has Its Holes!"},{"en":"There is Also a Hole in the Student Organization!"},{"fr":"Les allum\u00e9s du conseil !"},{"pt-br":"At\u00e9 o conselho estudantil tem falhas!"},{"ru":"\u0412 \u0441\u0442\u0443\u0434\u0441\u043e\u0432\u0435\u0442\u0435 \u0442\u043e\u0436\u0435 \u0435\u0441\u0442\u044c \u0434\u044b\u0440\u043a\u0430!"},{"vi":"H\u1ed9i h\u1ecdc sinh c\u0169ng l\u1eafm tr\u00f2 vui!"}],"description":{"en":"These student council members are all over the place! Each one of them is eccentric in their own way\u2014one's an airhead, one\u2019s just plain frightening, one's a closet pervert, but all in all, they're really just weird! And yet it's everyone's oddities that makes them endearing and what allows them to create their new normal.","ja":"\u3053\u306e\u751f\u5f92\u4f1a\u306e\u9762\u5b50\u3068\u304d\u305f\u3089\u3001\u3042\u307b\u306e\u5b50\u3060\u3063\u305f\u308a\u3001\u6050\u308d\u3057\u304b\u3063\u305f\u308a\u3001\u3080\u3063\u3064\u308a\u3060\u3063\u305f\u308a\u3001\u3061\u3087\u3063\u3068\u5909\uff01 \u3067\u3082\u3001\u305d\u308c\u304c\u306a\u3093\u3060\u304b\u3001\u5999\u306b\u53ef\u611b\u304f\u601d\u3048\u308b\u4eca\u65e5\u3053\u306e\u9803\u2026\u2026\u3002","pt-br":"Mizunoe Ume s\u00f3 queria evitar repetir de ano quando entrou para o conselho estudantil. Afinal, parecia uma solu\u00e7\u00e3o f\u00e1cil para seus problemas acad\u00eamicos. Mas a\u00ed ele conheceu os outros membros do conselho. Cada um deles \u00e9 exc\u00eantrico \u00e0 sua pr\u00f3pria maneira: um \u00e9 avoado, outra \u00e9 assustadora, uma \u00e9 tarada em segredo, mas, no fim das contas, todos s\u00e3o simplesmente muito estranhos! Ainda assim, de um jeito meio doido, eles tamb\u00e9m s\u00e3o fofos e apaixonantes. O que significa que Mizunoe agora est\u00e1 preso a eles \u2014 e a todo o caos que eles trazem junto."},"isLocked":false,"links":{"al":"147863","ap":"seitokai-ni-mo-ana-wa-aru","bl":"1211348","bw":"series\/375555","kt":"69206","mu":"51ee204","amz":"https:\/\/www.amazon.co.jp\/dp\/B0BFX2HBTM","cdj":"https:\/\/www.cdjapan.co.jp\/product\/NEOBK-2800630","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/719388","mal":"149973","raw":"https:\/\/pocket.shonenmagazine.com\/episode\/3269754496893564293","engtl":"https:\/\/kmanga.kodansha.com\/title\/10685\/episode\/364014"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2022,"contentRating":"suggestive","tags":[{"id":"0a39b5a1-b235-4886-a747-1d05d216532d","type":"tag","attributes":{"name":{"en":"Award Winning"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b11fda93-8f1d-4bef-b2ed-8803d3733170","type":"tag","attributes":{"name":{"en":"4-Koma"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2022-04-26T18:31:14+00:00","updatedAt":"2026-09-19T13:06:52+00:00","version":59,"availableTranslatedLanguages":["es-la","en","pt-br","vi","id"],"latestUploadedChapter":"8d6fa485-c903-4f5d-8034-b2e0ea8c90e4"},"relationships":[{"id":"e931fd6c-9d4d-42b9-9991-300303abfd62","type":"author"},{"id":"e931fd6c-9d4d-42b9-9991-300303abfd62","type":"artist"},{"id":"d18ed9b7-31bd-4c3a-b1d1-040918d2956a","type":"cover_art","attributes":{"description":"","volume":"13","fileName":"413e7df9-e4cc-4fcd-887f-a7bbafc1846e.jpg","locale":"ja","createdAt":"2026-08-04T14:01:41+00:00","updatedAt":"2026-08-04T14:01:41+00:00","version":1}},{"id":"0218ac4d-c69e-4670-8ea0-3bb161a3ef8d","type":"creator"}]},{"id":"9d3d594f-c68d-43ff-b392-398cbe62541d","type":"manga","attributes":{"title":{"ja-ro":"Yasei no Last Boss ga Arawareta!"},"altTitles":[{"en":"A Wild Last Boss Appeared!"},{"ru":"\u0428\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0431\u043e\u0441\u0441 \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f!"},{"ja":"\u91ce\u751f\u306e\u30e9\u30b9\u30dc\u30b9\u304c\u73fe\u308c\u305f\uff01\u3000\u9ed2\u7ffc\u306e\u8987\u738b"},{"ko":"\uc57c\uc0dd\uc758 \ub77c\uc2a4\ud2b8\ubcf4\uc2a4\uac00 \ub098\ud0c0\ub0ac\ub2e4!"},{"ja-ro":"Yasei no Last Boss ga Arawareta!: Kokuyoku no Haou"}],"description":{"en":"It was in the year 2800 of the Midgard calendar. Back then, there was a Overlord who once reigned supreme and had reached the very brink of subduing the world. Her name was Lufasu Mafaalu, a great woman dreaded as the Black-Winged Overlord. She was too strong, too fast, and too beautiful. However, she was defeated by Heroes who opposed her ferocity, and her ambition was brought to an end.  \r\n  \r\nOr so went the story of our protagonist\u2019s in-game character, whose body he now possesses for some reason in a world 200 years after Lufasu\u2019s downfall. Follow our protagonist as he becomes unnecessarily feared by his surroundings and unnecessarily worshiped by his former subordinates as he\u2015or now she\u2015cheerfully travels around this fantasy world.","ja":"\u6642\u306f\u30df\u30ba\u30ac\u30eb\u30ba\u66a62800\u5e74\u3002\u304b\u3064\u3066\u8987\u3092\u5531\u3048\u3001\u4e16\u754c\u3092\u5f81\u670d\u3059\u308b\u5bf8\u524d\u307e\u3067\u81f3\u3063\u305f\u8987\u738b\u304c\u3044\u305f\u3002\u540d\u3092\u30eb\u30d5\u30a1\u30b9\u30fb\u30de\u30d5\u30a1\u30fc\u30eb\u3002\u201c\u9ed2\u7ffc\u306e\u8987\u738b\u201d\u3068\u6050\u308c\u3089\u308c\u308b\u5973\u5091\u3067\u3042\u308b\u3002\u5f7c\u5973\u306f\u3042\u307e\u308a\u306b\u5f37\u304f\u3001\u3042\u307e\u308a\u306b\u901f\u304f\u3001\u305d\u3057\u3066\u3042\u307e\u308a\u306b\u7f8e\u3057\u304f\u2026\u2026\u3002\u3057\u304b\u3057\u30eb\u30d5\u30a1\u30b9\u306f\u3001\u305d\u306e\u731b\u5a01\u306b\u7acb\u3061\u5411\u304b\u3063\u305f\u52c7\u8005\u9054\u306b\u8a0e\u305f\u308c\u3001\u305d\u306e\u91ce\u671b\u306b\u7d42\u6b62\u7b26\u304c\u6253\u305f\u308c\u305f\u3002 \u2015\u2015\u3068\u3044\u3046\u8a2d\u5b9a\u306e\u30b2\u30fc\u30e0\u306e\u30de\u30a4\u30ad\u30e3\u30e9\uff08\u2640\uff09\u306b\u3001\u4f55\u6545\u304b\u6191\u4f9d\u3057\u3066\u3057\u307e\u3063\u305f\u4ffa\uff08\u2642\uff09\u3002\u3053\u308c\u306f\u5468\u56f2\u306b\u5fc5\u8981\u4ee5\u4e0a\u306b\u602f\u3048\u3089\u308c\u305f\u308a\u3001\u5143\u90e8\u4e0b\u306b\u5fc5\u8981\u4ee5\u4e0a\u306b\u5d07\u62dd\u3055\u308c\u305f\u308a\u3057\u306a\u304c\u3089\u3001\u30eb\u30d5\u30a1\u30b9\uff08\u4e2d\u8eab\u306f\u4ffa\u2642\uff09\u304c\u7570\u4e16\u754c\u3092\u65c5\u3059\u308b\u304a\u8a71\u3067\u3042\u308b\u3002","ru":"\u0411\u044b\u043b 2800 \u0433\u043e\u0434 \u043f\u043e \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044e \u041c\u0438\u0434\u0433\u0430\u0440\u0434\u0430. \u0412 \u0442\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0436\u0438\u043b\u0430 \u043e\u0434\u043d\u0430 \u041f\u043e\u0432\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0438\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0446\u0430\u0440\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u043d\u0430\u0434 \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u043e\u043c, \u043f\u043e\u043a\u043e\u0440\u0438\u0432 \u0435\u0433\u043e \u0434\u043e \u0441\u0430\u043c\u044b\u0445 \u0433\u0440\u0430\u043d\u0438\u0446. \u0418\u043c\u044f \u0435\u0439 \u0431\u044b\u043b\u043e \u041b\u044e\u0444\u0430\u0441 \u041c\u0430\u0444\u0430\u0430\u043b, \u0432\u0435\u043b\u0438\u043a\u0430\u044f \u0436\u0435\u043d\u0449\u0438\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0431\u043e\u044f\u043b\u0438\u0441\u044c \u043a\u0430\u043a \u0422\u0451\u043c\u043d\u043e\u043a\u0440\u044b\u043b\u0443\u044e \u0412\u043b\u0430\u0434\u044b\u0447\u0438\u0446\u0443. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u0438\u043b\u044c\u043d\u0430, \u0431\u044b\u0441\u0442\u0440\u0430 \u0438 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u043a\u0440\u0430\u0441\u0438\u0432\u0430\u2026 \u041e\u0434\u043d\u0430\u043a\u043e, \u0435\u0451 \u043f\u043e\u0431\u0435\u0434\u0438\u043b\u0438 \u0413\u0435\u0440\u043e\u0438, \u0432\u043e\u0441\u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432 \u0435\u0451 \u0436\u0435\u0441\u0442\u043e\u043a\u043e\u0441\u0442\u0438, \u0438 \u0435\u0451 \u0430\u043c\u0431\u0438\u0446\u0438\u044f\u043c \u043f\u0440\u0438\u0448\u0435\u043b \u043a\u043e\u043d\u0435\u0446\u2026 \u0412\u0435\u0440\u043d\u0435\u0435 \u0442\u0430\u043a\u043e\u0439 \u0431\u044b\u043b\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0438\u0433\u0440\u043e\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430, \u0447\u044c\u0451 \u0442\u0435\u043b\u043e \u043d\u0430\u0448 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0433\u0435\u0440\u043e\u0439 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c \u0432 \u043c\u0438\u0440\u0435 \u0441\u043f\u0443\u0441\u0442\u044f 200 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0441\u0432\u0435\u0440\u0436\u0435\u043d\u0438\u044f \u041b\u044e\u0444\u0430\u0441. \u0418 \u0441 \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u043f\u043e \u0444\u044d\u043d\u0442\u0435\u0437\u0438\u0439\u043d\u043e\u043c\u0443 \u043c\u0438\u0440\u0443 \u043d\u0430\u0448\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0433\u0435\u0440\u043e\u044f, \u0438\u043b\u0438 \u0432\u0435\u0440\u043d\u0435\u0435 \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0433\u0435\u0440\u043e\u0438\u043d\u0438."},"isLocked":true,"links":{"al":"99776","ap":"yasei-no-last-boss-ga-arawareta","bw":"series\/140903\/list","kt":"39879","mu":"j9995v2","nu":"a-wild-last-boss-appeared","amz":"https:\/\/www.amazon.co.jp\/dp\/B07CGKPDXV","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/434738","mal":"108598","raw":"https:\/\/comic-earthstar.com\/episode\/14079602755509015214","engtl":"https:\/\/j-novel.club\/series\/a-wild-last-boss-appeared-manga"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2017,"contentRating":"safe","tags":[{"id":"2bd2e8d0-f146-434a-9b51-fc9ff2c5fe6a","type":"tag","attributes":{"name":{"en":"Genderswap"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"9438db5a-7e2a-4ac0-b39e-e0d95a34b8a8","type":"tag","attributes":{"name":{"en":"Video Games"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"ace04997-f6bd-436e-b261-779182193d3d","type":"tag","attributes":{"name":{"en":"Isekai"},"description":{},"gro