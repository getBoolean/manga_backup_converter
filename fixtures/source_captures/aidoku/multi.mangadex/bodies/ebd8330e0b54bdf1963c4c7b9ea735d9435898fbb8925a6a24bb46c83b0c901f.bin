At":"2026-11-20T08:34:47+00:00","updatedAt":"2026-11-20T08:35:15+00:00","version":3,"pages":33},"relationships":[{"id":"5a8536dc-4855-4f0b-bee6-6dbd59d1583d","type":"scanlation_group","attributes":{"name":"Cunny Moment","altNames":[],"locked":true,"website":"https:\/\/www.cmtranslation.my.id\/","ircServer":null,"ircChannel":null,"discord":null,"contactEmail":null,"description":"Cuma grup scanlation sepi yang jarang dapat donasi.\nTapi masih rutin update.\nTinggal tunggu kapan grup ini tutup...\n\nIt's just a quiet scanlation group that rarely gets donations.\nBut it still updates regularly.\nJust waiting to see when this group will shut down...","twitter":null,"mangaUpdates":null,"focusedLanguages":["en","id"],"official":false,"verified":false,"inactive":false,"publishDelay":null,"exLicensed":false,"createdAt":"2026-03-06T13:55:24+00:00","updatedAt":"2026-11-20T04:44:21+00:00","version":21}},{"id":"c2068513-1e3b-4e44-b8f5-b0ac5567aa2b","type":"manga"},{"id":"30c17951-4573-42ce-bbc3-c4ac9ae7119c","type":"user"}]},{"id":"d697a6cc-2803-4cc9-ab0c-c5cc27ff7881","type":"chapter","attributes":{"volume":"1","chapter":"4","title":null,"translatedLanguage":"en","externalUrl":null,"isUnavailable":false,"publishAt":"2026-11-20T08:08:53+00:00","readableAt":"2026-11-20T08:08:53+00:00","createdAt":"2026-11-20T08:08:51+00:00","updatedAt":"2026-11-20T08:15:36+00:00","version":4,"pages":40},"relationships":[{"id":"f2683049-5d57-4290-b20f-cc4fde08c1a5","type":"scanlation_group","attributes":{"name":"youlooktasty","altNames":[],"locked":false,"website":null,"ircServer":null,"ircChannel":null,"discord":null,"contactEmail":null,"description":"","twitter":null,"mangaUpdates":null,"focusedLanguages":["en"],"official":false,"verified":false,"inactive":false,"publishDelay":null,"exLicensed":false,"createdAt":"2026-11-03T02:10:31+00:00","updatedAt":"2026-11-07T01:31:01+00:00","version":3}},{"id":"c40bf165-81fa-499f-b368-48b353a968df","type":"manga"},{"id":"a193f3f8-b56e-4afb-9dab-ae3fce55878e","type":"user"}]},{"id":"9031aa4d-214d-44ef-a783-f7724d364d1e","type":"chapter","attributes":{"volume":"4","chapter":"40","title":"Beat","translatedLanguage":"en","externalUrl":null,"isUnavailable":false,"publishAt":"2026-11-20T08:00:29+00:00","readableAt":"2026-11-20T08:00:29+00:00","createdAt":"2026-11-20T08:00:28+00:00","updatedAt":"2026-11-20T08:00:45+00:00","version":3,"pages":15},"relationships":[{"id":"428fa899-6f51-4330-a4e0-2a8aeaab44b0","type":"scanlation_group","attributes":{"name":"TOOR Scans","altNames":[],"locked":false,"website":null,"ircServer":null,"ircChannel":null,"discord":"S4w2n9t","contactEmail":"ronbwl@gmail.com","description":"**About us**  \nJust an ordinarily group that scanlates various manga\/manhwa\/manhua that we enjoy, our specialty is also the good'old series that other groups won't care about, both for preservation's sake and for introducing legacy manga in the old days for new generations to enjoy what the golden age had to offer (Depending on your taste, of course).  \n  \nWhen I first founded TOOR Scans, the group was pretty much my home to host good'old manga that I solo-scanlating with PR help from some friends, but due to various reason, TOOR Scans has expanded greatly and we're adopting more popular series as we grow. However, I'll still cater for the good'old manga that I can scanlate so you guys will eventually see every series I planned for getting scanlated (Unless by chance some other groups did it first) :D  \n  \n**Other languages joint**  \n-If you want to make release for other languages of our series, feel free to contact me (Ron) for cleaned\/redrawn\/typesetted raw, and you can simply place your TL on top of it. Joint-crediting (listing us as secondary group on Mangadex) is NOT required (but we appreciate it if you do!), all I'm asking for is mentioning TOOR Scans on your credit page, simple as that.  \n  \n**Affiliation**  \nTOOR Scans is in affiliation with Eidetic Memoscans as I'm helping with managing the group, in exchange for shared credit.  As of October 1st 2022, Eidetic Memoscans have united and become one with TOOR Scans, all future releases will be under our group.\n\nTOOR Scans is currently collaborating Flesvelka Scans on numerous Manhua projects.\n\n ","twitter":null,"mangaUpdates":"https:\/\/www.mangaupdates.com\/group\/qzru5y0\/toor-scans","focusedLanguages":["en"],"official":false,"verified":false,"inactive":false,"publishDelay":null,"exLicensed":false,"createdAt":"2021-04-19T21:45:59+00:00","updatedAt":"2026-09-14T04:32:38+00:00","version":7}},{"id":"a476ce7f-2fb8-4f6f-8337-fa62ce5034fb","type":"manga"},{"id":"d83f6a4f-f796-43a8-bb7d-8f2288745109","type":"user"}]},{"id":"09fe704d-63fe-4f0e-892a-ee93e6da5c5a","type":"chapter","attributes":{"volume":"1","chapter":"1","title":null,"translatedLanguage":"en","externalUrl":null,"isUnavailable":false,"publishAt":"2026-11-20T07:46:05+00:00","readableAt":"2026-11-20T07:46:05+00:00","createdAt":"2026-11-20T07:46:05+00:00","updatedAt":"2026-11-20T07:48:23+00:00","version":3,"pages":51},"relationships":[{"id":"81547cb1-fc7a-4175-a6b8-11b1782de212","type":"scanlation_group","attributes":{"name":"Yao3","altNames":[],"locked":true,"website":null,"ircServer":null,"ircChannel":null,"discord":null,"contactEmail":"smallestchurch@gmail.com","description":"mostly a one-person group nowadays. please ask before retranslation.\nfeel free to suggest manga!\n\n---\n\nCURRENTLY WORKING ON:\n- [Shepherd House Hotel](https:\/\/mangadex.org\/title\/ecea082b-7340-4cff-959e-4dacca53ba82\/shepherd-house-hotel) - on hiatus\n- [COCOON](https:\/\/mangadex.org\/title\/8b8c1916-82f2-4638-b0a8-1d6e1397c8de\/cocoon) - on hiatus\n- [Pairing Gear](https:\/\/mangadex.org\/title\/37d7b5a8-4afc-412e-96d2-5aeb34253e3c\/pairing-gear)\n\n---\nDROPPED:\n- Yuusha Izoku - officially translated into English\n- Kirei na Kimi ni Korosaretai.","twitter":null,"mangaUpdates":"https:\/\/www.mangaupdates.com\/group\/56fv5pi\/yao3","focusedLanguages":["en"],"officia