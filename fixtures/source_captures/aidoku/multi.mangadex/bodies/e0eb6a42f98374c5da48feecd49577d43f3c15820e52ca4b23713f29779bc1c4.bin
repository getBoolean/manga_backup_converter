2cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a3c67850-4684-404e-9b7f-c69850ee5da6","type":"tag","attributes":{"name":{"en":"Girls' Love"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-19T15:54:50+00:00","updatedAt":"2026-11-19T16:10:36+00:00","version":3,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"a62f09e0-40ff-40ae-b14b-0d49cc9d29f3"},"relationships":[{"id":"d14c523f-0cdc-4423-a421-7addfdeab21f","type":"author"},{"id":"d14c523f-0cdc-4423-a421-7addfdeab21f","type":"artist"},{"id":"9ebdcc0b-b0f0-463f-81f3-d8ea7242b1cb","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"2a89d3fa-4ccb-4569-b926-cfb73f455f1d.jpg","locale":"ja","createdAt":"2026-11-19T15:54:59+00:00","updatedAt":"2026-11-19T15:54:59+00:00","version":1}},{"id":"e160a8e3-304f-4dca-838b-ee1821c490d8","type":"manga","related":"based_on"},{"id":"6bcc22a4-c704-4417-97c3-00aa1690105f","type":"creator"}]},{"id":"48808725-f75d-4c46-b34c-2111e6b874b7","type":"manga","attributes":{"title":{"ja-ro":"Gakuen Ichikawa Kawaii Kouhai no Inochi no Onjin ni Nattara, Kayoi-zuma ni Natte Kankei o Sematte Kuru."},"altTitles":[{"en":"After I Saved the Cutest Underclassman at School, She Started Coming Over Like My Wife and Pushing for a Relationship"},{"ja":"\u5b66\u5712\u4e00\u304b\u308f\u3044\u3044\u5f8c\u8f29\u306e\u547d\u306e\u6069\u4eba\u306b\u306a\u3063\u305f\u3089\u3001\u901a\u3044\u59bb\u306b\u306a\u3063\u3066\u95a2\u4fc2\u3092\u8feb\u3063\u3066\u304f\u308b\u3002"}],"description":{"en":"\u201cI came here to look after you, Senpai!\u201d\n\nWhy is the cutest girl in school at my house?!\n\nI'm Tomoya Mido, a second-year high school student. One day, I rescued Yuika Shirasu, a beautiful first-year student who's become the talk of the school and beyond, from a traffic accident.\n\nHoping to avoid any more trouble, I left the scene and headed home\u2014only to find her standing right outside my front door.\n\nAs it turned out, Yuika was my fianc\u00e9e, a match arranged by our parents!\n\nAnd after seeing that I'd injured my right arm saving her, she declared that she'd become my visiting wife and look after me!\n\nAnd so began our semi-cohabitation.\n\nThe curtain rises on a sweet romantic comedy about an innocent yet bold underclassman who's determined to play the role of her senpai's wife!"},"isLocked":false,"links":{"nu":"if-i-become-the-lifesaver-of-the-single-most-adorable-kouhai-in-the-academy-she-becomes-a-commuting-wife-and-comes-pressing-for-a-relationship","mal":"198130","raw":"https:\/\/piccoma.com\/web\/product\/221241?etype=episode"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2026,"contentRating":"suggestive","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-18T23:45:13+00:00","updatedAt":"2026-11-19T17:23:47+00:00","version":5,"availableTranslatedLanguages":["en","id"],"latestUploadedChapter":"9c138a9b-c246-4438-933f-270dfd071e44"},"relationships":[{"id":"66476709-a35e-4817-a0ee-dc31b28c5877","type":"author"},{"id":"046488c5-c32f-491e-b557-c74e320b4be5","type":"artist"},{"id":"20a140b0-231a-4646-9398-c5809bd8b1fa","type":"cover_art","attributes":{"description":"","volume":null,"fileName":"45ad6412-d8fd-427d-822b-6cd9cff8025a.jpg","locale":"ja","createdAt":"2026-11-18T23:45:19+00:00","updatedAt":"2026-11-19T17:23:46+00:00","version":2}},{"id":"df5d2b1c-f6b6-4f7a-9f98-3678004ed8e8","type":"creator"}]},{"id":"79aba376-0181-4969-936a-aad19f29da88","type":"manga","attributes":{"title":{"ja-ro":"Suterareta Moto Kishidanchou no Ossan, Henkyou de Shinguru Maza"},"altTitles":[{"ja":"\u6368\u3066\u3089\u308c\u305f\u5143\u9a0e\u58eb\u56e3\u9577\u306e\u304a\u3063\u3055\u3093\u3001\u8fba\u5883\u3067\u30b7\u30f3\u30b0\u30eb\u30de\u30b6"},{"en":"The Discarded Former Knight Commander Is Taken in by a Single Mother"}],"description":{"en":"\u300cYou are hereby sentenced to permanent exile in Dawnbarth, a remote frontier where humans and monsters are locked in a constant struggle for survival!\u300d\n\nOne day, Gale Coltrane, the Commander of the Royal Knights, is suddenly stripped of his position after being falsely accused of a crime he never committed. Having lost both his status and reputation, Gale watches as everyone he once knew turns their back on him the moment they learn of his downfall.\n\nAlthough the king's mercy spares his life, Gale is banished to the farthest reaches of the kingdom, a remote frontier where humans and monsters fight day after day for the right to survive. Unable to trust anyone anymore, Gale falls into despair and begins living recklessly. Whether it's venturing into the Demon Forest with barely any equipment or drowning himself in alcohol, his actions are practically self-destructive.\n\nThen, one day, Gale collapses by the roadside, where he is found by Alisha, a single mother raising her twins all on her own. Taking pity on him, she decides to take him in\u2015\u2015."},"isLocked":false,"links":{"al":"220037","mu":"85udgj0","raw":"https:\/\/booklive.jp\/product\/index\/title_id\/10019333\/vol_no\/001"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a1f53773-c69a-4ce5-8cab-fffcd90b1565","type":"tag","attributes":{"name":{"en":"Magic"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"e197df38-d0e7-43b5-9b09-2842d0c326dd","type":"tag","attributes":{"name":{"en":"Web Comic"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-18T06:35:06+00:00","updatedAt":"2026-11-19T18:08:47+00:00","version":5,"availableTranslatedLanguages":["id","en"],"latestUploadedChapter":"3682e245-d8e6-4054-9e2c-ca08f8063d0c"},"relationships":[{"id":"41151e48-4902-4e94-b409-f45e57db9459","type":"author"},{"id":"8c9b2889-df76-4f2c-960b-262e1a3134b2","type":"artist"},{"id":"ca27e228-f6d6-4f15-ad9e-0425af7bd1d4","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"7a7e10e0-8ba9-47a1-9ef3-bb706839b5da.jpg","locale":"ja","createdAt":"2026-11-18T06:35:08+00:00","updatedAt":"2026-11-18T06:35:08+00:00","version":1}},{"id":"55d8e9da-b906-4078-b1f3-d58b3624da70","type":"creator"}]},{"id":"6b615e13-dd45-4a4d-b27c-fd784d8e8d27","type":"manga","attributes":{"title":{"ja-ro":"Yoru 