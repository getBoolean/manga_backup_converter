ec \ube44\ud0c8\ub9ac\uc5d0\uac8c \uba39\uc778\ub2e4."},"isLocked":false,"links":{"mu":"gea0czj","raw":"https:\/\/series.naver.com\/comic\/detail.series?productNo=13901406&sortOrder=DESC"},"officialLinks":null,"originalLanguage":"ko","lastVolume":"75","lastChapter":"","publicationDemographic":null,"status":"completed","year":2023,"contentRating":"safe","tags":[{"id":"07251805-a27e-4d59-b488-f0bfbec15168","type":"tag","attributes":{"name":{"en":"Thriller"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"3b60b75c-a2d7-4860-ab56-05f391bb889c","type":"tag","attributes":{"name":{"en":"Psychological"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"3de8c75d-8ee3-48ff-98ee-e20a65c86451","type":"tag","attributes":{"name":{"en":"Animals"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"3e2b8dae-350e-4ab8-a8ce-016e844b9f0d","type":"tag","attributes":{"name":{"en":"Long Strip"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"b29d6a3d-1569-4e7a-8caf-7557bc92cd5d","type":"tag","attributes":{"name":{"en":"Gore"},"description":{},"group":"content","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-16T10:45:18+00:00","updatedAt":"2026-11-16T10:47:12+00:00","version":3,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"e1d104b7-a545-4047-b1e9-21d22374e700"},"relationships":[{"id":"42d0877e-bfa5-47c1-afb3-b0c6325ca7c0","type":"author"},{"id":"42d0877e-bfa5-47c1-afb3-b0c6325ca7c0","type":"artist"},{"id":"74e2c614-0bee-495e-86a8-2bb8072cccf7","type":"cover_art","attributes":{"description":"","volume":null,"fileName":"fec10df8-e116-4395-a644-677cfacaffd2.jpg","locale":"ko","createdAt":"2026-11-16T10:45:19+00:00","updatedAt":"2026-11-16T10:46:55+00:00","version":2}},{"id":"3b3faa17-2404-4223-b823-32312e95bd59","type":"creator"}]},{"id":"94bc7c14-d4e7-4fed-92c3-13d8e45a4aa4","type":"manga","attributes":{"title":{"ja-ro":"Sutegoro Koukou Fuuki Iin"},"altTitles":[{"en":"Bare-Knuckle High Disciplinary Committee"},{"ja":"\u30b9\u30c6\u30b4\u30ed\u9ad8\u6821\u98a8\u7d00\u59d4\u54e1"}],"description":{"en":"Violence runs rampant at Bare-Knuckle High, a school feared by all. As always, the Disciplinary Committee is cheerfully declaring \"No to Violence!!\"... Or so you'd think, but Kyoko, a first-year committee member, has a big secret...?! A brand-new blend of boy-meets-girl and violence!!"},"isLocked":false,"links":{"al":"219968","mal":"198064","raw":"https:\/\/shonenjumpplus.com\/episode\/9253191257982513673","engtl":"https:\/\/mangaplus.shueisha.co.jp\/titles\/100870"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"completed","year":2026,"contentRating":"safe","tags":[{"id":"0234a31e-a729-4e28-9d6a-3f87c4966b9e","type":"tag","attributes":{"name":{"en":"Oneshot"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"da2d50ca-3018-4cc0-ac7a-6b7d472a29ea","type":"tag","attributes":{"name":{"en":"Delinquents"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-16T09:35:56+00:00","updatedAt":"2026-11-17T02:56:04+00:00","version":5,"availableTranslatedLanguages