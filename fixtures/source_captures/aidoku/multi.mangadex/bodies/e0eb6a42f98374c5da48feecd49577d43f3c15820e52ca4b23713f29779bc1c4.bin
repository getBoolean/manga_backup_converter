s":[{"id":"efd0f615-09ee-4d4f-91d1-39a938b44190","type":"author"},{"id":"efd0f615-09ee-4d4f-91d1-39a938b44190","type":"artist"},{"id":"3a5af9ed-e363-4873-baa6-96247ebe02a5","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"9c5053d7-f011-4e05-8123-58e23beb2b59.jpg","locale":"ja","createdAt":"2026-11-16T03:56:42+00:00","updatedAt":"2026-11-16T03:56:42+00:00","version":1}},{"id":"bc06ce65-70f1-4284-b9fc-cab0c1e71c5c","type":"creator"}]},{"id":"50fe878b-562f-4c94-912a-9515d242cdce","type":"manga","attributes":{"title":{"ja-ro":"Honkon Madoromi Yatan"},"altTitles":[{"en":"Drowsy Night Tales in Hong Kong"},{"ja":"\u9999\u6e2f\u5fae\u7761\u591c\u8b5a"}],"description":{"en":"Driven to the brink by the pressures of work, Koutarou Hayashi impulsively leaves Japan and somehow finds himself in Hong Kong.\n\nEven abroad, his bad luck follows him. Just when he finds himself in a difficult situation, a beautiful woman named Yao, radiating an enigmatic and alluring charm, approaches him. At her invitation, he ends up going back to her home... but what awaits him there?\n\nTwo days and nights lost in the depths of Hong Kong, where he could encounter either demons or devils... and who knows what else."},"isLocked":false,"links":{},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"completed","year":2026,"contentRating":"safe","tags":[{"id":"0234a31e-a729-4e28-9d6a-3f87c4966b9e","type":"tag","attributes":{"name":{"en":"Oneshot"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"eabc5b4c-6aff-42f3-b657-3e90cbd00b75","type":"tag","attributes":{"name":{"en":"Supernatural"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-15T13:03:18+00:00","updatedAt":"2026-11-15T13:09:17+00:00","version":3,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"1bf914f8-8199-4c93-9673-b3b0a9822a77"},"relationships":[{"id":"c0290d86-1692-48c9-a5f5-c3942587a725","type":"author"},{"id":"c0290d86-1692-48c9-a5f5-c3942587a725","type":"artist"},{"id":"9fa2c38b-6a3d-4512-8ddc-2cde6dc969e5","type":"cover_art","attributes":{"description":"","volume":"0.1","fileName":"b79e1869-3fb3-4506-8844-1cd3248ba23d.jpg","locale":"ja","createdAt":"2026-11-15T13:04:15+00:00","updatedAt":"2026-11-15T13:04:15+00:00","version":1}},{"id":"4de221f3-1646-448d-8de6-69d694b15112","type":"creator"}]},{"id":"660b033c-f568-4573-ad84-3e5b37524da9","type":"manga","attributes":{"title":{"ja-ro":"Mannen Kusamushiri to Sagesumarete iru E-Rank Boukensha, Jitsuwa Sekai Saikyiu no \"Shokubutsu Majutsu\" de Musou suru"},"altTitles":[{"en":"The E-Rank Adventurer Mocked as the Eternal Herb Picker Is Actually the Strongest Plant Mage"},{"ja":"\u4e07\u5e74\u8349\u3080\u3057\u308a\u3068\u8511\u307e\u308c\u3066\u3044\u308bE\u30e9\u30f3\u30af\u5192\u967a\u8005\u3001\u5b9f\u306f\u4e16\u754c\u6700\u5f37\u306e\"\u690d\u7269\u9b54\u8853\"\u3067\u7121\u53cc\u3059\u308b"}],"description":{"en":"A nameless weed, actually the world's strongest. Filma is an E-rank adventurer who dives into dungeons to gather medicinal herbs. He was scorned by fellow adventurers, who nicknamed him \"the perennial weed-puller.\" One day, Tina, an S-rank adventurer aiming to reach the deepest level of the dungeon, encounters an abnormal monster and finds herself in a desperate situation. Just as she prepares for the end, the one who appears before her is... none other than Filma, the perennial weed-puller! Tina assumes he's out of his league as an E-rank, but Filma's \"Plant Magic\" is unbelievably powerful\u2014!? The unrivaled saga of the man with the title of the weakest, the perennial weed-puller, begins now!!"},"isLocked":false,"links":{"mu":"xss3yyw","raw":"https:\/\/sp.manga.nicovideo.jp\/comic\/77075"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-15T05:39:00+00:00","updatedAt":"2026-11-15T16:08:43+00:00","version":4,"availableTranslatedLanguages":["en","id"],"latestUploadedChapter":"259b7d8b-f07d-474b-9f25-b00d6c5752d6"},"relationships":[{"id":"48f32a39-eced-40e3-8a6e-f326ada48bf3","type":"author"},{"id":"48f32a39-eced-40e3-8a6e-f326ada48bf3","type":"artist"},{"id":"84ac4fb9-953a-469a-bb56-b0246c51f82b","type":"artist"},{"id":"36a051cf-6b40-445a-aa42-8e8e5a6c734a","type":"cover_art","attributes":{"description":"","volume":"2","fileName":"61db2dc3-42ee-47f3-a4ee-418e732ebc84.jpg","locale":"ja","createdAt":"2026-11-15T05:39:01+00:00","updatedAt":"2026-11-15T05:39:01+00:00","version":1}},{"id":"30c17951-4573-42ce-bbc3-c4ac9ae7119c","type":"creator"}]},{"id":"915f3b5d-57bf-464c-b1fe-24b74d50bdbd","type":"manga","attributes":{"title":{"ja-ro":"Ore no Shoukan Mahou ga Okashii. ~Zako Sugiru to Tsuihou sareta Shoukan Mahoutsukai no Ore wa, Gendai Heiki wo Shoukan shite Ikusei Cheat de Musou suru~"},"altTitles":[{"ja":"\u4ffa\u306e\u53ec\u559a\u9b54\u6cd5\u304c\u304a\u304b\u3057\u3044\u3002\uff5e\u96d1\u9b5a\u3059\u304e\u308b\u3068\u8ffd\u653e\u3055\u308c\u305f\u53ec\u559a\u9b54\u6cd5\u4f7f\u3044\u306e\u4ffa\u306f\u3001\u73fe\u4ee3\u5175\u5668\u3092\u53ec\u559a\u3057\u3066\u80b2\u6210\u30c1\u30fc\u30c8\u3067\u7121\u53cc\u3059\u308b\uff5e"},{"ja-ro":"Ore no Shoukan Mahou ga Okashii. ~Zako Sugiru to Tsuihou sareta Shoukan Mahoutsukai no Ore wa, Gendai Heiki o Shoukan shite Ikusei Cheat de Musou suru~"},{"en":"My Summoning Magic Is Weird: Banished as Too Weak, I Summon Modern Weapons and Dominate with Leveling Cheats"}],"description":{"en":"Shido is summoned to another world as a hero, but his Summoning Magic skill only produces food such as hamburgers and rice balls, so he is cast out as useless. Then he realizes that he can summon anything that exists on Earth. Armed with modern firearms and a party of elf girls he has hired, he sets out to conquer dungeons and make a name for himself in this new world.\n\nAn isekai action-harem story built on modern weapons and leveling cheats.\n\nManga adaptation of the GA Bunko light novel series by Kijima Ryuta.","ja":"\u52c7\u8005\u3068\u3057\u3066\u53ec\u559a\u3055\u308c\u305f\u30b7\u30c9\u30fc\u3002\u3010\u53ec\u559a\u9b54\u6cd5\u3011\u306e\u30b9\u30ad\u30eb\u3067\u98df\u7ce7\u3070\u304b\u308a\u51fa\u3057\u3066\u3044\u305f\u3089\u8ffd\u653e\u306e\u6182\u304d\u76ee\u306b\u3002\u3060\u304c\u5f7c\u304c\u53ec\u559a\u3067\u304d\u308b\u306e\u306f\u300c\u5730\u7403\u306b\u3042\u308b\u3082\u306e\u300d\u3060\u3063\u305f\uff01\u300c\u9283\u300d\u3092\u53ec\u559a\u3057\u305f\u5f7c\u306f\u30a8\u30eb\u30d5\u306e\u7f8e\u5c11\u5973\u305f\u3061\u3068\u7570\u4e16\u754c\u3092\u99c6\u3051\u308b\u2015\u2015\uff01"},"isLocked":false,"links":{"bl":"2232491","bw":"series\/592573","mu":"ri4vcs9","amz":"https:\/\/www.amazon.co.jp\/dp\/B0H596ZXYX","ebj":"https:\/\/ebookjap