n of the Entergram romance game \"Seifuku Kanojo\" (School Girlfriend)."},"isLocked":false,"links":{"bw":"series\/598642","raw":"https:\/\/kirapo.jp\/ambre\/titles\/seifukukanojo"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":null,"status":"ongoing","year":2024,"contentRating":"suggestive","tags":[{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"aafb99c1-7f60-43fa-b75f-fc9502ce29c7","type":"tag","attributes":{"name":{"en":"Harem"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-13T07:11:20+00:00","updatedAt":"2026-11-14T06:04:05+00:00","version":3,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"93f7c10b-913c-4d6c-bcbe-dfe9f027293b"},"relationships":[{"id":"b7ba53d4-c067-48da-9d77-e2f5b78e8770","type":"author"},{"id":"b7ba53d4-c067-48da-9d77-e2f5b78e8770","type":"artist"},{"id":"1e2bae6b-c17a-42a4-86c0-edd7b166efff","type":"cover_art","attributes":{"description":"","volume":"2","fileName":"56ca50c1-4834-48c9-9627-e6b8cb80052f.jpg","locale":"ja","createdAt":"2026-11-13T07:11:25+00:00","updatedAt":"2026-11-13T07:11:25+00:00","version":1}},{"id":"9b6f92b2-e749-4cd1-a259-8df71e12bc14","type":"creator"}]},{"id":"7bd5ca95-9254-439d-87e1-2cea9b5dc9e1","type":"manga","attributes":{"title":{"ja-ro":"Soredemo Bokutachi Tomodachi Da yo ne?"},"altTitles":[{"ja":"\u305d\u308c\u3067\u3082\u50d5\u305f\u3061\u53cb\u9054\u3060\u3088\u306d?"},{"en":"Even so, we're still friends, right?"}],"description":{"en":"Ao is a gloomy and introverted high school boy who hates himself and has no friends... What brings Ao joy is watching \"Magical\u2606Rhythm\", a children anime. Naru, the most popular boy in his class, approaches Ao when he sees his Magical\u2606Rhythm keychain. \nAo becomes attached to Naru, his first \"friend\", someone who shares his interests and is also kind and gentle. \nAs things progress Naru starts to have a twisted affection towards Ao... \nRegardless how painful, difficult, disgusting or wrong the extension of friendship may be, \"Even so, we're still friends, right?\""},"isLocked":false,"links":{"al":"219850","raw":"https:\/\/www.bunkasha.co.jp\/book\/5449"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"josei","status":"ongoing","year":2026,"contentRating":"suggestive","tags":[{"id":"3b60b75c-a2d7-4860-ab56-05f391bb889c","type":"tag","attributes":{"name":{"en":"Psychological"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"81c836c9-914a-4eca-981a-560dad663e73","type":"tag","attributes":{"name":{"en":"Magical Girls"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"9ab53f92-3eed-4e9b-903a-917c86035ee3","type":"tag","attributes":{"name":{"en":"Crossdressing"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-11-12T21:31:08+00:00","updatedAt":"2026-11-13T19:26:22+00:00","version":3,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"b3c4617f-7893-4745-8565-eff137086c8c"},"relationships":[{"id":"4da722d1-a654-4b01-b7a5-eee83298f8f7","type":"author"},{"id":"4da722d1-a654-4b01-b7a5-eee83298f8f7","type":"artist"},{"id":"f005684b-8985-4cf1-9b6e-b019bc04ce32","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"8d7b98f8-61af-45fb-bea5-e6912eae4c1d.png","locale":"ja","createdAt":"2026-11-12T21:31:15+00:00","updatedAt":"2026-11-12T21:31:15+00:00","version":1}},{"id":"b5d0ec98-1b26-4145-916c-9889a583e24a","type":"creator"}]},{"id":"fa5065e5-7385-48b1-9379-6980a0fad60e","type":"manga","attributes":{"title":{"ja-ro":"Koi wa Nail ja Kakusenai"},"altTitles":[{"ja":"\u604b\u306f\u30cd\u30a4\u30eb\u3058\u3083\u96a0\u305b\u306a\u3044"},{"en":"You Can't Hide Love With Nail Polish"}],"description":{"en":"Ryuzaki might look intimidating, but beneath his tough exterior he\u2019s just a socially awkward guy who secretly wants to be friends with everyone. His hidden talent? He\u2019s an incredibly skilled nail artist! One day, while helping out at his sister\u2019s nail salon, a fierce-looking girl who seems totally uninterested in nails walks in. Nervous but determined, Ryuzaki does her nails, and she ends up loving them! The next day, a new transfer student named Natsuno Shiomiya, the picture of a popular girl, arrives at school. To his shock, she\u2019s the same girl from the salon! With her offering \u201cgirl tips\u201d and him using her as his \u201cnail practice model,\u201d their shared interests spark a close-quarters romantic comedy full of unexpected twists."},"isLocked":false,"links":{"al":"219895","ap":"koi-wa-nail-ja-kakusenai","mu":"grdym76","mal":"198008","raw":"https:\/\/comic-walker.com\/detail\/KC_020005_S\/episodes\/KC_0200050000200011_E?episodeType=first"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":null,"status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"descri