escription":{},"group":"genre","version":1},"relationships":[]},{"id":"891cf039-b895-47f0-9229-bef4c96eccd4","type":"tag","attributes":{"name":{"en":"Self-Published"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"e197df38-d0e7-43b5-9b09-2842d0c326dd","type":"tag","attributes":{"name":{"en":"Web Comic"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2025-01-18T00:43:28+00:00","updatedAt":"2025-03-17T17:22:27+00:00","version":8,"availableTranslatedLanguages":["en","fr"],"latestUploadedChapter":"f7468a5a-7f04-4ded-88e1-119e7cfa3c03"},"relationships":[{"id":"b8ac0a9b-a942-4b20-bda6-40d0fe78790e","type":"author"},{"id":"b8ac0a9b-a942-4b20-bda6-40d0fe78790e","type":"artist"},{"id":"80c0560e-2dd6-4326-b7ff-5c8446b254da","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"a559ab40-c79e-4562-bf7f-07a2b367e87c.jpg","locale":"en","createdAt":"2025-01-18T01:43:57+00:00","updatedAt":"2025-01-18T01:43:57+00:00","version":1}},{"id":"b6c2a041-859f-4420-9047-1534bdf5cf4b","type":"creator"}]},{"id":"d0fef7be-d7e7-4b1d-a30f-23702599bd05","type":"manga","attributes":{"title":{"en":"Scarlet Star"},"altTitles":[{"id":"Bintang Scarlet"},{"es":"Estrella Escarlata"},{"es-la":"Estrella Escarlata"}],"description":{"en":"In New Pantheon City, monstrous \"Voids\" have plagued the people for over 500 years. \n\nHowever, they are not without their protectors - Immortal Magical guardians are also there to fight back against them.\n\nLiving in New Pantheon City is Mars Hino - a troubled outcast. Because of his reputation, vulgar personality, and lack of social finesse, he has found himself entering high school alone. That is before he meets the hero of the Blunbell district, the magical girl Scarlet Star - who chooses him for a higher duty","id":"Di Kota New Pantheon, makhluk mengerikan bernama \u201cVoid\u201d telah menghantui penduduknya selama lebih dari 500 tahun.\n\nNamun, mereka tidak sepenuhnya tanpa pelindung \u2014 para penjaga magis abadi juga hadir untuk melawan ancaman tersebut.\n\nTinggal di Kota New Pantheon adalah Mars Hino \u2014 seorang penyendiri bermasalah. Karena reputasinya, kepribadiannya yang kasar, serta kurangnya kecakapan sosial, ia harus memasuki masa SMA sendirian. Namun semuanya berubah sebelum itu, ketika ia bertemu dengan pahlawan Distrik Blunbell, gadis penyihir Scarlet Star \u2014 yang memilihnya untuk menjalankan tugas yang lebih besar."},"isLocked":false,"links":{"engtl":"https:\/\/Scarletstar.Net"},"officialLinks":null,"originalLanguage":"en","lastVolume":"","lastChapter":"","publicationDemographic":null,"status":"ongoing","year":2023,"contentRating":"suggestive","tags":[{"id":"2bd2e8d0-f146-434a-9b51-fc9ff2c5fe6a","type":"tag","attributes":{"name":{"en":"Genderswap"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"7064a261-a137-4d3a-8848-2d385de3a99c","type":"tag","attributes":{"name":{"en":"Superhero"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"81c836c9-914a-4eca-981a-560dad663e73","type":"tag","attributes":{"name":{"en":"Magical Girls"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"891cf039-b895-47f0-9229-bef4c96eccd4","type":"tag","attributes":{"name":{"en":"