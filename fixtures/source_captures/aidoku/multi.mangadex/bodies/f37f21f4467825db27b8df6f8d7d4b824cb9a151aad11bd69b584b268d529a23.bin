lableTranslatedLanguages":["en"],"latestUploadedChapter":"47f2c215-1bc7-49ca-a635-2f018ab992b3"},"relationships":[{"id":"81413f07-9b79-42e5-be0c-3de72dcc1ac5","type":"author"},{"id":"81413f07-9b79-42e5-be0c-3de72dcc1ac5","type":"artist"},{"id":"06f387e3-4833-4220-862a-d4d5cc77c403","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"2227610e-83ce-468e-b9aa-7a5093d5da0d.png","locale":"en","createdAt":"2026-09-24T09:43:18+00:00","updatedAt":"2026-09-24T09:45:00+00:00","version":2}},{"id":"f56aa6ad-6e44-4018-8a3d-43aaa00bc383","type":"creator"}]},{"id":"76f3f3d6-2cdb-4aba-a80a-907e43bb6d31","type":"manga","attributes":{"title":{"en":"Rotten Petal"},"altTitles":[{"vi":"C\u00e1nh h\u1ed3ng \u1ed1 xanh"},{"pl":"Zgni\u0142y P\u0142atek"}],"description":{"en":"They often say \u201cLove is a game of heart and mind\u201d. \n\nThey also say that when you fall in love, you become stupid. \n\nBut what if both sides participating in the game are fools? Then no one will have the upper hand right? It's so obvious, yet only the outsider can see it. \n\nThat is why H\u00e0 and Ng\u00e2n can only blame themselves for being friends for 11 years straight. Who knows when it will end? Definitely not these two dumbasses."},"isLocked":false,"links":{"raw":"https:\/\/www.facebook.com\/media\/set\/?vanity=senukin.69&set=a.1028169308866002","engtl":"https:\/\/twitter.com\/senukin69\/status\/1815755779766665219"},"officialLinks":null,"originalLanguage":"vi","lastVolume":"","lastChapter":"5","publicationDemographic":null,"status":"completed","year":2024,"contentRating":"safe","tags":[{"id":"3b60b75c-a2d7-4860-ab56-05f391bb889c","type":"tag","attributes":{"name":{"en":"Psychological"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attribu