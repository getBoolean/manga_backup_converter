<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="challenge-assets/favicon.svg">
  <link rel="stylesheet" href="challenge-assets/challenge.css">
  <script src="challenge-assets/challenge.js" defer></script>
  <title>MangaDex - Browser verification...</title>
</head>
<body>
<noscript><p>Please enable JavaScript and cookies to continue to MangaDex.</p></noscript>

<div class="container">
  <div class="brand">
    <img class="logo" src="challenge-assets/favicon.svg" alt="">
    <img class="wordmark" src="challenge-assets/wordmark.svg" alt="MangaDex">
  </div>

  <hr class="separator">

  <div id="results-inprogress" class="resultbox">
    <h1>Browser verification</h1>
    <p>Checking that you're not a bot...</p>
    <div class="spinner"></div>
    <div class="progress">
      <div id="progress-fill" class="progress-fill"></div>
    </div>
    <p id="progress-text" class="progress-text">JavaScript and cookies required.</p>
    <p id="warning" class="warning" style="display:none">Your browser lacks modern WebAssembly support, so verification is running a slower fallback. Consider
      updating your browser.</p>
  </div>

  <div id="results-box" class="resultbox" role="alert" style="display:none">
    <h3 style="color:#d84545;font-weight:bold;margin:0">Verification failed</h3>
    <p id="results-box-error" style="font-family:monospace"></p>
    <button id="retry-button" class="retry" type="button">Try again</button>
  </div>
</div>

<pre id=c style=display:none>REDACTED-CLIENT-TOKEN</pre>
<pre id=d style=display:none>20</pre>
<pre id=h style=display:none>256</pre>
</body>
<footer>
  <p>Powered by <a href="https://github.com/8Protons/POWBlock" target="_blank">POWBlock</a></p>
</footer>
</html>
