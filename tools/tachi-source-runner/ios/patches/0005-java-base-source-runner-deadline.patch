+package jdk.internal.misc;
+
+/**
+ * Thrown into a source-runner thread whose operation deadline has passed,
+ * either by {@link SourceRunnerDeadline#poll()} or by the embedder through
+ * JVMTI StopThread.
+ */
+public final class SourceRunnerDeadlineError extends Error {
+    private static final long serialVersionUID = 1L;
+
+    public SourceRunnerDeadlineError() {
+        super("source operation deadline exceeded", null, false, false);
+    }
+}
