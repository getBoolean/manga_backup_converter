+package jdk.internal.misc;
+
+/**
+ * Cooperative source-runner deadlines (KTD11 mechanism A).
+ *
+ * The source runner's bytecode rewrite pass inserts a call to {@link #poll()}
+ * before every backward branch of extension code, host libraries and the
+ * rewritten class-library packages. The embedder marks a thread expired from
+ * its watchdog with {@link #expire(Thread)}; from then on every poll on that
+ * thread throws, so code that catches the error and loops again is stopped
+ * at its next backward branch. The embedder clears the mark when the call
+ * returns to it.
+ */
+public final class SourceRunnerDeadline {
+    private static final int MAX_EXPIRED = 64;
+    private static final Object LOCK = new Object();
+    private static final Thread[] EXPIRED = new Thread[MAX_EXPIRED];
+    private static volatile int expiredCount;
+
+    private SourceRunnerDeadline() {}
+
+    /** Inserted before backward branches; one static read when nothing is expired. */
+    public static void poll() {
+        if (expiredCount != 0) {
+            slowPoll();
+        }
+    }
+
+    private static void slowPoll() {
+        if (isExpired(Thread.currentThread())) {
+            throw new SourceRunnerDeadlineError();
+        }
+    }
+
+    /** Marks {@code thread} expired. Returns false if the table is full. */
+    public static boolean expire(Thread thread) {
+        synchronized (LOCK) {
+            int free = -1;
+            for (int i = 0; i < MAX_EXPIRED; i++) {
+                if (EXPIRED[i] == thread) {
+                    return true;
+                }
+                if (free < 0 && EXPIRED[i] == null) {
+                    free = i;
+                }
+            }
+            if (free < 0) {
+                return false;
+            }
+            EXPIRED[free] = thread;
+            expiredCount = expiredCount + 1;
+            return true;
+        }
+    }
+
+    /** Clears the expired mark for {@code thread}. */
+    public static void clear(Thread thread) {
+        synchronized (LOCK) {
+            for (int i = 0; i < MAX_EXPIRED; i++) {
+                if (EXPIRED[i] == thread) {
+                    EXPIRED[i] = null;
+                    expiredCount = expiredCount - 1;
+                }
+            }
+        }
+    }
+
+    public static boolean isExpired(Thread thread) {
+        synchronized (LOCK) {
+            for (int i = 0; i < MAX_EXPIRED; i++) {
+                if (EXPIRED[i] == thread) {
+                    return true;
+                }
+            }
+            return false;
+        }
+    }
+}
