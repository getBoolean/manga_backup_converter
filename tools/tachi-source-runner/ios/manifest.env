# Recorded inputs for the iOS Zero runtime build (U16, KTD11).
# Sourced by scripts/build_runtime.sh. Every network input is pinned by
# commit or SHA-256; changing a value here is a runtime identity change.

# OpenJDK mobile port (GPLv2 with Classpath exception for the class library,
# GPLv2 for HotSpot). Community iOS builds pin this commit; HEAD fails to link
# on the W^X symbols (openjdk-mobile/ios-tools#81).
OPENJDK_MOBILE_REPO=https://github.com/openjdk/mobile.git
OPENJDK_MOBILE_COMMIT=ad8bb1b065bf230d193a1dfd0ebd39a8b1fedf53

# libffi (MIT), required by the Zero interpreter for native calls. Built from
# the release tarball rather than taking a prebuilt archive.
LIBFFI_VERSION=3.8.1
LIBFFI_URL=https://github.com/libffi/libffi/releases/download/v3.8.1/libffi-3.8.1.tar.gz
LIBFFI_SHA256=81e879c094cc5ec3186c48510c6385ac6b3e866192e8bc71a35245703757ee40

# Boot JDK: the pinned revision accepts 24, 25 or 26
# (make/conf/version-numbers.conf DEFAULT_ACCEPTABLE_BOOT_VERSIONS).
BOOT_JDK_FEATURE=25

# Minimum iOS version compiled into every object.
IOS_DEPLOYMENT_TARGET=15.0

# Modules linked into the modular runtime image (lib/modules).
RUNTIME_MODULES=java.base,java.logging,java.xml,jdk.unsupported

# Bump when the patch set or packaging changes without a pin change.
RUNTIME_BUILD_REVISION=1

# U9: java.base packages the back-edge rewrite pass covers, baked into the
# image (KTD11 mechanism A for class-library loops over site text). Chosen:
# java.util.regex (catastrophic backtracking, proven in U16) and java.text
# (per-character date/number parsing of site text). Collections, I/O and
# concurrency packages are excluded: their loops are bounded by data the
# host controls, and many run under locks shared across operations.
JAVA_BASE_REWRITE_PACKAGES="java/util/regex/ java/text/"

# Bump when the java.base bake (rewrite rules, guard, added classes) changes.
IMAGE_BAKE_REVISION=1
